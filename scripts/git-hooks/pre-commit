#!/bin/sh
# sr-receipt-gate — refuse commits that a patch receipt already rejected.
#
# Installed 2026-10-21T01:1xZ by the vqzo 0105Z pulse in response to the host
# directive in telegram-inbox.txt 2026-10-20T22:09:33Z: commit 239e1f88 landed a
# patch whose receipt read outcome=REJECTED__NOT_APPLIED__REVERTED, ok=false.
#
# This file is the TRACKED template. Install it with:
#     node scripts/sr-install-hooks.sh
# Remove with:
#     rm .git/hooks/pre-commit
#
# Host operator bypass:  SR_RECEIPT_GATE_BYPASS=1 git commit ...
#     The bypass is RECORDED on disk, not just printed:
#     $SR_AUDIT_LOG (default /data/openclaw-workspace/gate-audit.jsonl).
#     It opens ONLY when that record was actually written: if the audit write
#     fails, the gate keeps refusing, because a bypass with no record is
#     indistinguishable from no gate at all.
#     A bypass with `--no-verify` skips this hook entirely — the post-commit
#     hook still records that commit, because `--no-verify` does not skip
#     post-commit (verified on git 2.47.3).
#
# Self-test:              node scripts/sr-receipt-gate.mjs --selfcheck
#
# EXIT CODES FROM THE GATE:
#   0 = allow. 1 = refuse (commit blocked). 2 = INERT: the receipt store was
#   not reachable, so NOTHING was adjudicated. rc=2 is NOT a pass and NOT a
#   refusal. It is handled here as a loud WARNING and the commit proceeds,
#   because a control that can never run on a machine is worse than none, and
#   a commit blocked forever by an unmounted directory is a self-inflicted
#   outage. The same rule is applied by scripts/sr-deploy-guard.sh.

GATE="$(git rev-parse --show-toplevel)/scripts/sr-receipt-gate.mjs"
[ -f "$GATE" ] || exit 0

node "$GATE"
rc=$?

if [ "$rc" -eq 2 ]; then
    {
        echo ""
        echo "RECEIPT GATE WARNING: the gate is INERT — the receipt store is not reachable"
        echo "  from this machine, so NO receipt was adjudicated. This is not a pass."
        echo "  To make the gate real here, mount the receipt store or set SR_PATCH_DIR."
    } >&2
    exit 0
fi

exit $rc
