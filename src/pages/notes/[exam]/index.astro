---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import FaqSection from '@components/FaqSection.astro';
import { isGoodNote, isIndexableExamHub, isIndexableSubjectHub } from '@data/note-quality';
import { EXAM_EQUIVALENTS } from '@data/exam-equivalents';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  // Skip exams whose notes ALL fail the quality gate — an empty "0 topics ·
  // 0 subjects" shell is a dead-end URL (found live for law-apt-kenya, sgpat,
  // uaeu-cat, uneb on 2026-07-03). 404 until the rewrite pipeline produces at
  // least one good note, at which point the hub auto-returns.
  const exams = [...new Set(allNotes.filter(isGoodNote).map(n => n.id.split('/')[0]))];
  return exams.map(exam => ({
    params: { exam },
    props: { exam },
  }));
}

const { exam } = Astro.props;
const allNotes = await getCollection('notes');
const allExamNotes = allNotes.filter(n => n.id.startsWith(exam + '/'));
// Group/list only indexable notes; if the whole exam is still low-value, noindex
// the hub until the rewrite pipeline restores enough quality topics.
const examNotes = allExamNotes.filter(isGoodNote);
const examHubRobots = isIndexableExamHub(examNotes.length, exam) ? undefined : 'noindex,follow';

const firstNote = allExamNotes[0];
const examName = firstNote?.data.examName || exam;
const flag = { india: '🇮🇳', pakistan: '🇵🇰', nigeria: '🇳🇬' }[firstNote?.data.country] || '🌍';

// Only link equivalents whose notes hub exists (≥1 good note — all-bad hubs
// 404 now) and is indexable — never follow-link a noindexed hub from here.
const goodByExam = new Map<string, number>();
for (const n of allNotes) {
  if (isGoodNote(n)) {
    const eid = n.id.split('/')[0];
    goodByExam.set(eid, (goodByExam.get(eid) || 0) + 1);
  }
}
const relatedExams = (EXAM_EQUIVALENTS[exam] || [])
  .filter(r => isIndexableExamHub(goodByExam.get(r.id) || 0, r.id));


// Group by subject — use the directory slug from note.id (which IS the route),
// not note.data.subject (which can drift from the directory and 404s links).
// e.g. file sbi-po/general-awareness/genera-006.md has data.subject="awareness"
// but the rendered route is /notes/sbi-po/general-awareness/genera-006/
const bySubject: Record<string, typeof examNotes> = {}; // eslint-disable-line @typescript-eslint/no-explicit-any
for (const note of examNotes) {
  const subject = note.id.split('/')[1];
  if (!bySubject[subject]) bySubject[subject] = [];
  bySubject[subject].push(note);
}

// Derive meta subjects from real note content — never hardcode PCB
// (was falsely claiming Physics/Chemistry/Biology on UPSC, CAT, CLAT, etc.).
const subjectNames = Object.values(bySubject)
  .map((notes) => notes[0]?.data.subjectName)
  .filter((n): n is string => Boolean(n));
const subjectList =
  subjectNames.length === 0
    ? 'all subjects'
    : subjectNames.length <= 3
      ? subjectNames.join(', ')
      : `${subjectNames.slice(0, 3).join(', ')}, and more`;

// Title ≤65 chars for SERP (avoid ™ suffix and long exam names)
const titleBase = `${examName} Free Study Notes — All Subjects`;
const title = titleBase.length <= 65 ? titleBase : `${examName} Study Notes`.slice(0, 65);
const description =
  `Free ${examName} study notes: ${examNotes.length} topics across ${Object.keys(bySubject).length} subjects (${subjectList}). Weight-tagged, syllabus-aligned, no signup.`.slice(0, 160);
const canonicalUrl = `https://studyroadmap.in/notes/${exam}/`;
const siteUrl = 'https://studyroadmap.in';
const authorObj = { name: "StudyRoadmap Editorial Team", jobTitle: "Curriculum Editors", affiliation: "StudyRoadmap", url: "https://studyroadmap.in/about/" };
// Only 20 of 125+ exams have custom OG images — fall back to default for rest
const EXAM_OG_IMAGES = ['cat','clat','cuet','ecat','hat-ug','jamb','jeeadvanced','jeemain','lat','mdcat','nabteb','nat-i','ncee','nda','neco','neet','ssc-cgl','ugc-net','upsc','waec'];
const ogImage = EXAM_OG_IMAGES.includes(exam) ? `/og-notes/exam-${exam}.jpg` : '/og-image.jpg';

const subjectCount = Object.keys(bySubject).length;
const highWeightTopics = examNotes
  .filter((n) => (n.data.weight || 0) >= 5)
  .sort((a, b) => (b.data.weight || 0) - (a.data.weight || 0))
  .slice(0, 8);
// First-week anchors for the how-to “7-day starter” copy (linked topic names).
const starterTop = highWeightTopics.slice(0, 2);
const starterNext = highWeightTopics.slice(2, 4);
const firstSubjectLabel = subjectNames[0] || 'your strongest subject';

const NOTES_FAQS = [
  {
    question: `How do I use these ${examName} study notes effectively?`,
    answer: `Open the free ${examName} roadmap first so your remaining weeks map onto a topic order. On this hub you have ${examNotes.length} indexable topics in ${subjectCount} subjects (${subjectList}) — sort each subject by the weight % on the card and clear ≥5% chapters before medium ones. Read Standard notes for first-pass learning; log three recall points after every note. In the last 2–3 weeks before ${examName}, swap to Quick notes for formula/definition drills and re-open only topics your mock scores flag as weak.`,
  },
  {
    question: `What's the difference between Quick, Standard, and Deep ${examName} notes?`,
    answer: `For ${examName}, treat Standard as the default daily read (concepts + exam-style framing). Quick notes are compressed revision sheets for the final fortnight — definitions, formulas, and common traps. Deep notes are for high-weight ${examName} chapters that still break after one Standard pass; use them sparingly so low-weight topics do not consume your calendar. A simple rule: Standard → practice → Deep only if accuracy stalls → Quick in the last stretch.`,
  },
  {
    question: `Are these ${examName} notes aligned with the official syllabus?`,
    answer: `Topics are grouped under the same subject structure we use on the ${examName} exam overview page, with approximate weightage on each card so you can schedule effort. Weight tags are planning aids, not official marks. Always confirm paper pattern, registration windows, and fees on the board’s official site before you apply or sit ${examName}. StudyRoadmap is independent educational content, not the exam authority.`,
  },
  {
    question: `How many ${examName} topics and subjects are covered here?`,
    answer: `This ${examName} hub lists ${examNotes.length} quality-gated topics across ${subjectCount} subjects (${subjectList}). Each subject row shows the top weighted cards first; open “View all” for the full set. Thin subjects stay off the public index until notes clear the quality floor — empty placeholder hubs are not published.`,
  },
  {
    question: `Can I study ${examName} notes on mobile without signup?`,
    answer: `Yes. All ${examNotes.length} ${examName} notes open free on phone or laptop with no account or paywall. Bookmark the ≥5% weight topics, generate a ${examName} study plan for day-level sequencing, and re-open Quick notes for offline-style revision after the first load. Send factual corrections via Contact with the page URL and an official source when possible.`,
  },
];

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Notes', item: `${siteUrl}/notes/` },
    { '@type': 'ListItem', position: 3, name: examName, item: canonicalUrl },
  ],
};

const collectionPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${examName} Study Notes — All Subjects`,
  description: description,
  url: canonicalUrl,
  mainEntity: {
    '@type': 'ItemList',
    // Only subject hubs that are themselves indexable (≥3 good notes) —
    // schema URLs into noindexed hubs are the same leak as visible links.
    itemListElement: Object.entries(bySubject)
      .filter(([, notes]) => isIndexableSubjectHub(notes.length, exam))
      .map(([subjectId, notes], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${siteUrl}/notes/${exam}/${subjectId}/`,
      name: notes[0]?.data.subjectName || subjectId,
      numberOfItems: notes.length,
    })),
  },
};

---

<Layout title={title} description={description} canonical={canonicalUrl} image={ogImage} author={authorObj} robots={examHubRobots} faqs={NOTES_FAQS}>
  <style is:global>
    :root {
      --color-brand-50:  #ecf2ee; --color-brand-100: #d4e2d8; --color-brand-200: #a9c4b1;
      --color-brand-300: #7ea689; --color-brand-400: #4d7e5d; --color-brand-500: #2a5a3e;
      --color-brand-600: #1a3a2e; --color-brand-700: #143025; --color-brand-800: #0e241c;
      --color-brand-900: #081813; --color-brand-950: #040c0a;
      --color-surface-50:  #f5f1e8; --color-surface-100: #ebe5d4; --color-surface-200: #ddd4bd;
      --color-surface-300: #c8bda1; --color-surface-400: #a89d80; --color-surface-500: #6b6354;
      --color-surface-600: #4a4438; --color-surface-700: #353027; --color-surface-800: #24201a;
      --color-surface-900: #18150f; --color-surface-950: #0c0a07;
    }
    html, body { background: #f0eee9; color: #2a251f; }
    .dark html, .dark body { background: #18150f; color: #f5f1e8; }
    .sr-trust-h1 { font-family: ui-serif, Georgia, "Times New Roman", serif; font-weight: 600; letter-spacing: -0.02em; }
    .sr-trust-pulse { background: #b08d3c !important; }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageJsonLd)} />
  <Navbar />
  <main id="main-content" class="flex-1">
    <section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-surface-50 dark:from-brand-950/30 dark:via-surface-950 dark:to-surface-900 border-b border-surface-200 dark:border-surface-800">
      <div aria-hidden="true" class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-brand-500/10 dark:bg-brand-400/10 blur-3xl pointer-events-none"></div>
      <div class="container-page py-12 relative">
        <nav class="flex items-center gap-2 text-sm text-surface-500 mb-5" aria-label="Breadcrumb">
          <a href="/" class="hover:text-brand-600">Home</a>
          <span class="text-surface-300 dark:text-surface-700">/</span>
          <a href="/exams/" class="hover:text-brand-600">Exams</a>
          <span class="text-surface-300 dark:text-surface-700">/</span>
          <a href={`/exams/${exam}/`} class="hover:text-brand-600">{flag} {examName}</a>
          <span class="text-surface-300 dark:text-surface-700">/</span>
          <span class="text-surface-900 dark:text-surface-100 font-medium">Notes</span>
        </nav>

        <div class="inline-flex items-center gap-2 bg-brand-100/60 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 text-xs font-semibold px-3 py-1.5 rounded-full mb-4 border border-brand-200/60 dark:border-brand-800/50">
          <span class="sr-trust-pulse w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
          {examNotes.length} topics · {Object.keys(bySubject).length} subjects · No signup
        </div>

        <h1 class="sr-trust-h1 text-4xl md:text-5xl lg:text-6xl text-surface-900 dark:text-white mb-3 leading-[1.05]">
          <span class="text-brand-600 dark:text-brand-300">{examName}</span>
          <span class="block text-xl md:text-2xl font-normal italic text-surface-600 dark:text-surface-300 mt-2">Study Notes</span>
        </h1>
        <p class="text-lg text-surface-600 dark:text-surface-300 max-w-2xl mb-4 leading-relaxed">
          Free, concept-first {examName} study notes for revision and first-pass learning.
          This hub lists <strong class="text-surface-800 dark:text-surface-100">{examNotes.length} topics</strong> across
          <strong class="text-surface-800 dark:text-surface-100">{subjectCount} subjects</strong>
          {subjectNames.length ? ` (${subjectList})` : ''}.
          Each topic card shows approximate paper weightage so you can schedule high-impact chapters first.
        </p>
        <p class="text-base text-surface-600 dark:text-surface-400 max-w-2xl mb-6 leading-relaxed">
          Pair these notes with a personalised <a href={`/roadmap/?exam=${exam}`} class="text-brand-600 dark:text-brand-400 hover:underline">{examName} roadmap</a>
          and the <a href={`/exams/${exam}/`} class="text-brand-600 dark:text-brand-400 hover:underline">{examName} exam overview</a>
          for pattern, eligibility, and official source links. No signup, no paywall — open any topic and study.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href={`/roadmap/?exam=${exam}`} class="group inline-flex items-center gap-2 bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-700 hover:to-brand-600 text-white font-bold px-6 py-3 rounded-xl transition-all shadow-lg shadow-brand-500/20 hover:shadow-xl hover:shadow-brand-500/30">
            Generate {examName} Roadmap
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href={`/study-plan/${exam}/`} class="inline-flex items-center gap-2 bg-white dark:bg-surface-800 text-surface-700 dark:text-surface-200 font-semibold px-6 py-3 rounded-xl transition-colors border border-surface-200 dark:border-surface-700 hover:border-brand-300 dark:hover:border-brand-700">
            {examName} Study Plans
          </a>
          <a href={`/exams/${exam}/`} class="inline-flex items-center gap-2 bg-white dark:bg-surface-800 text-surface-700 dark:text-surface-200 font-semibold px-6 py-3 rounded-xl transition-colors border border-surface-200 dark:border-surface-700 hover:border-brand-300 dark:hover:border-brand-700">
            ← {examName} Overview
          </a>
        </div>
      </div>
    </section>

    <section class="container-page py-10 border-b border-surface-200 dark:border-surface-800">
      <div class="max-w-3xl space-y-4 text-sm sm:text-base text-surface-700 dark:text-surface-300 leading-relaxed">
        <h2 class="heading-3 text-surface-900 dark:text-surface-50">How to study {examName} with these notes</h2>
        <p>
          Treat this page as your {examName} syllabus map across
          <strong class="text-surface-900 dark:text-surface-100">{examNotes.length} topics</strong> in
          <strong class="text-surface-900 dark:text-surface-100">{subjectCount} subjects</strong>
          ({subjectList}) — not a dump of random PDFs. Open one subject hub at a time, sort cards by the weight % on each card,
          and finish a Standard note before the next chapter. After every note, write three recall points from memory and attempt
          a few past-style questions from your own practice set. When accuracy stalls on a high-weight chapter, open Deep for that
          topic only; switch to Quick notes in the last fortnight before {examName} for formula and trap drills.
        </p>
        <p>
          A practical weekly rhythm for {examName}: 60–70% of study blocks on topics weighted 5% or higher, 20–30% on medium-weight
          chapters, and a short daily buffer for error-log revision. Generate a free
          <a href={`/roadmap/?exam=${exam}`} class="text-brand-600 dark:text-brand-400 hover:underline">{examName} roadmap</a>
          if you need a day-by-day sequence for your remaining weeks, or browse ready-made
          <a href={`/study-plan/${exam}/`} class="text-brand-600 dark:text-brand-400 hover:underline">{examName} study plans</a>.
          Always verify registration windows, fees, and paper pattern on the official board site — StudyRoadmap is independent educational planning content.
        </p>
        {highWeightTopics.length > 0 ? (
          <p>
            <strong class="text-surface-900 dark:text-surface-100">7-day starter sequence:</strong>{' '}
            Days 1–2 — Standard notes for{' '}
            {starterTop.map((n, i) => (
              <>
                {i === 0 ? '' : starterTop.length === 2 && i === 1 ? ' and ' : ', '}
                <a href={`/notes/${n.id}/`} class="text-brand-600 dark:text-brand-400 hover:underline">{n.data.topicName}</a>
              </>
            ))}
            {' '}(highest weight on this hub). Days 3–4 —{' '}
            {starterNext.length > 0 ? (
              <>
                next priority topics (
                {starterNext.map((n, i) => (
                  <>
                    {i > 0 ? ', ' : ''}
                    <a href={`/notes/${n.id}/`} class="text-brand-600 dark:text-brand-400 hover:underline">{n.data.topicName}</a>
                  </>
                ))}
                ) plus mixed practice from your own set.
              </>
            ) : (
              <>mixed practice from your own set on the same high-weight chapters.</>
            )}
            {' '}Day 5 — subject-hub deep-dive under {firstSubjectLabel} or your weakest paper area.
            Day 6 — Quick-note pass on everything covered so far. Day 7 — timed mock slice and error-log only (re-open Deep solely where accuracy broke).
            After week one, rotate the remaining high-weight list and keep the same Standard → practice → Quick loop.
          </p>
        ) : (
          <p>
            <strong class="text-surface-900 dark:text-surface-100">7-day starter sequence:</strong>{' '}
            Days 1–2 — pick your first subject under {subjectList} and finish two Standard notes end-to-end with recall points.
            Days 3–4 — second subject, same depth, plus a short mixed practice set. Day 5 — rework the weakest topic with Deep if needed.
            Day 6 — Quick notes only for everything logged this week. Day 7 — timed practice and error-log revision.
            Then expand coverage across the remaining {Math.max(subjectCount - 2, 1)} subject area{subjectCount - 2 === 1 ? '' : 's'} using weight order on each card.
          </p>
        )}
        {highWeightTopics.length > 0 && (
          <div>
            <h3 class="font-semibold text-surface-900 dark:text-surface-100 mb-2">High-weightage {examName} topics to prioritise</h3>
            <ul class="list-disc pl-5 space-y-1">
              {highWeightTopics.map((n) => (
                <li>
                  <a href={`/notes/${n.id}/`} class="text-brand-600 dark:text-brand-400 hover:underline">{n.data.topicName}</a>
                  <span class="text-surface-500"> ({n.data.subjectName} · {n.data.weight}%)</span>
                </li>
              ))}
            </ul>
          </div>
        )}
        <p>
          Subject coverage on this hub: <strong class="text-surface-900 dark:text-surface-100">{subjectList}</strong>.
          Open a subject row below for the full topic list sorted by weight, or jump straight into any card. Notes that fail our quality floor
          are held back from the index so empty placeholders never ship.
        </p>
      </div>
    </section>

    <section class="container-page py-12 space-y-10">
      <h2 class="heading-3 text-surface-900 dark:text-surface-50">Browse {examName} notes by subject</h2>
      {Object.entries(bySubject).map(([subject, notes]) => (
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="heading-3 text-surface-800 dark:text-surface-100">
              {notes[0].data.subjectName}
            </h2>
            {isIndexableSubjectHub(notes.length, exam) ? (
              <a href={`/notes/${exam}/${subject}/`} class="text-sm text-brand-600 dark:text-brand-400 hover:underline">
                View all {notes.length} →
              </a>
            ) : (
              <span class="text-sm text-surface-400">{notes.length} topics</span>
            )}
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {[...notes]
              .sort((a, b) => (b.data.weight || 0) - (a.data.weight || 0) || a.data.topic.localeCompare(b.data.topic))
              .slice(0, 6)
              .map(note => (
              <a
                href={`/notes/${note.id}/`}
                class="group block bg-surface-50 dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-lg p-4 hover:border-brand-300 dark:hover:border-brand-700 transition-all"
              >
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-mono text-surface-400">{note.data.topic}</span>
                  <span class="text-xs text-brand-600 dark:text-brand-400">{note.data.weight}%</span>
                </div>
                <p class="text-sm font-medium text-surface-800 dark:text-surface-200 group-hover:text-brand-600 dark:group-hover:text-brand-400">
                  {note.data.topicName}
                </p>
              </a>
            ))}
          </div>
          {notes.length > 6 && isIndexableSubjectHub(notes.length, exam) && (
            <a href={`/notes/${exam}/${subject}/`} class="text-sm text-brand-600 dark:text-brand-400 hover:underline mt-2 inline-block">
              + {notes.length - 6} more {notes[0].data.subjectName} topics →
            </a>
          )}
        </div>
      ))}
    {relatedExams.length > 0 && (
      <section class="border-t border-surface-200 dark:border-surface-700 pt-10 mt-10">
        <h2 class="heading-3 text-surface-800 dark:text-surface-100 mb-4">Related exams in other countries</h2>
        <p class="text-surface-600 dark:text-surface-400 text-sm mb-5">
          Students comparing {examName} with similar admissions exams abroad can open these note hubs next.
          Syllabi differ by country — use each hub’s weight tags and official board links, not a one-to-one topic map.
        </p>
        <div class="flex flex-wrap gap-3">
          {relatedExams.map(rel => (
            <a href={`/notes/${rel.id}/`} class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-100 dark:bg-surface-800 border border-surface-200 dark:border-surface-700 hover:border-brand-300 dark:hover:border-brand-700 text-surface-700 dark:text-surface-300 text-sm transition-all">
              <span>{rel.flag}</span>
              <span>{rel.name}</span>
              <span class="text-surface-400">→</span>
            </a>
          ))}
        </div>
      </section>
    )}
    </section>

    <FaqSection faqs={NOTES_FAQS} heading={`Frequently asked questions about ${examName} notes`} />
  </main>
  <Footer />
</Layout>
