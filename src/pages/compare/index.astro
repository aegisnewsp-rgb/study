---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { ALL_EXAMS, getCountryFlag } from '../../data/exams';
import { isCuratedComparePair } from '../../data/compare-curation';

import { SITE_URL } from '@data/site';
const year = new Date().getUTCFullYear();

const TIER1 = new Set(['neet','jeemain','jeeadvanced','upsc','gate','cuet','ssc-cgl','cat','clat','bitsat','aiims-mbbs','neet-pg','ugc-net','ndab','mdcat','ecat','nat-i','lat','hat-ug','jamb','waec','neco','nabteb']);

const byCountry: Record<string, any[]> = {};
for (const exam of ALL_EXAMS) {
  if (!exam || !exam.examId || !TIER1.has(exam.examId)) continue;
  (byCountry[exam.country] ||= []).push(exam);
}
type Pair = { a: any; b: any; slug: string };
const pairsByCountry: Record<string, Pair[]> = {};
for (const [country, list] of Object.entries(byCountry)) {
  const pairs: Pair[] = [];
  for (let i = 0; i < list.length; i++) {
    for (let j = i + 1; j < list.length; j++) {
      // Only list curated, indexed comparisons — combinatorial filler pairs are
      // noindexed in [pair].astro and kept out of the listing here too.
      if (!isCuratedComparePair(list[i].examId, list[j].examId)) continue;
      pairs.push({ a: list[i], b: list[j], slug: `${list[i].examId}-vs-${list[j].examId}` });
    }
  }
  pairsByCountry[country] = pairs;
}
const totalPairs = Object.values(pairsByCountry).reduce((n, p) => n + p.length, 0);

const COUNTRY_LABELS: Record<string, { label: string; flag: string }> = {
  india: { label: 'India', flag: '🇮🇳' },
  pakistan: { label: 'Pakistan', flag: '🇵🇰' },
  nigeria: { label: 'Nigeria', flag: '🇳🇬' },
  bangladesh: { label: 'Bangladesh', flag: '🇧🇩' },
};

const title = `Compare Competitive Exams ${year} — Side-by-Side`;
const description = `Compare any two competitive exams side-by-side: syllabus overlap, eligibility, difficulty, career outcomes. ${totalPairs}+ pairs across India, Pakistan, Nigeria and more.`;
const canonicalUrl = `${SITE_URL}/compare/`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Compare Exams', item: canonicalUrl },
  ],
};

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Exam comparisons',
  numberOfItems: totalPairs,
  itemListElement: Object.values(pairsByCountry).flat().slice(0, 100).map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: `${p.a.examName} vs ${p.b.examName}`,
    url: `${SITE_URL}/compare/${p.slug}/`,
  })),
};

const faqs = [
  { q: 'How are exam comparisons calculated?', a: 'We compare two exams by syllabus overlap (subjects shared between the two), eligibility differences, exam-pattern parity, and career outcomes. Each comparison page shows a side-by-side table plus an AI-generated study plan recommendation.' },
  { q: 'Can I prepare for two exams simultaneously?', a: 'For exams with high syllabus overlap (50%+ shared subjects), parallel preparation is feasible if exam dates are at least 6 weeks apart. Each comparison page calls out overlap explicitly so you can decide.' },
  { q: 'Why are only some exam pairs listed?', a: 'We auto-generate comparison pages for popular exams within the same country only — comparing JEE Main with WAEC would not be useful since they target different student populations. We currently cover ' + totalPairs + ' meaningful pairs.' },
];
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout title={title} description={description} image="/og-image.jpg">
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <Navbar />
  <main class="max-w-6xl mx-auto px-4 py-10">
    <nav class="text-sm text-gray-500 mb-4"><a href="/">Home</a> &rsaquo; <span>Compare Exams</span></nav>
    <h1 class="text-4xl font-bold mb-4">Compare Competitive Exams {year}</h1>
    <p class="text-lg text-gray-700 mb-6">{description}</p>
    <div class="grid md:grid-cols-2 gap-6 mb-10">
      <div class="bg-blue-50 rounded-lg p-5">
        <h2 class="font-semibold text-lg mb-2">How comparisons work</h2>
        <ul class="list-disc pl-5 text-gray-700 space-y-1 text-sm">
          <li>Syllabus overlap (shared subjects)</li>
          <li>Eligibility & age limits</li>
          <li>Exam-pattern parity</li>
          <li>Difficulty & cutoff trends</li>
          <li>AI-generated parallel-prep recommendation</li>
        </ul>
      </div>
      <div class="bg-emerald-50 rounded-lg p-5">
        <h2 class="font-semibold text-lg mb-2">Quick stats</h2>
        <div class="grid grid-cols-2 gap-3 text-sm">
          <div><div class="text-2xl font-bold">{totalPairs}</div><div class="text-gray-600">Total pairs</div></div>
          <div><div class="text-2xl font-bold">{Object.keys(pairsByCountry).length}</div><div class="text-gray-600">Countries</div></div>
        </div>
      </div>
    </div>

    {Object.entries(pairsByCountry).map(([country, pairs]) => {
      const meta = COUNTRY_LABELS[country] || { label: country, flag: '🌍' };
      return (
        <section class="mb-10">
          <h2 class="text-2xl font-semibold mb-4">{meta.flag} {meta.label} ({pairs.length} comparisons)</h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-3">
            {pairs.slice(0, 30).map(p => (
              <a href={`/compare/${p.slug}/`} class="block bg-white border rounded-lg p-3 hover:shadow-md hover:border-blue-300 transition">
                <div class="font-medium text-gray-900 text-sm">{p.a.examName} <span class="text-gray-400">vs</span> {p.b.examName}</div>
              </a>
            ))}
          </div>
          {pairs.length > 30 && <p class="text-sm text-gray-500 mt-2">+ {pairs.length - 30} more {meta.label} comparisons</p>}
        </section>
      );
    })}

    <section class="mt-12 border-t pt-8">
      <h2 class="text-2xl font-semibold mb-4">Frequently asked</h2>
      <div class="space-y-4">
        {faqs.map(f => (
          <details class="bg-gray-50 rounded p-4">
            <summary class="font-medium cursor-pointer">{f.q}</summary>
            <p class="mt-2 text-gray-700 text-sm">{f.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
