---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqSection from '../components/FaqSection.astro';
import { ALL_EXAMS } from '../data/exams';

const LAST_UPDATED = 'April 2026';
const examCount = ALL_EXAMS.length;
const examLabel = `${examCount}+`;

const EXAM_STATS = [
  { value: examLabel, label: 'Exams', sub: 'Directory listings, core depth in IN/PK/NG' },
  { value: '3+',  label: 'Core markets', sub: 'India, Pakistan, Nigeria first' },
  // Honest inventory (~2,800+ published topic notes as of 2026-07) — was
  // understating as "200+" which looked neglected vs the live notes corpus.
  { value: '2,800+', label: 'Topics', sub: 'Syllabus-mapped study notes' },
  { value: '100%', label: 'Free', sub: 'No signup, no fees' },
];

const ABOUT_FAQS = [
  {
    question: 'What is StudyRoadmap?',
    answer: 'StudyRoadmap is a free AI-powered study planning tool for students in India, Pakistan, and Nigeria. It generates instant, personalised study roadmaps for 125+ competitive exams — including NEET, JEE, UPSC, MDCAT, JAMB, and WAEC. Simply select your exam, choose your available preparation time, and get a structured daily study plan based on official syllabus topic weightings.',
  },
  {
    question: 'How does the roadmap algorithm work?',
    answer: 'Every exam topic is assigned a weight based on its share of the total syllabus and its importance in previous exam papers. When you generate a roadmap, our algorithm selects the highest-weight topics that fit within your chosen time window, then sequences them for optimal learning progression — covering fundamentals before advanced topics, and interleaving related concepts where appropriate.',
  },
  {
    question: 'Is my data saved when I use StudyRoadmap?',
    answer: 'StudyRoadmap saves your exam choices, roadmap data, and study preferences locally in your browser using localStorage — they never leave your device as account data, and there is no account system or student database on our end. We use Google Analytics 4 (G-XPWXLW8J3R) for aggregated traffic measurement; our hosting providers log basic request data for security and operations; and when advertising is enabled, partners such as Google AdSense may set their own cookies. Clearing your browser data removes local preferences. See our privacy policy for full details and opt-out options.',
  },
  {
    question: 'How accurate are the study roadmaps?',
    answer: 'Roadmaps are generated from publicly available official syllabus data published by exam conducting bodies (NTA for NEET/JEE, UPSC for civil services, JAMB for Nigerian exams, etc.). Topic weights are derived from historical exam pattern analysis. While roadmaps are a valuable planning aid, always cross-check with the latest official syllabus and your institution or coaching provider.',
  },
  {
    question: 'Which countries and exams does StudyRoadmap support?',
    answer: 'StudyRoadmap covers India (NEET, JEE Main, JEE Advanced, CUET, UPSC, SSC CGL, CAT, CLAT, NDA, UGC NET, GRE), Pakistan (MDCAT, ECAT, NAT-I, LAT, HAT-UG), and Nigeria (JAMB, WAEC, NECO, NABTEB, NCEE) — 125+ exams across 3+ countries.',
  },
];
---

<Layout
  title="About StudyRoadmap — Free AI Exam Study Plans"
  description="About StudyRoadmap: free AI study plans and notes for NEET, JEE, UPSC, MDCAT, JAMB and 125+ exams across India, Pakistan, and Nigeria."
  faqs={ABOUT_FAQS}
  author={{
    name: "Pushkar Saini",
    jobTitle: "Founder & Editor",
    affiliation: "StudyRoadmap",
    url: "https://studyroadmap.in/author/pushkar-saini/",
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://studyroadmap.in/' },
      { '@type': 'ListItem', position: 2, name: 'About', item: 'https://studyroadmap.in/about/' },
    ],
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    'name': 'About StudyRoadmap™',
    'description': 'StudyRoadmap™ is a free AI-powered study planning tool for students in India, Pakistan, and Nigeria preparing for 125+ competitive exams including NEET, JEE, UPSC, MDCAT, JAMB, and WAEC.',
    'url': 'https://studyroadmap.in/about/',
    'datePublished': '2026-04-01',
    'dateModified': '2026-04-07',
    'about': {
      '@type': 'WebSite',
      'name': 'StudyRoadmap™',
      'url': 'https://studyroadmap.in',
      'description': 'Free AI-powered study planning tool for competitive exams across India, Pakistan, and Nigeria',
      'applicationCategory': 'EducationApplication',
      'operatingSystem': 'Web',
      'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' }
    },
    'mainEntity': {
      '@type': 'Organization',
      'name': 'StudyRoadmap™',
      'url': 'https://studyroadmap.in',
      'description': 'Free AI-powered study planning tool for competitive exam students across India, Pakistan, and Nigeria.',
      'areaServed': [
        { '@type': 'Country', 'name': 'India' },
        { '@type': 'Country', 'name': 'Pakistan' },
        { '@type': 'Country', 'name': 'Nigeria' }
      ],
      'sameAs': []
    }
  })} />
  <Navbar />

  <main id="main-content" class="flex-1">
    <section class="bg-surface-50 dark:bg-surface-950 border-b border-surface-200 dark:border-surface-800">
      <div class="container-page py-14 sm:py-20">
        <nav class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400 mb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a>
          <span>›</span>
          <span class="text-surface-700 dark:text-surface-200">About Us</span>
        </nav>
        <div class="text-center">
        <h1 class="heading-1 text-surface-900 dark:text-surface-50 mb-3">About StudyRoadmap™</h1>
        <p class="text-base sm:text-lg text-surface-600 dark:text-surface-400 max-w-xl mx-auto">
          Built for students who need a free, syllabus-based plan — operated from Delhi, India by Pushkar Saini.
        </p>
      </div>
    </section>

    <!-- Founder section — named editorial owner for E-E-A-T -->
    <section class="container-page py-12 max-w-3xl mx-auto">
      <div class="card p-6 sm:p-8">
        <p class="text-xs text-surface-500 uppercase tracking-wider mb-1">Founder &amp; Editor</p>
        <h2 class="text-2xl font-bold text-white mb-3">
          <a href="/author/pushkar-saini/" class="hover:text-brand-400" rel="author">Pushkar Saini</a>
        </h2>
        <p class="text-surface-300 leading-relaxed mb-4">
          I'm Pushkar. I built StudyRoadmap™ to give competitive-exam aspirants across India,
          Pakistan and Nigeria a free study plan rooted in the actual exam-board syllabus
          rather than coaching-centre marketing. I own the editorial gate: every published
          note moves through a four-stage <a href="/editorial-process/" class="text-brand-600 dark:text-brand-400 hover:underline">research → draft → fact-verify → curate pipeline</a>
          and lands on the site only after it passes.
        </p>
        <p class="text-surface-300 leading-relaxed">
          Editorial corrections, sourcing questions, and partnership enquiries:
          <a href="mailto:pushkersaini@gmail.com" class="text-brand-600 dark:text-brand-400 hover:underline">pushkersaini@gmail.com</a>.
        </p>
      </div>
    </section>

    <!-- Stats banner -->
    <section class="bg-brand-600 py-8">
      <div class="container-page">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          {EXAM_STATS.map(s => (
            <div class="text-center">
              <div class="text-3xl font-black text-white">{s.value}</div>
              <div class="text-sm font-semibold text-brand-100">{s.label}</div>
              <div class="text-xs text-brand-200 mt-0.5">{s.sub}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="container-page py-14 max-w-3xl mx-auto space-y-12">
      <div class="card p-6 sm:p-8">
        <h2 class="heading-2 text-surface-900 dark:text-white mb-4">What is StudyRoadmap™?</h2>
        <div class="space-y-4 text-surface-600 dark:text-surface-400 leading-relaxed">
          <p>
            StudyRoadmap™ is a <strong class="text-surface-900 dark:text-surface-100">free, instant study planning tool</strong> that generates personalised roadmaps for students preparing for competitive exams across India, Pakistan, and Nigeria.
          </p>
          <p>
            Whether you're preparing for <strong class="text-surface-900 dark:text-surface-100">NEET, JEE, UPSC, MDCAT, JAMB, WAEC</strong> or any of 125+ exams we support — just select your exam, choose your timeline, and get a structured study plan in seconds. No signup, no fees.
          </p>
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="heading-2 text-surface-900 dark:text-white mb-4">How It Works</h2>
        <div class="space-y-4 text-surface-600 dark:text-surface-400 leading-relaxed">
          <p>
            We analyse the official syllabus and weightings for each exam topic. Based on your available preparation time, our algorithm selects and sequences the most impactful topics — so you always know exactly what to study next.
          </p>
          <p>
            The roadmap is broken down by <strong class="text-surface-900 dark:text-surface-100">subject</strong> and <strong class="text-surface-900 dark:text-surface-100">topic priority</strong>, with high-weight topics surfaced first. You can switch durations instantly to see how your plan adapts.
          </p>
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="heading-2 text-surface-900 dark:text-white mb-4">Built for Students</h2>
        <div class="space-y-4 text-surface-600 dark:text-surface-400 leading-relaxed">
          <p>
            StudyRoadmap™ was created to solve a problem every competitive exam student knows: where do I start? With so many topics, so little time, and coaching only accessible to those who can afford it — the gap between those with a plan and those without is enormous.
          </p>
          <p>
            A good study plan should be free. Every student, regardless of background or location, deserves to know which topics matter most and in what order to study them. That's the gap this site exists to fill. Notes are AI-assisted drafts that I fact-check against official syllabi before they are indexed — details are on the <a href="/editorial-process/" class="text-brand-600 dark:text-brand-400 hover:underline">editorial process</a> page. StudyRoadmap is not an exam board and is not a coaching institute.
          </p>
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="heading-2 text-surface-900 dark:text-white mb-4">Our Mission</h2>
        <div class="space-y-4 text-surface-600 dark:text-surface-400 leading-relaxed">
          <p>
            Every student deserves access to quality study planning — regardless of whether they can afford expensive coaching. StudyRoadmap™ levels the playing field by giving every student a structured, data-driven study plan <strong class="text-surface-900 dark:text-surface-100">completely free</strong>.
          </p>
          <p>
            We're starting with South Asia and Africa, where competitive exam pressure is highest and access to structured planning tools is often limited to those who can pay for coaching.
          </p>
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="heading-2 text-surface-900 dark:text-white mb-4">Important Disclaimer</h2>
        <div class="p-4 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-xl text-sm text-amber-800 dark:text-amber-200 leading-relaxed">
          StudyRoadmap™ is a <strong>planning aid only</strong>. The roadmaps are generated based on publicly available syllabus information and are not affiliated with any exam board or conducting body. Always verify information with official sources before making decisions about your exam preparation.
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="heading-2 text-surface-900 dark:text-white mb-4">How We Keep Roadmaps Accurate</h2>
        <div class="space-y-4 text-surface-600 dark:text-surface-400 leading-relaxed">
          <p>
            Every roadmap is tied to the official exam syllabus published by the conducting body. When an exam board releases updated syllabuses or announces pattern changes, we review and revise the affected roadmap data.
          </p>
          <p>
            Our process: we monitor official exam board websites (NTA, JAMB, PMDC, WAEC, and others listed below) for syllabus and notification updates. Roadmaps are built from topic-level syllabus weightings, not guesswork — the priority order of topics within each subject reflects how often and how heavily that topic has appeared in recent exam papers.
          </p>
          <p class="text-sm text-surface-500 dark:text-surface-500">
            <strong>Note:</strong> Exam schedules, eligibility criteria, and registration dates change frequently. Always confirm the latest information directly from your exam board's official website before making decisions.
          </p>
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="heading-2 text-surface-900 dark:text-white mb-4">Methodology & Sources</h2>
        <div class="space-y-4 text-surface-600 dark:text-surface-400 leading-relaxed">
          <p>
            Every roadmap is built from publicly available syllabus and exam pattern data published by the official conducting bodies. We analyse topic weightings from past exam papers and official curriculum documents, then sequence topics by impact and feasibility within your chosen time window.
          </p>
          <p>
            We do not have official partnerships with any exam board. All information is sourced from public documents and is intended as a supplementary planning tool only.
          </p>
          <div class="grid sm:grid-cols-3 gap-3 mt-4">
            <a href="https://neet.nta.nic.in/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-3 rounded-lg border border-surface-200 dark:border-surface-700 hover:border-brand-400 dark:hover:border-brand-600 transition-colors group">
              <span class="text-lg">🇮🇳</span>
              <div>
                <div class="text-xs font-semibold text-surface-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400">India</div>
                <div class="text-xs text-surface-500">NTA (NEET, JEE, CUET)</div>
              </div>
            </a>
            <a href="https://www.upsc.gov.in/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-3 rounded-lg border border-surface-200 dark:border-surface-700 hover:border-brand-400 dark:hover:border-brand-600 transition-colors group">
              <span class="text-lg">🇮🇳</span>
              <div>
                <div class="text-xs font-semibold text-surface-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400">India</div>
                <div class="text-xs text-surface-500">UPSC (Civil Services)</div>
              </div>
            </a>
            <a href="https://www.jamb.gov.ng/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-3 rounded-lg border border-surface-200 dark:border-surface-700 hover:border-brand-400 dark:hover:border-brand-600 transition-colors group">
              <span class="text-lg">🇳🇬</span>
              <div>
                <div class="text-xs font-semibold text-surface-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400">Nigeria</div>
                <div class="text-xs text-surface-500">JAMB (UTME)</div>
              </div>
            </a>
            <a href="https://www.pmdc.edu.pk/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-3 rounded-lg border border-surface-200 dark:border-surface-700 hover:border-brand-400 dark:hover:border-brand-600 transition-colors group">
              <span class="text-lg">🇵🇰</span>
              <div>
                <div class="text-xs font-semibold text-surface-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400">Pakistan</div>
                <div class="text-xs text-surface-500">PMDC (MDCAT)</div>
              </div>
            </a>
            <a href="https://www.waec.org.ng/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-3 rounded-lg border border-surface-200 dark:border-surface-700 hover:border-brand-400 dark:hover:border-brand-600 transition-colors group">
              <span class="text-lg">🇳🇬</span>
              <div>
                <div class="text-xs font-semibold text-surface-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400">Nigeria</div>
                <div class="text-xs text-surface-500">WAEC (WASSCE)</div>
              </div>
            </a>
            <a href="https://www.ssc.gov.pk/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 p-3 rounded-lg border border-surface-200 dark:border-surface-700 hover:border-brand-400 dark:hover:border-brand-600 transition-colors group">
              <span class="text-lg">🇵🇰</span>
              <div>
                <div class="text-xs font-semibold text-surface-900 dark:text-white group-hover:text-brand-600 dark:group-hover:text-brand-400">Pakistan</div>
                <div class="text-xs text-surface-500">ECAT, NTS</div>
              </div>
            </a>
          </div>
        </div>
      </div>

      <div class="card p-6 sm:p-8">
        <h2 class="heading-2 text-surface-900 dark:text-white mb-4">Content Review & Quality Standards</h2>
        <div class="space-y-4 text-surface-600 dark:text-surface-400 leading-relaxed">
          <p>
            Every roadmap and set of study notes goes through a multi-step review before it is published. First, topic priorities are cross-checked against the latest official syllabus published by the relevant exam board. Second, content depth is verified against standard textbooks and reputable reference materials for each subject. Third, the roadmap sequencing algorithm is tested across all available time windows to ensure logical topic progression.
          </p>
          <p>
            Updates are triggered whenever an exam board releases a revised syllabus or changes the exam pattern. We monitor NTA (neet.nta.nic.in, jeemain.nta.nic.in), JAMB (jamb.gov.ng), PMDC (pmdc.edu.pk), WAEC (waec.org.ng), and individual university websites on a rolling basis.
          </p>
          <div class="grid sm:grid-cols-2 gap-3 mt-4">
            <div class="flex items-start gap-3 p-3 rounded-lg bg-surface-50 dark:bg-surface-800">
              <span class="text-brand-600 mt-0.5">✓</span>
              <div>
                <div class="text-sm font-semibold text-surface-900 dark:text-surface-100">Syllabus-Correct</div>
                <div class="text-xs text-surface-500">Based on official NTA, JAMB, PMDC, WAEC syllabuses</div>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 rounded-lg bg-surface-50 dark:bg-surface-800">
              <span class="text-brand-600 mt-0.5">✓</span>
              <div>
                <div class="text-sm font-semibold text-surface-900 dark:text-surface-100">Exam-Pattern Verified</div>
                <div class="text-xs text-surface-500">Topic weights from past 5 years of exam papers</div>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 rounded-lg bg-surface-50 dark:bg-surface-800">
              <span class="text-brand-600 mt-0.5">✓</span>
              <div>
                <div class="text-sm font-semibold text-surface-900 dark:text-surface-100">Editor-gated</div>
                <div class="text-xs text-surface-500">AI-assisted drafts, signed off by Pushkar Saini (Delhi, India)</div>
              </div>
            </div>
            <div class="flex items-start gap-3 p-3 rounded-lg bg-surface-50 dark:bg-surface-800">
              <span class="text-brand-600 mt-0.5">✓</span>
              <div>
                <div class="text-sm font-semibold text-surface-900 dark:text-surface-100">Regularly Updated</div>
                <div class="text-xs text-surface-500">Roadmaps revised when exam boards change syllabuses</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <p class="text-center text-xs text-surface-400">
        Last updated: {LAST_UPDATED} · StudyRoadmap™ is not affiliated with any exam board.
      </p>
    </section>
      <FaqSection faqs={ABOUT_FAQS} heading="About StudyRoadmap — FAQs" />

  </main>

  <Footer />

  <!-- SoftwareApplication schema — signals app-like tool to search engines -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "StudyRoadmap",
    "description": "Free AI-powered study planning tool for competitive exams in India, Pakistan, and Nigeria. Generates instant personalised study roadmaps for 125+ exams including NEET, JEE, UPSC, MDCAT, JAMB, and WAEC.",
    "url": "https://studyroadmap.in",
    "applicationCategory": "EducationApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "featureList": "AI study roadmap generator, 125+ competitive exams, subject-wise study notes, mobile-responsive, no signup required",
    "screenshot": "https://studyroadmap.in/og-image.jpg",
    "author": {
      "@type": "Organization",
      "name": "StudyRoadmap",
      "url": "https://studyroadmap.in"
    }
  })} />
</Layout>
