# build output
dist/
# Quarantined build output. A host-side ROOT-run `npm run build` recreates dist/
# and node_modules/.vite with root ownership, which makes the node-owned workspace
# un-writable (EACCES on unlink/mkdir) and therefore makes the mandatory
# _policy.md end-of-run `npm run build` gate un-runnable for every claw pulse.
# Claw pulses rename the root-owned tree aside instead of deleting it (a claw runs
# as uid 1000 `node` and CANNOT unlink files inside a root-owned directory), so the
# renamed copy must stay ignored or scripts/check-scope.sh blocks ~1945 paths.
# `dist/` above matches only the exact name; these globs are required.
dist.tmp*/
dist.rootowned-*/
dist/rootowned-archive/
# generated types
.astro/
# Same root-ownership quarantine as dist/ above - see the comment there.
.astro.rootowned-*/
.astro.tmp*/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production
# .env.local is the conventional home for local secrets and was NOT covered
# here, while .env and .env.production were. That is the exact file an agent or
# a developer is most likely to paste a live key into, so it must be ignored.
.env.local
.env.*.local
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# BMAD-METHOD (local agent tooling, not part of the site)
_bmad/
_bmad-output/
.claude/
.grok/
test-results/

# build/compiled artifacts that must never be tracked (leaked previously)
__pycache__/
*.pyc
*.tar.gz

# Generated at build (BUG-100 per-exam roadmap payloads)
public/data/roadmap/

# pi agent tooling (local, not part of the site) + project MCP config (contains secrets)
.pi/
.mcp.json

# Untracked build-output snapshot; trips check-scope.sh untracked set. See sr-1107Z.
dist.snap-pre*/

# Same quarantine family, renamed prefix. A claw pulse that renames a failed
# build tree aside picked `dist.nodefail-*` instead of `dist.rootowned-*`, which
# the globs above do not match, so check-scope.sh flagged 1676 paths under it and
# the mandatory _policy.md end-of-run scope gate stayed red for every claw.
dist.nodefail-*/
