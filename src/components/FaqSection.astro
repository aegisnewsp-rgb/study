---
// Visible FAQ list backing the FAQPage JSON-LD emitted by Layout.astro.
// Google's structured-data policy requires marked-up FAQ content to be
// visible on the page — any page that passes faqs= to Layout must also
// render this section (2026-07-04 audit: 7 pages emitted schema-only FAQs).
interface FAQItem {
  question: string;
  answer: string;
}
interface Props {
  faqs: FAQItem[];
  heading?: string;
}
const { faqs, heading = 'Frequently asked questions' } = Astro.props;
---

{faqs.length > 0 && (
  <section class="container-page py-10 border-t border-surface-200 dark:border-surface-700">
    <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-5">{heading}</h2>
    <div class="max-w-3xl divide-y divide-surface-200 dark:divide-surface-700">
      {faqs.map((f) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer items-center justify-between gap-3 font-semibold text-surface-900 dark:text-white list-none">
            <span>{f.question}</span>
            <span class="text-brand-500 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
          </summary>
          <p class="mt-3 text-sm text-surface-700 dark:text-surface-300 leading-relaxed">{f.answer}</p>
        </details>
      ))}
    </div>
  </section>
)}
