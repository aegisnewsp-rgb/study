---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RoadmapApp from '../components/RoadmapApp';
import FaqSection from '../components/FaqSection.astro';
import { getCollection } from 'astro:content';
import { ALL_EXAMS } from '../data/exams';
import { EXAM_FAQS } from '../data/exam-faqs';
import { isGoodNote, isIndexableExamHub } from '../data/note-quality';
import { getPcmNotesPool } from '../data/notes-pool';

// Only show the "notes →" shortcut for exams whose notes hub both exists
// (≥1 good note — all-bad hubs 404) and is indexable — linking noindexed
// hubs from this indexed page would leak follow-links (2026-07-04 audit).
const allNotesList = await getCollection('notes');
const validNoteIdSet = new Set(allNotesList.filter(isGoodNote).map(n => n.id));
const goodNotesByExam = new Map<string, number>();
for (const n of allNotesList) {
  const examId = n.id.split('/')[0];
  if (isGoodNote(n)) goodNotesByExam.set(examId, (goodNotesByExam.get(examId) || 0) + 1);
}
const examsWithNotes = new Set(
  [...goodNotesByExam.entries()]
    .filter(([examId, good]) => isIndexableExamHub(good, examId))
    .map(([examId]) => examId)
);

const ROADMAP_FAQS = [
  {
    question: 'How do I read my study roadmap?',
    answer: 'Your roadmap is organised by subject and day. Each day shows the topics to study, in the order that maximises your score potential. Start from Day 1 and work through sequentially — topics marked higher-weight are the ones most likely to appear on exam day.',
  },
  {
    question: 'What if I miss a day or fall behind?',
    answer: 'Simply pick up from where you stopped. The roadmap is a guide, not a strict schedule. If you miss several days, focus on the highest-weight remaining topics first — our algorithm always prioritises the most exam-relevant content.',
  },
  {
    question: 'Can I reset or regenerate my roadmap?',
    answer: 'Yes — just reload the page and select your exam and duration again. Your previous roadmap will be replaced. There is no account needed and no limit on how many roadmaps you generate.',
  },
  {
    question: 'How is the daily study plan generated?',
    answer: 'We analyse the official syllabus weightings for each topic of your chosen exam. The algorithm selects and sequences the highest-impact topics based on your available time, so you always study what matters most first.',
  },
  {
    question: 'Can I change my roadmap after generating it?',
    answer: 'You can generate a new roadmap at any time by selecting a different exam or duration. Each generation is independent — there is no save feature because no account is required.',
  },
  {
    question: 'Is my roadmap data saved anywhere?',
    answer: 'Your exam choices and generated roadmap are stored only in your browser local storage and are never transmitted to our servers as account data. We use Google Analytics 4 for aggregated traffic measurement; see our privacy policy for full details and opt-out options.',
  },

  {
    question: 'How does StudyRoadmap support Indian exam preparation?',
    answer: 'StudyRoadmap covers all major Indian entrance exams — NEET, JEE Main, JEE Advanced, CUET, UPSC, SSC CGL, CAT, CLAT, NDA, and UGC NET. Select your exam and available time to get an instant, prioritised study plan based on official syllabus weightings. All content is free, no login required.',
  },
  {
    question: "Which countries' exams are available on StudyRoadmap?",
    answer: 'StudyRoadmap covers exams across three countries: India (NEET, JEE, CUET, UPSC, SSC CGL, CAT, CLAT, NDA, UGC NET), Pakistan (MDCAT, ECAT, NAT-I, LAT, HAT-UG), and Nigeria (JAMB, WAEC, NECO, NABTEB, NCEE). All exams are completely free to plan for.',
  },
  {
    question: 'Can I use StudyRoadmap on a mobile phone?',
    answer: 'Yes. StudyRoadmap is designed for low-data and mobile environments. All pages are lightweight and load quickly even on 2G connections. No app download is needed — just open the website and generate your roadmap instantly.',
  },
  {
    question: 'Is there any exam for Pakistan on StudyRoadmap?',
    answer: 'Yes. StudyRoadmap covers MDCAT (medical), ECAT (engineering), NAT-I, LAT (law), and HAT-UG (universities) for Pakistan. Select your exam and duration to get an instant, algorithm-generated study plan.',
  },
  {
    question: 'What Nigerian exams are available?',
    answer: 'StudyRoadmap covers JAMB UTME, WAEC, NECO, NABTEB, and NCEE. Whether you are preparing for university admission or secondary school certification, select your exam and timeline to get a ranked study plan instantly.',
  },
  {
    question: 'How often is exam content updated?',
    answer: 'StudyRoadmap syllabus data is reviewed regularly. Each exam page lists the topics and their weightings based on the latest official exam patterns. If you notice outdated content, you can report it via the contact email on the site.',
  },
];

// Group exams by country for the "Browse More" internal links section
const byCountry = {
  india:    { label: 'India',    flag: '🇮🇳', exams: ALL_EXAMS.filter(e => e.country === 'india') },
  pakistan: { label: 'Pakistan', flag: '🇵🇰', exams: ALL_EXAMS.filter(e => e.country === 'pakistan') },
  nigeria:  { label: 'Nigeria',  flag: '🇳🇬', exams: ALL_EXAMS.filter(e => e.country === 'nigeria') },
};

import { SITE_URL } from '@data/site';
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Roadmap', item: `${SITE_URL}/roadmap/` },
  ],
};

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to Create a Free Study Roadmap',
  description: 'Generate a personalised, prioritised study roadmap for any exam — free, instant, no signup required.',
  step: [
    {
      '@type': 'HowToStep',
      name: 'Step 1: Select your exam from the dropdown',
      text: 'Open the roadmap page at studyroadmap.in/roadmap. Choose your competitive exam — NEET, JEE, UPSC, MDCAT, JAMB, WAEC, or 20+ others. The roadmap is tailored to your specific exam syllabus and pattern.',
      url: 'https://studyroadmap.in/roadmap/',
    },
    {
      '@type': 'HowToStep',
      name: 'Step 2: Choose your available preparation time',
      text: 'Enter how many hours per day you can study and your exam date or total number of days available. The algorithm uses this to calculate how many topics you can cover and in what order.',
      url: 'https://studyroadmap.in/roadmap/',
    },
    {
      '@type': 'HowToStep',
      name: 'Step 3: View your AI-generated study roadmap',
      text: 'Your personalised roadmap loads instantly, showing the highest-weight topics organised by subject and day. Topics are sequenced by exam relevance so you always study what matters most first.',
      url: 'https://studyroadmap.in/roadmap/',
    },
    {
      '@type': 'HowToStep',
      name: 'Step 4: Study topics in priority order',
      text: 'Follow the roadmap day by day. Each day shows the topics to study, with exam-weight guidance so you know which topics carry the most marks. Open the free study notes for any topic with one click.',
      url: 'https://studyroadmap.in/notes/',
    },
    {
      '@type': 'HowToStep',
      name: 'Step 5: Mark topics complete as you progress',
      text: 'Tick off topics as you complete them. The roadmap updates dynamically, helping you stay on track and adjust if you miss a day or skip ahead.',
      url: 'https://studyroadmap.in/roadmap/',
    },
  ],
};

// RoadmapApp is client:only — Astro serializes props into HTML. Embedding full
// duration/topic graphs produced a ~12–24 MB page (BUG-100). Catalog-only props
// stay under ~100 KB; full exam payloads are written to /data/roadmap/{id}.json
// and fetched client-side when the user selects an exam.
import { mkdirSync, writeFileSync } from 'node:fs';
import { join } from 'node:path';

const ROADMAP_DATA_DIRS = [
  join(process.cwd(), 'public', 'data', 'roadmap'),
  join(process.cwd(), 'dist', 'data', 'roadmap'),
];
for (const dir of ROADMAP_DATA_DIRS) {
  try { mkdirSync(dir, { recursive: true }); } catch { /* dist may not exist yet in dev */ }
}

function slimDurationPayload(e: any) {
  const subjectIdByName: Record<string, string> = {};
  for (const s of (e.subjects || [])) {
    if (s?.name && s?.id) subjectIdByName[s.name] = s.id;
  }
  return {
    examId: e.examId,
    examName: e.examName,
    country: e.country,
    faqs: EXAM_FAQS[e.examId] || [],
    subjects: (e.subjects || []).map((sub: any) => ({ id: sub.id, name: sub.name, color: sub.color })),
    durations: Object.fromEntries(Object.entries(e.durations || {}).map(([k, d]: [string, any]) => [k, {
      duration: k,
      description: d.description,
      totalDays: d.totalDays,
      dailyTopics: (d.dailyTopics || []).map((t: any) => {
        const sid = subjectIdByName[t.subject] || String(t.subject || '').toLowerCase().replace(/\s+/g, '-');
        let notePath: string | null = null;
        const directId = `${e.examId}/${sid}/${t.id}`;
        if (validNoteIdSet.has(directId)) {
          notePath = `/notes/${directId}/`;
        } else {
          const pool = getPcmNotesPool(e.examId, sid);
          if (pool) {
            const poolId = `${pool.exam}/${pool.subject}/${t.id}`;
            if (validNoteIdSet.has(poolId)) {
              notePath = `/notes/${poolId}/`;
            }
          }
        }
        return {
          id: t.id,
          name: t.name,
          subject: t.subject,
          weight: t.weight,
          hasNote: Boolean(notePath),
          notePath,
        };
      }),
    }])),
  };
}

const CATALOG_EXAMS = ALL_EXAMS.filter((e: any) => e && e.examId).map((e: any) => {
  const payload = slimDurationPayload(e);
  const json = JSON.stringify(payload);
  for (const dir of ROADMAP_DATA_DIRS) {
    try { writeFileSync(join(dir, `${e.examId}.json`), json); } catch { /* ignore */ }
  }
  return {
    examId: e.examId,
    examName: e.examName,
    country: e.country,
    subjects: payload.subjects,
    // empty durations in props — RoadmapApp fetches full payload on select
    durations: {} as Record<string, never>,
  };
});

try {
  const catalogJson = JSON.stringify(CATALOG_EXAMS.map(({ examId, examName, country, subjects }) => ({
    examId, examName, country, subjects,
  })));
  for (const dir of ROADMAP_DATA_DIRS) {
    try { writeFileSync(join(dir, 'catalog.json'), catalogJson); } catch { /* ignore */ }
  }
} catch { /* ignore */ }

const SLIM_EXAMS = CATALOG_EXAMS;

---

<Layout
  title="Free AI Study Roadmap Generator — 125+ Exams"
  description="Generate a free personalised study roadmap for NEET, JEE, UPSC, MDCAT, JAMB, WAEC and 125+ exams. Instant AI plan, no signup required."
  faqs={ROADMAP_FAQS}
  author={{
    name: "StudyRoadmap Editorial Team",
    jobTitle: "Curriculum Editors",
    affiliation: "StudyRoadmap",
    url: "https://studyroadmap.in/about/",
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  <Navbar />

  <main id="main-content" class="flex-1">
    <!-- Page header -->
    <section class="bg-surface-50 dark:bg-surface-950 border-b border-surface-200 dark:border-surface-800">
      <div class="container-page py-14 sm:py-20 text-center">
        <h1 class="heading-1 text-surface-900 dark:text-surface-50 mb-3">
          Study Roadmap Generator
        </h1>
        <p class="text-base sm:text-lg text-surface-600 dark:text-surface-400 max-w-xl mx-auto">
          Choose your exam and timeline — get an instant personalised study plan.
        </p>
      </div>
    </section>

    <!-- React island: all interactivity lives here -->
    <RoadmapApp exams={SLIM_EXAMS as any} client:only="react" />

    <!-- Exam-specific FAQ section (populated by JS when exam is selected) -->
    <section id="exam-faq-section" class="hidden border-t border-surface-200 dark:border-surface-800">
      <div class="container-page py-12">
        <h2 class="heading-2 text-surface-900 dark:text-surface-50 mb-2" id="exam-faq-heading">📋 Exam FAQs</h2>
        <p class="text-sm text-surface-500 dark:text-surface-400 mb-8">
          Common questions about this exam's eligibility, pattern, and preparation strategy.
        </p>
        <div id="exam-faq-list" class="space-y-4"></div>
      </div>
    </section>

    <!-- Study Notes section -->
    <section class="bg-surface-50 dark:bg-surface-950 border-t border-surface-200 dark:border-surface-800">
      <div class="container-page py-12">
        <div class="flex items-center justify-between mb-3">
          <h2 class="heading-2 text-surface-900 dark:text-white">📚 Free Study Notes</h2>
          <a href="/notes/" class="text-sm font-medium text-brand-600 dark:text-brand-400 hover:underline">
            All exams →
          </a>
        </div>
        <p class="text-sm text-surface-500 dark:text-surface-400 mb-8">
          Browse 1,263 topic notes across all exams — each note includes a diagram prompt and exam-weight guidance.
        </p>
        <div class="grid sm:grid-cols-3 gap-8">
          {Object.entries(byCountry).map(([code, { label, flag, exams }]) => (
            <div>
              <div class="flex items-center gap-2 mb-4">
                <span class="text-xl">{flag}</span>
                <h3 class="font-semibold text-surface-800 dark:text-surface-100">{label}</h3>
                <span class="text-xs text-surface-400 bg-surface-100 dark:bg-surface-800 px-2 py-0.5 rounded-full">
                  {exams.length} exams
                </span>
              </div>
              <ul class="space-y-2">
                {exams.map(exam => (
                  <li class="flex items-center justify-between gap-2">
                    <a
                      href={`/exams/${exam.examId}/`}
                      class="text-sm text-surface-600 dark:text-surface-300 hover:text-brand-600 dark:hover:text-brand-400 hover:underline flex items-center gap-1.5"
                    >
                      <span class="text-surface-400">→</span>
                      {exam.examName}
                    </a>
                    {examsWithNotes.has(exam.examId) && (
                      <a
                        href={`/notes/${exam.examId}/`}
                        class="text-xs text-brand-600 dark:text-brand-400 hover:underline shrink-0"
                        aria-label={`${exam.examName} study notes`}
                      >
                        notes →
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Exam pages quick links -->
    <section class="border-t border-surface-200 dark:border-surface-800">
      <div class="container-page py-10">
        <h2 class="heading-3 text-surface-800 dark:text-surface-100 mb-6">Browse All Exams</h2>
        <div class="flex flex-wrap gap-2">
          {ALL_EXAMS.map(exam => (
            <a
              href={`/exams/${exam.examId}/`}
              class="text-sm px-3 py-1.5 bg-surface-100 dark:bg-surface-800 text-surface-700 dark:text-surface-300 rounded-full hover:bg-brand-50 dark:hover:bg-brand-950 hover:text-brand-700 dark:hover:text-brand-300 border border-surface-200 dark:border-surface-700 transition-colors"
            >
              {exam.examName}
            </a>
          ))}
        </div>
      </div>
    </section>

    <FaqSection faqs={ROADMAP_FAQS} heading="Roadmap generator — FAQs" />
  </main>

  <Footer />

  <!-- Dynamic exam-specific FAQ injection (loads on-demand from /data/roadmap/{exam}.json) -->
  <script is:inline>
    (function () {
      var examFaqSection = document.getElementById('exam-faq-section');
      var examFaqList = document.getElementById('exam-faq-list');
      var examFaqHeading = document.getElementById('exam-faq-heading');
      var currentExam = null;

      function getExamFromUrl() {
        var params = new URLSearchParams(window.location.search);
        return params.get('exam') || null;
      }

      function renderFaqs(faqs, examKey) {
        if (!faqs || !Array.isArray(faqs) || faqs.length === 0) {
          if (examFaqSection) examFaqSection.classList.add('hidden');
          currentExam = null;
          return;
        }

        if (examFaqHeading) examFaqHeading.textContent = '📋 ' + examKey.toUpperCase() + ' FAQs';
        if (examFaqList) {
          examFaqList.innerHTML = '';
          faqs.forEach(function (faq) {
            var item = document.createElement('details');
            item.className = 'group bg-surface-50 dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-lg overflow-hidden';

            var summary = document.createElement('summary');
            summary.className = 'flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none font-medium text-surface-800 dark:text-surface-100 hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors';
            var qSpan = document.createElement('span');
            qSpan.textContent = faq.question;
            var plusSpan = document.createElement('span');
            plusSpan.setAttribute('aria-hidden', 'true');
            plusSpan.className = 'text-surface-400 group-open:rotate-45 transition-transform';
            plusSpan.textContent = '+';
            summary.appendChild(qSpan);
            summary.appendChild(plusSpan);

            var answer = document.createElement('div');
            answer.className = 'px-5 pb-4 text-sm text-surface-600 dark:text-surface-300 leading-relaxed border-t border-surface-100 dark:border-surface-800 pt-3';
            answer.textContent = faq.answer;

            item.appendChild(summary);
            item.appendChild(answer);
            examFaqList.appendChild(item);
          });
        }

        if (examFaqSection) examFaqSection.classList.remove('hidden');
        currentExam = examKey;
      }

      function onExamChange() {
        var examKey = getExamFromUrl();
        if (!examKey) {
          if (examFaqSection) examFaqSection.classList.add('hidden');
          currentExam = null;
          return;
        }
        var normalizedKey = examKey.toLowerCase().trim();
        if (normalizedKey !== currentExam) {
          fetch('/data/roadmap/' + encodeURIComponent(normalizedKey) + '.json')
            .then(function (res) { return res.ok ? res.json() : null; })
            .then(function (data) {
              if (data && data.faqs && data.faqs.length > 0) {
                renderFaqs(data.faqs, normalizedKey);
              } else if (examFaqSection) {
                examFaqSection.classList.add('hidden');
              }
            })
            .catch(function () {
              if (examFaqSection) examFaqSection.classList.add('hidden');
            });
        }
      }

      onExamChange();

      var lastUrl = window.location.href;
      setInterval(function () {
        if (window.location.href !== lastUrl) {
          lastUrl = window.location.href;
          onExamChange();
        }
      }, 500);

      window.addEventListener('popstate', function () {
        lastUrl = window.location.href;
        onExamChange();
      });
    })();
  </script>
</Layout>
