          >
            Explore Syllabus ({totalTopics} Topics) ↓
          </a>
          {examsWithNotes.has(exam.examId) && (
            <a
              href={`/notes/${exam.examId}/`}
              class="inline-flex items-center gap-2 text-brand-600 dark:text-brand-400 font-bold px-4 py-3.5 hover:underline text-sm"
            >
              Browse Study Notes →
            </a>
          )}
        </div>

        <!-- Resume this exam (localStorage) -->
