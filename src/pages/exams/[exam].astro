---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ShareRow from '../../components/ShareRow.astro';
import ExamReadinessIsland from '../../components/ExamReadinessIsland';
import { ALL_EXAMS, getCountryFlag } from '../../data/exams';
import { EXAM_FAQS } from '../../data/exam-faqs';
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import { isGoodNote, isIndexableExamHub, isIndexableSubjectHub, isPlaceholderExamTopic, placeholderSyllabusStats } from '../../data/note-quality';

// Only link note hubs that are actually indexable — this page is indexed, and a
// follow-link into a noindexed hub leaks crawl signals (policy: never link to
// noindex). Uses the same shared thresholds the hub pages use for their own
// robots meta, so the two can't drift apart.
const allNotes = await getCollection('notes');
const goodNotesPerExam = new Map<string, number>();
const goodNotesPerSubject = new Map<string, number>();
for (const n of allNotes.filter(isGoodNote)) {
  const parts = n.id.split('/');
  goodNotesPerExam.set(parts[0], (goodNotesPerExam.get(parts[0]) || 0) + 1);
  if (parts.length >= 2) {
    const key = `${parts[0]}/${parts[1]}`;
    goodNotesPerSubject.set(key, (goodNotesPerSubject.get(key) || 0) + 1);
  }
}
const examsWithNotes = new Set(
  [...goodNotesPerExam.entries()]
    .filter(([examId, count]) => isIndexableExamHub(count, examId))
    .map(([examId]) => examId),
);
const examSubjectNotes = new Set(
  [...goodNotesPerSubject.entries()]
    .filter(([key, count]) => isIndexableSubjectHub(count, key.split('/')[0]))
    .map(([key]) => key),
);
// Display names for literal "Topic N" syllabus rows.
//
// 48 subject files still carry corrupt placeholder rows ({ id: 'mathem-001',
// name: 'Topic 1' }) — real syllabus wording was never imported for them. Two
// wrong options exist: render "Topic 1" (a placeholder leak straight into the
// readiness tracker and the T17 index-hygiene gate) or drop the row (hides
// genuinely authored notes). So resolve each placeholder against the note that
// backs it: the note frontmatter already records the authoritative topicName.
// Only when no note exists is the row dropped — at which point it has neither a
// name nor content behind it.
const noteTopicNames = new Map<string, string>();
for (const n of allNotes) {
  const d: any = n.data;
  if (d?.exam && d?.subject && d?.topic && d?.topicName) {
    noteTopicNames.set(`${d.exam}/${d.subject}/${d.topic}`, String(d.topicName));
  }
}

export async function getStaticPaths() {
  return ALL_EXAMS
    .filter(e => e && e.examId)
    .map(exam => ({
      params: { exam: exam.examId },
      props: { exam },
    }));
}

const { exam } = Astro.props;
import { SITE_URL } from '@data/site';
const flag = getCountryFlag(exam.country) || '🌍';

// Live-exam banners — show a timely alert for exams happening right now
// (Add entries for upcoming exams with dates)
const LIVE_EXAMS: Record<string, { label: string; message: string; cta: string; ctaUrl: string; }> = {
};

const liveExam = LIVE_EXAMS[exam.examId];

const countryLabels: Record<string, string> = {
  india: 'India', pakistan: 'Pakistan', nigeria: 'Nigeria',
  bangladesh: 'Bangladesh', srilanka: 'Sri Lanka', nepal: 'Nepal',
  china: 'China', ethiopia: 'Ethiopia', ghana: 'Ghana', kenya: 'Kenya',
  malaysia: 'Malaysia', indonesia: 'Indonesia', philippines: 'Philippines',
  southafrica: 'South Africa', saudi: 'Saudi Arabia', uae: 'UAE',
};

const geoRegionMap: Record<string, string> = {
  india: 'IN', pakistan: 'PK', nigeria: 'NG', bangladesh: 'BD',
  kenya: 'KE', southafrica: 'ZA', uae: 'AE', malaysia: 'MY',
};

const hreflangMap: Record<string, string> = {
  india: 'en-IN', pakistan: 'en-PK', nigeria: 'en-NG', bangladesh: 'en-BD',
  kenya: 'en-KE', southafrica: 'en-ZA', uae: 'en-AE', malaysia: 'en-MY',
};

const examName = exam.examName || exam.examId;
const countryName = countryLabels[exam.country] || exam.country;

// Rich exam description
const fullDescription = exam.description
  ? exam.description.replace(/\\n/g, ' ').replace(/\\/g, '').replace(/"/g, '')
  : `Comprehensive ${examName} study guide and exam preparation resources. Free AI-powered study roadmap generator with personalized study plans based on your available time.`;

const fullExamPattern = exam.examPattern
  ? exam.examPattern.replace(/\\n/g, ' ').replace(/\\/g, '').replace(/"/g, '')
  : '';

const fullEligibility = exam.eligibility
  ? exam.eligibility.replace(/\\n/g, ' ').replace(/\\/g, '').replace(/"/g, '')
  : '';

const prepOverview = (exam as any).prepOverview
  ? String((exam as any).prepOverview).replace(/\\n/g, ' ').replace(/\\/g, '').replace(/"/g, '')
  : '';
const commonMistakes: string[] = Array.isArray((exam as any).commonMistakes)
  ? ((exam as any).commonMistakes as string[]).map((m) => String(m).trim()).filter(Boolean)
  : [];

const currentYear = new Date().getUTCFullYear();
// Stable site content-revision date — fallback for the ~4 exams without a
// per-exam lastUpdated. Never new Date(): build-time dates fake freshness.
const CONTENT_REV = '2026-05-28';
const heroHeadline = (exam as any).heroHeadline
  || `${examName} ${currentYear}: Exam Pattern, Eligibility & Study Plan`;
const BRAND_SUFFIX = ' | StudyRoadmap';
const title = (() => {
  // CTR repair 2026-09-18. Search Console (28d: 101,560 impressions, 1.29% CTR) showed
  // these pages ranking 6-9 on mobile and being ignored. The old title was
  // `${examName} ${year} Guide`, and "Guide" appears in NONE of the queries that earn the
  // impressions — those are informational ("spsc syllabus 2026", "gaokao exam syllabus",
  // "cs executive exam pattern", "cs executive group 1 subjects"). Lead with the words
  // people actually searched. The brand suffix is kept only when it still fits in 60
  // chars: at a 0.2-1.2% CTR the keyword is worth more than the brand.
  const compact = String(examName).replace(/\s*\([^)]*\)\s*/g, ' ').replace(/\s{2,}/g, ' ').trim() || examName;
  const TAILS = [
    ': Syllabus, Exam Pattern & Eligibility',
    ': Syllabus, Pattern & Eligibility',
    ': Syllabus & Exam Pattern',
    ': Exam Pattern & Eligibility',
    ': Syllabus & Eligibility',
  ];
  for (const tail of TAILS) {
    for (const name of [examName, compact]) {
      const bare = `${name} ${currentYear}${tail}`;
      if (`${bare}${BRAND_SUFFIX}`.length <= 60) return `${bare}${BRAND_SUFFIX}`;
      if (bare.length <= 60) return bare;
    }
  }
  // Exam name too long for any keyword tail: hard-trim the compact label, never "...".
  const room = Math.max(12, 60 - ': Syllabus & Pattern'.length);
  const cut = `${compact} ${currentYear}`.slice(0, room).replace(/\s+\S*$/, '').trim() || compact.slice(0, room).trim();
  return `${cut}: Syllabus & Pattern`;
})();
// Unique, data-driven meta description. A single templated sentence repeated across 125+
// exam pages gives Google nothing to differentiate them in the SERP and wastes the CTR
// value of the real pattern/eligibility facts already sitting in the data files. Lead with
// this exam's own numbers; only fall back to boilerplate when the data file is empty.
const description = (() => {
  const squash = (s: string) => s.replace(/\s+/g, ' ').trim();
  // First real sentence, ignoring periods inside decimals/abbreviations ("3.5 hours").
  const firstSentence = (s: string) => {
    const t = squash(s);
    const m = t.match(/^.{20,}?[.!?](?=\s|$)/);
    return (m ? m[0] : t).trim();
  };
  const pattern = exam.examPattern ? firstSentence(fullExamPattern) : '';
  const elig = exam.eligibility ? firstSentence(fullEligibility) : '';

  let base = pattern
    ? `${examName} ${currentYear}: ${pattern}`
    : (fullDescription ? `${examName} ${currentYear}: ${firstSentence(fullDescription)}` : '');

  // Some data sentences open by naming the exam themselves ("CUET UG is a computer-based
  // test…"), which would read as "CUET UG 2026: CUET UG is a…". Fold the year into that
  // existing mention instead of printing the name twice. Parenthetical parts of the name
  // ("CUCET (PG)") are treated as optional so they match the data's "CUCET PG" form.
  if (pattern) {
    const esc = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const parts: { opt: boolean; text: string }[] = [];
    const re = /\(([^)]*)\)|([^()]+)/g;
    let m: RegExpExecArray | null;
    while ((m = re.exec(examName)) !== null) {
      if (m[1] !== undefined) {
        const t = m[1].trim();
        if (t) parts.push({ opt: true, text: t });
      } else {
        const t = m[2].trim();
        if (t) parts.push({ opt: false, text: t });
      }
    }
    const nameRe = parts
      .map((p) => {
        const body = esc(p.text).replace(/\s+/g, '\\s+');
        return p.opt ? `(?:\\s*\\(?\\s*${body}\\s*\\)?)?` : body;
      })
      .join('\\s*');
    const coreRe = nameRe ? new RegExp(`^${nameRe}`, 'i') : null;
    if (coreRe && coreRe.test(pattern)) {
      base = pattern
        .replace(coreRe, () => `${examName} ${currentYear} `)
        .replace(/\s+/g, ' ')
        .trim();
    }
  }

  // CTR repair 2026-09-18 (see the title comment). The old description opened with a dense
  // spec sentence, which Google then cut mid-value in the SERP ("…Mathematics(150 marks,
  // 150…"). Put the searched words straight after the exam name so that even a truncated
  // snippet still reads as an answer, then let this exam's own numbers follow.
  const KW_LONG = 'syllabus, exam pattern, eligibility and key dates';
  const KW_SHORT = 'syllabus, exam pattern & eligibility';
  const namePrefix = `${examName} ${currentYear}`;
  // Long exam names leave no room for facts, so shorten the keyword clause rather than
  // shipping a description that is nothing but keywords.
  const KEYWORDS = `${namePrefix}: ${KW_LONG}.`.length <= 122 ? KW_LONG : KW_SHORT;
  if (base.startsWith(namePrefix)) {
    // Strip the name+year (with or without its colon) and re-lay it once, followed by the
    // searched words and then this exam's own facts. Both branches must behave the same:
    // an earlier version prepended to the de-duplicated form, which printed the exam name
    // twice and pushed the facts out of the 158-char window entirely.
    const rest = base.slice(namePrefix.length).replace(/^[:\s]+/, '');
    // A self-mention ("CUET UG is a computer-based test…") leaves the bare verb behind once
    // the name is lifted out. Restore the subject so the clause still reads as English.
    const restFixed = rest && /^[a-z]/.test(rest) ? `${examName} ${rest}` : rest;
    base = `${namePrefix}: ${KEYWORDS}.${restFixed ? ` ${restFixed}` : ''}`;
  }

  // Only append eligibility when the pattern line leaves room for it.
  if (base && elig && base.length < 105) base = `${base} Eligibility: ${elig}`;
  if (!base) base = `${examName} ${currentYear}: syllabus, exam pattern, eligibility and key dates. Free AI study roadmap built in minutes.`;

  // Fit the ~158-char SERP window. Prefer a real clause boundary to a mid-token cut, so a
  // snippet never ends inside a value like "150 marks, 150".
  const MAX = 158;
  if (base.length > MAX) {
    const cut = base.slice(0, MAX);
    let at = -1;
    for (const sep of ['. ', '; ', ' — ', ', ']) {
      const i = cut.lastIndexOf(sep);
      if (i > at) at = i;
    }
    const word = cut.lastIndexOf(' ');
    // Prefer a clause boundary, but only if it lands near the end of the window; otherwise the
    // snippet would show the keyword line and drop this exam's facts entirely. Falls back to
    // the word boundary, which is the fuller of the two.
    let stop = at >= MAX - 35 ? at : word;
    if (stop <= 0) stop = MAX;
    // Never end a snippet on a bare value ("…Chinese Language(150"); step back one word.
    for (let guard = 0; guard < 6 && stop > 0; guard++) {
      if (!/[\d)٪%]$/.test(cut.slice(0, stop).trimEnd())) break;
      const prev = cut.slice(0, stop).trimEnd().lastIndexOf(' ');
      if (prev <= 0) break;
      stop = prev;
    }
    base = `${cut.slice(0, stop).replace(/[\s,;:.\-—]+$/, '')}…`;
  }
  return base;
})();
const canonicalUrl = `${SITE_URL}/exams/${exam.examId}/`;

const authorObj = {
  name: "Pushkar Saini",
  jobTitle: "Founder & Editor",
  affiliation: "StudyRoadmap",
  url: "https://studyroadmap.in/author/pushkar-saini/",
};

// Conducting authority detection
const conductingBody = (() => {
  if (exam.officialSource) {
    try {
      const host = new URL(exam.officialSource).hostname.toLowerCase();
      if (host.includes('nta') || host.includes('samarth')) return 'National Testing Agency (NTA)';
      if (host.includes('upsc')) return 'Union Public Service Commission (UPSC)';
      if (host.includes('jamb')) return 'Joint Admissions and Matriculation Board (JAMB)';
      if (host.includes('waec')) return 'West African Examinations Council (WAEC)';
      if (host.includes('pmdc')) return 'Pakistan Medical & Dental Council (PMDC)';
      if (host.includes('iim')) return 'Indian Institutes of Management (IIM)';
      if (host.includes('iit')) return 'Indian Institute of Technology (IIT)';
      if (host.includes('cbse')) return 'Central Board of Secondary Education (CBSE)';
      if (host.includes('ets')) return 'Educational Testing Service (ETS)';
      return host.replace(/^www\./, '');
    } catch {
      // fallback
    }
  }
  return `${countryName} Examination Board`;
})();

// Exam mode detection
const examModeText = (() => {
  const p = (fullExamPattern || '').toLowerCase();
  if (p.includes('computer-based') || p.includes('computer based') || p.includes('cbt') || p.includes('online')) {
    return 'Computer-Based Test (CBT)';
  }
  if (p.includes('pen-paper') || p.includes('omr') || p.includes('offline') || p.includes('written')) {
    return 'Pen & Paper (OMR / Written)';
  }
  return 'Standard Examination';
})();

// Marking scheme detection
const markingSchemeText = (() => {
  const p = fullExamPattern || '';
  if (p.includes('+5') && p.includes('-1')) return '+5 correct, -1 wrong';
  if (p.includes('+4') && p.includes('-1')) return '+4 correct, -1 wrong';
  if (p.includes('+3') && p.includes('-1')) return '+3 correct, -1 wrong';
  if (p.includes('+1') && (p.includes('-0.25') || p.includes('- 0.25') || p.includes('0.25'))) return '+1 correct, -0.25 wrong';
  if (p.toLowerCase().includes('no negative') || p.toLowerCase().includes('without negative')) return 'No Negative Marking';
  if (p.toLowerCase().includes('negative')) return 'Negative Marking Applies';
  return 'Standard Marking';
})();

// Helper to extract structured phases from prepOverview
interface PrepPhase {
  number: number;
  label: string;
  headline: string;
  body: string;
}

const prepPhases: PrepPhase[] = (() => {
  if (!prepOverview) return [];
  const phases: PrepPhase[] = [];
  const regex = /(?:Phase\s*(\d+)|(Last\s*[\d–-]+\s*weeks?))\s*(?:\(([^)]+)\))?\s*[:—–-]\s*([^.]+?\.)\s*([\s\S]*?)(?=(?:Phase\s*\d+|Last\s*[\d–-]+\s*weeks?|$))/gi;
  let match;
  let idx = 1;
  while ((match = regex.exec(prepOverview)) !== null) {
    const phaseNum = match[1] ? parseInt(match[1], 10) : idx;
    const subtitle = match[3] ? ` · ${match[3]}` : '';
    const label = `${match[2] || `Phase ${phaseNum}`}${subtitle}`;
    const headline = match[4].trim();
    const body = match[5].trim();
    phases.push({
      number: phaseNum,
      label,
      headline,
      body,
    });
    idx++;
  }
  return phases;
})();

const goodNotesSet = new Set(allNotes.filter(isGoodNote).map(n => n.id));

function getTopicWeightInfo(w?: number) {
  if (w === 5) return { label: 'High Yield', icon: '🔥', badgeClass: 'bg-amber-100 text-amber-900 dark:bg-amber-950/60 dark:text-amber-300 border border-amber-300/80 dark:border-amber-700/80 font-bold' };
  if (w === 4) return { label: 'Core', icon: '⭐', badgeClass: 'bg-blue-100 text-blue-900 dark:bg-blue-950/60 dark:text-blue-300 border border-blue-300/80 dark:border-blue-700/80 font-semibold' };
  if (w === 3) return { label: 'Standard', icon: '📘', badgeClass: 'bg-surface-100 text-surface-800 dark:bg-surface-800 dark:text-surface-200 border border-surface-200 dark:border-surface-700 font-medium' };
  return { label: 'Foundation', icon: '📝', badgeClass: 'bg-surface-100 text-surface-700 dark:bg-surface-800 dark:text-surface-300 border border-surface-200 dark:border-surface-700' };
}


// Schemas
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Exams', item: `${SITE_URL}/exams/` },
    { '@type': 'ListItem', position: 3, name: examName, item: canonicalUrl },
  ],
};

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `How to Prepare for ${examName} in Record Time`,
  description: `A structured 3-step approach to cracking ${examName} using an AI-powered personalised study roadmap.`,
  step: [
    {
      '@type': 'HowToStep',
      name: 'Step 1 — Generate your personalised roadmap',
      text: `Select "${examName}" on StudyRoadmap, choose your available preparation time, and get an instant AI-generated study plan prioritised by topic weightage for ${examName}.`,
      url: `${SITE_URL}/roadmap/?exam=${exam.examId}`,
    },
    {
      '@type': 'HowToStep',
      name: 'Step 2 — Study topic by topic',
      text: `Follow your roadmap and open free study notes for each topic. Notes include concept explanations, key formulas, exam-level practice questions, and three depth tiers (Quick, Standard, Deep) based on your time.`,
      // All-bad-note hubs 404 — never emit a schema URL this page's own
      // visible "Browse Study Notes" gate already hides (GSC-visible 404s).
      url: examsWithNotes.has(exam.examId) ? `${SITE_URL}/notes/${exam.examId}/` : `${SITE_URL}/roadmap/?exam=${exam.examId}`,
    },
    {
      '@type': 'HowToStep',
      name: 'Step 3 — Track progress and revise',
      text: `Mark topics as completed in your roadmap. The AI roadmap adapts to your pace and ensures you cover all high-weightage topics before exam day.`,
      url: `${SITE_URL}/roadmap/?exam=${exam.examId}`,
    },
  ],
};

// Exam-specific FAQ — rich content from exam-faqs.ts, falls back to generic if not found
const examSpecificFAQs = EXAM_FAQS[exam.examId] || null;
const examFAQs = examSpecificFAQs || [
  {
    question: `What is ${examName} and who conducts it?`,
    answer: `${examName} is a competitive examination for students in ${countryName}. For detailed information on the conducting authority, eligibility criteria, and exam schedule, visit the official source or check the eligibility section below.`,
  },
  {
    question: `What is the exam pattern for ${examName}?`,
    answer: fullExamPattern
      || `The ${examName} exam consists of multiple-choice questions across subjects. The exact number of questions, marking scheme (+/-), and time duration vary by the latest official notification. Generate a free study roadmap to focus on the most frequently tested topics.`,
  },
  {
    question: `What are the eligibility criteria for ${examName}?`,
    answer: fullEligibility
      || `Eligibility for ${examName} typically requires the candidate to have passed the qualifying examination (Class 12 for undergraduate exams, bachelor's degree for postgraduate exams) with the required percentage. Specific age limits and subject requirements apply. Check the official notification for your category's exact requirements.`,
  },
  {
    question: `How can I create a study plan for ${examName}?`,
    answer: `Simply select "${examName}" on StudyRoadmap, enter the time you have available (from 1 hour to 2 years), and the AI will generate a personalised study roadmap prioritising topics by their exam weightage. Each topic links directly to free study notes. No signup required.`,
  },
  {
    question: `What subjects are covered in ${examName}?`,
    answer: exam.subjects && exam.subjects.length > 0
      ? `${examName} covers ${exam.subjects.map((s: any) => s.name).join(', ')}. Use the study roadmap to prioritise subjects based on your strengths and the exam's subject-wise weightage.`
      : `${examName} covers multiple subjects. Check the detailed syllabus and generate a free personalised roadmap to know which topics to focus on first.`,
  },
];

const faqJsonLd = examSpecificFAQs ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: examSpecificFAQs.map(f => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
} : null;

// Course schema for exam pages. Discontinued exams get none — a
// "Comprehensive X preparation course" Course object on a page whose banner
// says the exam is no longer conducted is contradictory markup (lsat).
const courseJsonLd = DISCONTINUED_EXAMS[exam.examId] ? null : {
  '@context': 'https://schema.org',
  '@type': 'Course',
  '@id': `${canonicalUrl}#course`,
  'name': `${examName} Study Roadmap`,
  'description': `Comprehensive ${examName} preparation course covering syllabus, exam pattern, eligibility, and topic-wise study plan.`,
  'provider': {
    '@type': 'Organization',
    'name': 'StudyRoadmap',
    'url': 'https://studyroadmap.in',
  },
  'educationalLevel': exam.educationalLevel || 'Higher Secondary',
  'inLanguage': 'en',
  'audience': {
    '@type': 'Audience',
    'audienceType': `Students preparing for ${examName} in ${countryName}`,
  },
  'educationalCredentialAwarded': {
    '@type': 'EducationalOccupationalCredential',
    'name': `${examName} Syllabus Preparation & Mastery`,
    'credentialCategory': 'Competitive Examination Preparation',
  },
  'offers': {
    '@type': 'Offer',
    'category': 'Free',
    'price': '0',
    'priceCurrency': 'INR',
    'availability': 'https://schema.org/InStock',
    'validFrom': exam.lastUpdated || CONTENT_REV,
    'url': `https://studyroadmap.in/exams/${exam.examId}/`,
  },
  'hasCourseInstance': {
    '@type': 'CourseInstance',
    'courseMode': 'Online',
    'courseWorkload': 'PT2H',
    'instructor': {
      '@type': 'Organization',
      'name': 'StudyRoadmap',
      'url': 'https://studyroadmap.in',
    },
  },
};

// Subject data for display. Counts exclude placeholder "Topic N" rows so the
// hub can't claim "45 topics" while its own filtered views render 0 (indexed
// hubs self-contradicted their syllabus spokes until 2026-07-04).
const subjectList = exam.subjects || [];
const realTopics = (s: any) => (s.topics || []).filter((t: any) => !isPlaceholderExamTopic(t));
const totalTopics = subjectList.reduce((acc: number, s: any) => acc + realTopics(s).length, 0);
const durations = Object.keys(exam.durations || {}).slice(0, 6);
// The syllabus spoke noindexes itself when majority-placeholder — don't
// follow-link it from this indexed hub (same never-link-noindex policy).
const { isPlaceholderSyllabus } = placeholderSyllabusStats(exam.subjects);
const spokeLinks = ['dates','eligibility','syllabus','pattern','strategy']
  .filter((s) => s !== 'syllabus' || !isPlaceholderSyllabus);

// Find related exams (same country, different exam) — never link to noindex
// (fabricated/discontinued) exams from an indexed page.
const relatedExams = ALL_EXAMS
  .filter(e => e && e.examId !== exam.examId && e.country === exam.country && !isNoindexExam(e.examId))
  .slice(0, 4);

// Exam pathway mappings — cross-links between logically related exams
const pathwayMap: Record<string, Array<{ examId: string; label: string; reason: string }>> = {
  // India
  'jeemain': [
    { examId: 'jeeadvanced', label: 'JEE Advanced', reason: 'for top-tier engineering colleges' },
    { examId: 'cuet', label: 'CUET', reason: 'shared physics & chemistry syllabus' },
  ],
  'jeeadvanced': [
    { examId: 'jeemain', label: 'JEE Main', reason: 'to qualify and attempt JEE Advanced' },
    { examId: 'bitsat', label: 'BITSAT', reason: 'alternate engineering entrance' },
  ],
  'neet': [
