---
/**
 * AdRouter — country-aware Monetag loader.
 *
 * Responsibilities (all client-side, all deferred off the critical path):
 *   1. Load the MultiTag zone on every ad-eligible page.
 *   2. Load the OnClick PopUnder zone at most once per visitor per 12 h.
 *   3. Refuse to load anything for declared crawlers (invalid-traffic guard).
 *   4. Resolve visitor country from Cloudflare's first-party /cdn-cgi/trace
 *      and combine it with the page's own country (derived from exam data) to
 *      decide which formats are acceptable.
 *   5. In EEA/UK/CH, load nothing until the visitor grants consent through the
 *      CMP (`window.__SR_CONSENT`). A *granted* decision now unlocks the full
 *      surface including the popunder — previously that format was withheld
 *      from every EU visitor, consenting or not, which cost revenue without
 *      buying compliance (the MultiTag still loaded). A *denied* decision
 *      loads nothing at all.
 *   6. Tag AI answer-engine referrals (a human who clicked a citation in
 *      ChatGPT/Perplexity/Copilot/Gemini/Claude) for attribution. AI *crawlers*
 *      are still refused in step 3 — only the referring human is monetized.
 *   7. Offer the push-notification surface (`/sw.js`, zone 11798846) as a
 *      reader-initiated opt-in — and only once the visitor has passed every gate
 *      above, because a push subscription is a marketing permission, not a page
 *      decoration. A crawler, an automation, an opt-out or an unconsented
 *      EEA/UK/CH visitor is never offered it, and nothing is registered for them.
 *
 *      Measured 2026-09-16 (`/data/push-late-register-probe.mjs`): Monetag's tag
 *      calls `Notification.requestPermission()` on page load with no user
 *      gesture, which Chromium suppresses into a quiet prompt and Firefox/Safari
 *      ignore outright — so the zone accumulated 1,502 prerequests and zero
 *      subscriptions. The fix is not the worker (an earlier note here claimed
 *      the tag's `sw=` parameter was worker-dependent; it is the tag's own bundle
 *      version and appears even when `/sw.js` 404s) but the gesture: the reader
 *      clicks, and the worker registration *and* the permission request both
 *      happen inside that click via `offerPush()`.
 *
 * Everything is observable at runtime through `window.__SR_AD`, which the
 * 30-minute review job and QA journeys assert against.
 */
import {
    MONETAG_TAG_SRC,
    MONETAG_MULTITAG_ZONE,
    MONETAG_MULTITAG_ENABLED,
    MONETAG_VIGNETTE_ZONE,
    MONETAG_VIGNETTE_TAG_SRC,
    MONETAG_VIGNETTE_ENABLED,
    MONETAG_DIRECTLINK_ZONE,
    MONETAG_DIRECTLINK_URL,
    MONETAG_DIRECTLINK_ENABLED,
    MONETAG_POPUNDER_ZONE,
    MONETAG_POPUNDER_DEDICATED_ENABLED,
    MONETAG_POPUNDER_TAG_SRC,
    MONETAG_PUSH_ZONE,
    MONETAG_PUSH_SW_PATH,
    MONETAG_PUSH_ENABLED,
    MONETAG_PUSH_TAG_SRC,
    MONETAG_PUSH_DISMISS_KEY,
    MONETAG_PUSH_OFFERED_KEY,
    MONETAG_PUSH_RELOADED_KEY,
    POPUNDER_COOLDOWN_MS,
    POPUNDER_SESSION_KEY,
    POPUNDER_STORAGE_KEY,
    VISITOR_GEO_STORAGE_KEY,
    CONSENT_RESTRICTED_GEOS,
    CRAWLER_UA_RE,
    AI_REFERRER_RE,
} from '../lib/ads';

interface Props {
    /** ISO-3166-1 alpha-2 country derived from the page's own content. */
    pageGeo?: string;
    /** Build-time kill switch (used by tests / preview builds). */
    enabled?: boolean;
    /** Allow the popunder format at all. */
    popunder?: boolean;
}

const { pageGeo = '', enabled = true, popunder = true } = Astro.props;

const config = {
    tag: MONETAG_TAG_SRC,
    multitag: MONETAG_MULTITAG_ZONE,
    multitagEnabled: MONETAG_MULTITAG_ENABLED,
    vignette: MONETAG_VIGNETTE_ZONE,
    vignetteTag: MONETAG_VIGNETTE_TAG_SRC,
    vignetteEnabled: MONETAG_VIGNETTE_ENABLED,
    directlink: MONETAG_DIRECTLINK_ZONE,
    directlinkUrl: MONETAG_DIRECTLINK_URL,
    directlinkEnabled: MONETAG_DIRECTLINK_ENABLED,
    pushZone: MONETAG_PUSH_ZONE,
    pushSw: MONETAG_PUSH_SW_PATH,
    pushTag: MONETAG_PUSH_TAG_SRC,
    pushEnabled: MONETAG_PUSH_ENABLED,
    pushDismissKey: MONETAG_PUSH_DISMISS_KEY,
    pushOfferedKey: MONETAG_PUSH_OFFERED_KEY,
    pushReloadKey: MONETAG_PUSH_RELOADED_KEY,
    popunder: MONETAG_POPUNDER_ZONE,
    popunderZoneEnabled: MONETAG_POPUNDER_DEDICATED_ENABLED,
    popunderTag: MONETAG_POPUNDER_TAG_SRC,
    cooldownMs: POPUNDER_COOLDOWN_MS,
    pubKey: POPUNDER_STORAGE_KEY,
    sessionKey: POPUNDER_SESSION_KEY,
    geoKey: VISITOR_GEO_STORAGE_KEY,
    pageGeo: String(pageGeo || '').toUpperCase(),
    restricted: CONSENT_RESTRICTED_GEOS,
    crawlerSrc: CRAWLER_UA_RE.source,
    crawlerFlags: CRAWLER_UA_RE.flags,
    aiRefSrc: AI_REFERRER_RE.source,
    aiRefFlags: AI_REFERRER_RE.flags,
    allowPopunder: Boolean(popunder),
};

const js = `
(function () {
    var cfg = ${JSON.stringify(config)};
    var d = document, w = window;
    var state = (w.__SR_AD = {
        reason: 'init',
        pageGeo: cfg.pageGeo || '',
        visitorGeo: '',
        consent: 'unknown',
        multitag: false,
        vignette: false,
        directlink: false,
        push: 'pending',
        pushScope: '',
        pushPermission: '',
        popunder: false,
        popunderSkipped: '',
        aiReferred: false,
        aiSource: '',
        refSource: 'none'
    });

    // ---- opt-outs (QA, operators, privacy-minded visitors) -----------------
    try {
        if (w.SR_ADS_OFF || w.localStorage.getItem('sr:ads:off') === '1') {
            state.reason = 'opt-out';
            return;
        }
    } catch (e) {}
    if (w.location.search.indexOf('noads=1') !== -1) {
        state.reason = 'opt-out';
        return;
    }

    // ---- invalid-traffic guard --------------------------------------------
    // Declared crawlers receive no ad loaders at all. See src/lib/ads.ts.
    // WebDriver automation is refused too: a headless browser that runs JS looks
    // like a human to the UA regex, but its impressions are worthless to the
    // buyer and suppressed-quality traffic is what drags a zone's CPM down.
    // Real users are unaffected - navigator.webdriver is only set under
    // WebDriver/CDP automation (Selenium, Puppeteer, Playwright).
    if (new RegExp(cfg.crawlerSrc, cfg.crawlerFlags).test(navigator.userAgent || '')) {
        state.reason = 'crawler';
        return;
    }
    if (navigator.webdriver === true) {
        state.reason = 'automation';
        return;
    }
    state.reason = 'eligible';

    // ---- AI answer-engine referral -----------------------------------------
    // AI *crawlers* were already rejected above, so anything reaching this line
    // with an AI referrer is a human who clicked a citation in ChatGPT,
    // Perplexity, Copilot, Gemini or Claude — high-intent traffic worth
    // attributing and, modestly, prioritising. The 12 h popunder cap and the
    // EEA/UK/CH consent rules below still apply unchanged.
    try {
        var ref = d.referrer || '';
        state.refSource = ref ? 'referral' : 'none';
        var aiMatch = ref ? new RegExp(cfg.aiRefSrc, cfg.aiRefFlags).exec(ref) : null;
        if (aiMatch) {
            state.aiReferred = true;
            state.aiSource = String(aiMatch[0])
                .toLowerCase()
                .replace(/^https?:\\/\\//, '')
                .replace(/[\\/?#].*$/, '');
            try { d.documentElement.setAttribute('data-sr-ai-ref', state.aiSource); } catch (e) {}
            try {
                w.dispatchEvent(new CustomEvent('sr:ai-referral', { detail: { source: state.aiSource } }));
            } catch (e) {}
        }
    } catch (e) {}

    function idle(fn, ms) {
        if ('requestIdleCallback' in w) {
            w.requestIdleCallback(fn, { timeout: ms });
        } else {
            setTimeout(fn, ms);
        }
    }

    // MultiTag container loader. Retained, but config.multitagEnabled is false:
    // the container bundled a second uncapped popunder plus In-Page Push at a
    // $0.0099 eCPM, so it is off by operator decision (2026-09-17). Kept because
    // re-enabling it is a one-constant change if the push leg is ever judged
    // worth the dilution.
    function load(id, zone) {
        if (d.getElementById(id)) return;
        var s = d.createElement('script');
        s.id = id;
        s.src = cfg.tag;
        s.async = true;
        s.setAttribute('data-zone', String(zone));
        s.setAttribute('data-cfasync', 'false');
        d.head.appendChild(s);
    }

    // Standalone-zone loader.
    //
    // A zone created on its own in the Monetag dashboard does NOT live on the
    // shared quge5.com host: its "Get tag" snippet names its own host and sets
    // the zone on the element. Loading the MultiTag host with data-zone=11805678
    // (what this code used to do) resolved the zone against 6opo.com and got a
    // 404, so the popunder could never serve. This mirrors the official snippet
    // exactly: element.dataset.zone + the zone's own src, appended after body.
    function loadStandalone(id, zone, src) {
        if (d.getElementById(id)) return;
        var s = d.createElement('script');
        s.id = id;
        s.dataset.zone = String(zone);
        s.src = src;
        s.async = true;
        s.setAttribute('data-cfasync', 'false');
        var parent = d.body || d.documentElement;
        if (parent) parent.appendChild(s);
        else d.head.appendChild(s);
    }

    // ---- consent bridge ----------------------------------------------------
    // ConsentManager publishes the decision on window.__SR_CONSENT and emits
    // 'sr:consent'. Until it settles the value is 'unknown', which must NOT be
    // treated as permission in a restricted region.
    function consentInfo() {
        var c = w.__SR_CONSENT;
        return { state: (c && c.state) || 'unknown', ads: !!(c && c.ads) };
    }

    function geoRestricted() {
        return !!(state.visitorGeo && cfg.restricted.indexOf(state.visitorGeo) !== -1);
    }

    // ---- push-notification opt-in (zone 11798846) -------------------------
    //
    // What this zone needs, in order: a registered worker, a *granted*
    // notification permission, and Monetag's tag turning that permission into a
    // subscription. Measured on 2026-09-16:
    //
    //   * the tag calls Notification.requestPermission() on load with no user
    //     gesture. Chromium suppresses that into a quiet prompt
    //     (kGestureGatedNotificationMessage) and Firefox/Safari need the gesture
    //     outright, so nobody subscribes — 1,502 prerequests, 0 subscriptions.
    //   * the tag's sw= query parameter is its own bundle version and is
    //     present even when /sw.js 404s, so it is not a signal we can use.
    //
    // Hence: a reader-initiated opt-in. The worker registration and the
    // permission request both happen inside the click, which is what supplies
    // the gesture. Everything is gated behind startAds(), so a crawler, an
    // automation, an opt-out or an unconsented EEA/UK/CH visitor never sees the
    // control and never gets a worker registered on their behalf.
    var PUSH_ID = 'sr-push-optin';

    function pushSupported() {
        return !!(w.Notification && w.Notification.requestPermission &&
            navigator.serviceWorker && navigator.serviceWorker.register);
    }

    function pushDismissed() {
        try { return w.localStorage.getItem(cfg.pushDismissKey) === '1'; } catch (e) { return false; }
    }

    // The offer is a one-off per tab session. A reader who answers neither button
    // has not consented to being asked again on the next page — re-rendering it
    // on every page load is the nag pattern. Session scope keeps a return visit
    // eligible without turning browsing into a repeated prompt.
    function pushAlreadyOffered() {
        try { return w.sessionStorage.getItem(cfg.pushOfferedKey) === '1'; } catch (e) { return false; }
    }

    function markPushOffered() {
        try { w.sessionStorage.setItem(cfg.pushOfferedKey, '1'); } catch (e) {}
    }

    function removePushCard() {
        var el = d.getElementById(PUSH_ID);
        if (el && el.remove) el.remove();
    }


    // The tag reads permission when it loads, so after a grant we reload once
    // (per tab session) with the permission already in place. Without this the
    // granted permission sits unused until the reader happens to come back.
    function reloadOnceForPush() {
        try {
            if (w.sessionStorage.getItem(cfg.pushReloadKey) === '1') return;
            w.sessionStorage.setItem(cfg.pushReloadKey, '1');
        } catch (e) { return; }
        try { if (w.location && w.location.reload) w.location.reload(); } catch (e) {}
    }

    // The tag registers /sw.js itself, carrying the zone params it needs
    // (?v=…&p=11798846…), and re-registers on every load. We deliberately do not
    // also call serviceWorker.register(cfg.pushSw) with a bare URL: same scope,
    // different script URL, so it would fight the tag's registration instead of
    // helping it.
    function loadPushTag() {
        loadStandalone('sr-push-tag', cfg.pushZone, cfg.pushTag);
    }

    // Called from the click. The tag is injected here — inside the gesture —
    // because on its own it calls Notification.requestPermission() on load with
    // navigator.userActivation.isActive === false. Chrome suppresses an
    // ungestured request into the quiet prompt AND arms a prompt cooldown that
    // then eats the reader's next real request, so loading it on page load would
    // actively break the opt-in it is meant to serve.
    //
    // The permission request below is issued synchronously, which is the part
    // that reliably carries the activation; the tag rides along with it.
    function acceptPush(ev) {
        if (ev && ev.preventDefault) ev.preventDefault();
        removePushCard();
        loadPushTag();
        state.push = 'requesting';
        var asked;
        try {
            asked = w.Notification.requestPermission();
        } catch (e) {
            state.push = 'failed';
            return;
        }
        Promise.resolve(asked).then(function (res) {
            state.pushPermission = String(res || '');
            if (res === 'granted') {
                state.push = 'granted';
                reloadOnceForPush();
            } else if (res === 'denied') {
                // A denial is an answer. Never ask this browser again.
                try { w.localStorage.setItem(cfg.pushDismissKey, '1'); } catch (e) {}
                state.push = 'denied';
            } else {
                state.push = 'dismissed-prompt';
            }
        }).catch(function () { state.push = 'failed'; });
    }

    function dismissPush(ev) {
        if (ev && ev.preventDefault) ev.preventDefault();
        try { w.localStorage.setItem(cfg.pushDismissKey, '1'); } catch (e) {}
        removePushCard();
        state.push = 'dismissed';
    }

    function makePushButton(id, label, handler) {
        var b = d.createElement('button');
        b.type = 'button';
        b.textContent = label;
        if (b.setAttribute) b.setAttribute('data-sr-push', id);
        b.addEventListener('click', handler, { once: true });
        return b;
    }

    // The offer itself. Deliberately plain and honest: these notifications carry
    // Monetag's sponsored messages, so the copy says so. Describing them as
    // "exam reminders" would be the misleading-prompt pattern that Chrome's
    // abusive-notification enforcement and the ad-network policies both act on.
    function offerPush() {
        if (!cfg.pushEnabled) { state.push = 'disabled'; return; }
        if (!pushSupported()) { state.push = 'unsupported'; return; }
        if (pushDismissed()) { state.push = 'dismissed'; return; }
        if (pushAlreadyOffered()) { state.push = 'offered-once'; return; }
        if (state.push === 'offered' || d.getElementById(PUSH_ID)) {
            state.push = 'offered';
            return;
        }
        if (!d.body) { state.push = 'offered'; return; }

        var card = d.createElement('div');
        card.id = PUSH_ID;
        card.setAttribute('role', 'region');
        card.setAttribute('aria-label', 'Notification settings');
        card.style.cssText = 'position:fixed;left:12px;right:12px;bottom:12px;z-index:40;' +
            'max-width:420px;margin:0 auto;padding:12px 14px;border-radius:12px;' +
            'background:#fff;color:#111;box-shadow:0 8px 24px rgba(0,0,0,.18);' +
            'border:1px solid rgba(0,0,0,.08);font:14px/1.45 system-ui,sans-serif';

        var text = d.createElement('p');
        text.textContent = 'Get exam updates and sponsored alerts from StudyRoadmap. ' +
            'You can turn them off any time in your browser settings.';
        text.style.cssText = 'margin:0 0 10px';

        var row = d.createElement('div');
        row.style.cssText = 'display:flex;gap:8px;flex-wrap:wrap';
        row.appendChild(makePushButton('accept', 'Turn on notifications', acceptPush));
        row.appendChild(makePushButton('dismiss', 'Not now', dismissPush));

        card.appendChild(text);
        card.appendChild(row);
        d.body.appendChild(card);
        markPushOffered();
        state.push = 'offered';
    }

    // Entry point from startAds(). A returning subscriber already granted
    // permission: re-register the worker so delivery keeps working, and do not
    // ask again. Everyone else gets the offer.
    function startPush() {
        if (!cfg.pushEnabled) { state.push = 'disabled'; return; }
        if (!pushSupported()) { state.push = 'unsupported'; return; }
        var perm = '';
        try { perm = String(w.Notification.permission || ''); } catch (e) {}
        state.pushPermission = perm;
        if (perm === 'granted') {
            // Already granted, so no prompt can appear and no cooldown can be
            // armed: loading the tag here is safe and is what re-subscribes a
            // returning reader.
            loadPushTag();
            state.push = 'registered';
            return;
        }
        if (perm === 'denied') {
            // Already refused at browser level; an offer would be dead UI.
            state.push = 'denied';
            return;
        }
        offerPush();
    }

    var started = false;

    // ---- 1. Ad tags: every ad-eligible page, subject to consent ----------
    function startAds() {
        if (started) return;
        started = true;
        state.reason = 'eligible';
        idle(function () {
            // Container 280401 is OFF. Its four members were not equally worth
            // their requests, and it fired a second uncapped popunder on load.
            if (cfg.multitagEnabled) {
                load('sr-monetag', cfg.multitag);
                state.multitag = true;
            }
            // Standalone vignette 11799057 replaces the container's 11798845.
            // Note the different host: n6wxm.com, not the shared quge5.com one.
            if (cfg.vignetteEnabled) {
                loadStandalone('sr-vignette', cfg.vignette, cfg.vignetteTag);
                state.vignette = true;
            }
            startPush();
        }, 3500);
        decidePopunder();
        // The direct link is a user-initiated click on the footer anchor rendered
        // by Footer.astro; there is nothing to auto-load here. Recorded so the
        // 30-minute review can assert the surface exists without opening it.
        state.directlink = !!(cfg.directlinkEnabled && d.querySelector('[data-sr-directlink]'));
    }

    function gate() {
        var ci = consentInfo();
        state.consent = ci.state;

        if (!state.visitorGeo) {
            // Country unknown. Only an explicit grant is enough to proceed;
            // otherwise stay pending rather than assume the visitor is outside
            // the EEA (failing open here would be an unconsented load).
            if (ci.state === 'granted' && ci.ads) return startAds();
            state.reason = 'consent-pending';
            return;
        }
        if (!geoRestricted()) return startAds();
        if (ci.state === 'granted' && ci.ads) return startAds();
        if (ci.state === 'denied') {
            state.reason = 'consent-denied';
            return;
        }
        state.reason = 'consent-pending';
    }

    try { w.addEventListener('sr:consent', gate, { passive: true }); } catch (e) {}

    // ---- 2. visitor country (first-party CDN trace, session-cached) -------
    function applyGeo(cc) {
        cc = (cc || '').toUpperCase();
        if (!/^[A-Z]{2}$/.test(cc)) { gate(); return; }
        state.visitorGeo = cc;
        try { d.documentElement.setAttribute('data-sr-visitor-geo', cc); } catch (e) {}
        try {
            w.dispatchEvent(new CustomEvent('sr:geo', { detail: { visitor: cc, page: state.pageGeo } }));
        } catch (e) {}
        gate();
    }

    try {
        var cachedGeo = w.sessionStorage.getItem(cfg.geoKey);
        if (cachedGeo) applyGeo(cachedGeo);
    } catch (e) {}

    if (!state.visitorGeo && w.fetch) {
        w.fetch('/cdn-cgi/trace', { credentials: 'omit' })
            .then(function (r) { return r.text(); })
            .then(function (t) {
                if (state.visitorGeo) return;
                var m = /(?:^|\\n)loc=([A-Za-z]{2})/.exec(t);
                var cc = m ? m[1].toUpperCase() : '';
                if (cc) {
                    try { w.sessionStorage.setItem(cfg.geoKey, cc); } catch (e) {}
                }
                applyGeo(cc);
            })
            .catch(function () { gate(); });
    } else if (!state.visitorGeo) {
        gate();
    }

    // ---- 3. PopUnder: 1 per session, 12 h cross-session floor, interactions first ----
    var popTimer = null;

    function lastPopunder() {
        try { return parseInt(w.localStorage.getItem(cfg.pubKey) || '0', 10) || 0; } catch (e) { return 0; }
    }
    // One popunder per tab session is the UX rule; the 12 h floor (cfg.cooldownMs)
    // is the cross-session backstop. Both must pass.
    function sessionHadPopunder() {
        try { return w.sessionStorage.getItem(cfg.sessionKey) === '1'; } catch (e) { return false; }
    }
    function markPopunder() {
        try { w.localStorage.setItem(cfg.pubKey, String(Date.now())); } catch (e) {}
        try { w.sessionStorage.setItem(cfg.sessionKey, '1'); } catch (e) {}
    }

    function decidePopunder() {
        if (state.popunder || state.popunderSkipped === 'loaded') return;
        if (!cfg.allowPopunder) { state.popunderSkipped = 'disabled'; return; }
        if (!cfg.popunderZoneEnabled) { state.popunderSkipped = 'zone-not-serving'; return; }
        if (sessionHadPopunder()) { state.popunderSkipped = 'session-cap'; return; }
        if (geoRestricted() && !(consentInfo().state === 'granted' && consentInfo().ads)) {
            // EEA/UK/CH without a granted decision: no intrusive format.
            state.popunderSkipped = 'consent-region';
            return;
        }
        state.popunderSkipped = '';
        if (popTimer) return;
        // Fire on the first real interaction; fall back to a SHORT idle timer so
        // the clickunder is bound before a user clicks without hurting CWV.
        // MEASURED 2026-09-23 (sprint 87, ready/s87-popunder-arming-probe.mjs):
        // with a 12 000 ms fallback a session that leaves before 12 s is never
        // served the popunder we already allow it - the tag is not even injected.
        // Measured against the live site: armed at 12 383 ms idle, 2 162 ms after
        // a scroll, and NEVER in a session that left at 5 s.
        // 3 500 ms is the delay this file already trusts for the vignette
        // (idle(fn, 3500) in startAds), which loaded at 874 ms in those same runs.
        // The caps are UNCHANGED: one popunder per session, 12 h floor intact.
        // AI-referred readers are high-intent and get a shorter fallback.
        var fire = function () { arm(); };
        var opts = { once: true, passive: true };
        d.addEventListener('scroll', fire, opts);
        d.addEventListener('click', fire, opts);
        d.addEventListener('touchstart', fire, opts);
        d.addEventListener('keydown', fire, opts);
        popTimer = setTimeout(fire, state.aiReferred ? 2000 : 3500);
    }

    function arm() {
        if (popTimer) { clearTimeout(popTimer); popTimer = null; }
        if (state.popunder) return;
        if (!cfg.popunderZoneEnabled) { state.popunderSkipped = 'zone-not-serving'; return; }
        if (sessionHadPopunder()) { state.popunderSkipped = 'session-cap'; return; }
        var elapsed = Date.now() - lastPopunder();
        if (elapsed < cfg.cooldownMs) {
            state.popunderSkipped = 'cooldown';
            return;
        }
        loadStandalone('sr-monetag-popunder', cfg.popunder, cfg.popunderTag);
        markPopunder();
        state.popunder = true;
        state.popunderSkipped = '';
    }

    gate();
})();
`;

---

{
    enabled && (
        <script is:inline set:html={js} />
    )
}
