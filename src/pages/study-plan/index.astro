---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { ALL_EXAMS, getCountryFlag } from '../../data/exams';
import { isNoindexExam } from '../../data/suppressed-exams';
import { isGoodNote } from '../../data/note-quality';

import { SITE_URL } from '@data/site';
const canonicalUrl = `${SITE_URL}/study-plan/`;
const currentYear = new Date().getUTCFullYear();

const examsWithNotes = new Set(
  (await getCollection('notes'))
    .filter(isGoodNote)
    .map((n) => n.id.split('/')[0])
    .filter(Boolean),
);

const plans = ALL_EXAMS
  .filter((e: any) => e && e.examId && !isNoindexExam(e.examId) && e.durations && Object.keys(e.durations).length > 0)
  .map((e: any) => ({
    examId: e.examId,
    name: e.examName || e.examId,
    flag: getCountryFlag(e.country) || '🌍',
    durations: Object.keys(e.durations || {}),
    hasNotes: examsWithNotes.has(e.examId),
  }))
  .sort((a, b) => a.name.localeCompare(b.name));

const totalPlans = plans.reduce((acc, p) => acc + p.durations.length, 0);

const title = `Free Study Plans ${currentYear}: ${plans.length}+ Exams, ${totalPlans}+ Roadmaps | StudyRoadmap™`;
const description = `Browse ${totalPlans}+ free, AI-curated study plans across ${plans.length}+ competitive exams (NEET, JEE, UPSC, SSC, MDCAT, JAMB & more). Pick your exam and duration — no signup needed.`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Study Plans', item: canonicalUrl },
  ],
};
---

<Layout title={title} description={description} canonical={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)}></script>
  <Navbar />
  <main id="main-content" class="flex-1">
    <section class="bg-surface-50 dark:bg-surface-950 border-b border-surface-200 dark:border-surface-800">
      <div class="container-page py-14 text-center">
        <h1 class="heading-1 text-surface-900 dark:text-surface-50">Free Study Plans for Every Exam</h1>
        <p class="mt-3 text-surface-600 dark:text-surface-400 max-w-2xl mx-auto">
          {totalPlans}+ ready-made roadmaps across {plans.length}+ competitive exams. Choose your exam and a duration that fits your timeline.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 justify-center">
          <a href="/study-plan-generator/" class="inline-block px-5 py-2.5 rounded-lg bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium">
            Build a custom plan →
          </a>
          <a href="/notes/" class="inline-block px-5 py-2.5 rounded-lg border border-surface-300 dark:border-surface-600 text-surface-800 dark:text-surface-100 text-sm font-medium hover:border-brand-400">
            Browse topic notes →
          </a>
        </div>
      </div>
    </section>
    <section class="container-page py-12">
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {plans.map(p => (
          <li class="card p-5">
            <div class="flex items-center gap-2 mb-3">
              <span aria-hidden="true">{p.flag}</span>
              <h2 class="text-base font-semibold text-surface-900 dark:text-surface-100">
                <a href={`/study-plan/${p.examId}/`} class="hover:text-brand-600 dark:hover:text-brand-400">{p.name}</a>
              </h2>
            </div>
            <ul class="flex flex-wrap gap-2">
              {p.durations.map(d => (
                <li>
                  <a href={`/study-plan/${p.examId}/${d}/`}
                     class="inline-block px-2.5 py-1 rounded-md text-xs bg-surface-100 dark:bg-surface-800 text-surface-700 dark:text-surface-300 hover:bg-brand-50 hover:text-brand-700 dark:hover:bg-surface-700">
                    {d}
                  </a>
                </li>
              ))}
            </ul>
            <div class="mt-3 flex flex-wrap gap-3 text-xs">
              <a href={`/study-plan/${p.examId}/`} class="text-brand-600 dark:text-brand-400 hover:underline">All plans</a>
              {p.hasNotes && (
                <a href={`/notes/${p.examId}/`} class="text-brand-600 dark:text-brand-400 hover:underline">Notes</a>
              )}
              <a href={`/exams/${p.examId}/`} class="text-surface-500 hover:underline">Exam guide</a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
