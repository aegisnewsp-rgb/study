---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { isGoodNote } from '@data/note-quality';
import { EXAM_EQUIVALENTS } from '@data/exam-equivalents';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  const exams = [...new Set(allNotes.map(n => n.id.split('/')[0]))];
  return exams.map(exam => ({
    params: { exam },
    props: { exam },
  }));
}

const { exam } = Astro.props;
const allNotes = await getCollection('notes');
const allExamNotes = allNotes.filter(n => n.id.startsWith(exam + '/'));
// Group/list only indexable notes; if the whole exam is still low-value, noindex
// the hub until the rewrite pipeline restores enough quality topics.
const examNotes = allExamNotes.filter(isGoodNote);
const examHubRobots = examNotes.length === 0 ? 'noindex,follow' : undefined;

const firstNote = allExamNotes[0];
const examName = firstNote?.data.examName || exam;
const flag = { india: '🇮🇳', pakistan: '🇵🇰', nigeria: '🇳🇬' }[firstNote?.data.country] || '🌍';

// Only link equivalents that actually have a notes hub — others 404. Build the
// set of exams that have notes from the loaded collection and filter against it.
const examsWithNotes = new Set(allNotes.map(n => n.id.split('/')[0]));
const relatedExams = (EXAM_EQUIVALENTS[exam] || []).filter(r => examsWithNotes.has(r.id));


// Group by subject — use the directory slug from note.id (which IS the route),
// not note.data.subject (which can drift from the directory and 404s links).
// e.g. file sbi-po/general-awareness/genera-006.md has data.subject="awareness"
// but the rendered route is /notes/sbi-po/general-awareness/genera-006/
const bySubject: Record<string, typeof examNotes> = {}; // eslint-disable-line @typescript-eslint/no-explicit-any
for (const note of examNotes) {
  const subject = note.id.split('/')[1];
  if (!bySubject[subject]) bySubject[subject] = [];
  bySubject[subject].push(note);
}

const title = `${examName} Study Notes — All Subjects | StudyRoadmap™`;
const description = `Free ${examName} study notes for all subjects. ${examNotes.length} topics — Physics, Chemistry, Biology, and more. No signup required.`;
const canonicalUrl = `https://studyroadmap.in/notes/${exam}/`;
const siteUrl = 'https://studyroadmap.in';
const authorObj = { name: "StudyRoadmap Editorial Team", jobTitle: "Curriculum Editors", affiliation: "StudyRoadmap", url: "https://studyroadmap.in/about/" };
// Only 20 of 125+ exams have custom OG images — fall back to default for rest
const EXAM_OG_IMAGES = ['cat','clat','cuet','ecat','hat-ug','jamb','jeeadvanced','jeemain','lat','mdcat','nabteb','nat-i','ncee','nda','neco','neet','ssc-cgl','ugc-net','upsc','waec'];
const ogImage = EXAM_OG_IMAGES.includes(exam) ? `/og-notes/exam-${exam}.jpg` : '/og-image.jpg';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Notes', item: `${siteUrl}/notes/` },
    { '@type': 'ListItem', position: 3, name: examName, item: canonicalUrl },
  ],
};

const collectionPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${examName} Study Notes — All Subjects`,
  description: description,
  url: canonicalUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: Object.entries(bySubject).map(([subjectId, notes], i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${siteUrl}/notes/${exam}/${subjectId}/`,
      name: notes[0]?.data.subjectName || subjectId,
      numberOfItems: notes.length,
    })),
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `How do I use these ${examName} study notes effectively?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Start with the roadmap generator to get a personalised study plan, then use the notes to cover each topic systematically. Focus on high-weightage topics first, and use the Quick tier for rapid revision before exams.`,
      },
    },
    {
      '@type': 'Question',
      name: `What's the difference between Quick, Standard, and Deep study notes?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Quick notes provide concise bullet-point summaries ideal for last-minute revision. Standard notes include key concepts, formulas, and examples for regular study. Deep notes offer comprehensive explanations with diagrams and practice questions for thorough understanding.`,
      },
    },
    {
      '@type': 'Question',
      name: `Are these ${examName} notes aligned with the official syllabus?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Yes. All notes are organised by subject and topic to match the latest official ${examName} syllabus. Each topic also shows its weightage percentage to help you prioritise.`,
      },
    },
    {
      '@type': 'Question',
      name: `Can I access ${examName} study notes on my phone?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Absolutely. All notes are fully responsive and work on any device — desktop, tablet, or mobile. No app download or signup is required; just open the page and start studying.`,
      },
    },
    {
      '@type': 'Question',
      name: `Are these ${examName} notes really free?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Yes. Every note on StudyRoadmap is completely free to access — no paywall, no signup, no limits. We believe quality education resources should be available to everyone.`,
      },
    },
  ],
};
---

<Layout title={title} description={description} canonical={canonicalUrl} image={ogImage} author={authorObj} robots={examHubRobots}>
  <style is:global>
    :root {
      --color-brand-50:  #ecf2ee; --color-brand-100: #d4e2d8; --color-brand-200: #a9c4b1;
      --color-brand-300: #7ea689; --color-brand-400: #4d7e5d; --color-brand-500: #2a5a3e;
      --color-brand-600: #1a3a2e; --color-brand-700: #143025; --color-brand-800: #0e241c;
      --color-brand-900: #081813; --color-brand-950: #040c0a;
      --color-surface-50:  #f5f1e8; --color-surface-100: #ebe5d4; --color-surface-200: #ddd4bd;
      --color-surface-300: #c8bda1; --color-surface-400: #a89d80; --color-surface-500: #6b6354;
      --color-surface-600: #4a4438; --color-surface-700: #353027; --color-surface-800: #24201a;
      --color-surface-900: #18150f; --color-surface-950: #0c0a07;
    }
    html, body { background: #f0eee9; color: #2a251f; }
    .dark html, .dark body { background: #18150f; color: #f5f1e8; }
    .sr-trust-h1 { font-family: ui-serif, Georgia, "Times New Roman", serif; font-weight: 600; letter-spacing: -0.02em; }
    .sr-trust-pulse { background: #b08d3c !important; }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <Navbar />
  <main id="main-content" class="flex-1">
    <section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-surface-50 dark:from-brand-950/30 dark:via-surface-950 dark:to-surface-900 border-b border-surface-200 dark:border-surface-800">
      <div aria-hidden="true" class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-brand-500/10 dark:bg-brand-400/10 blur-3xl pointer-events-none"></div>
      <div class="container-page py-12 relative">
        <nav class="flex items-center gap-2 text-sm text-surface-500 mb-5" aria-label="Breadcrumb">
          <a href="/" class="hover:text-brand-600">Home</a>
          <span class="text-surface-300 dark:text-surface-700">/</span>
          <a href="/exams/" class="hover:text-brand-600">Exams</a>
          <span class="text-surface-300 dark:text-surface-700">/</span>
          <a href={`/exams/${exam}/`} class="hover:text-brand-600">{flag} {examName}</a>
          <span class="text-surface-300 dark:text-surface-700">/</span>
          <span class="text-surface-900 dark:text-surface-100 font-medium">Notes</span>
        </nav>

        <div class="inline-flex items-center gap-2 bg-brand-100/60 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 text-xs font-semibold px-3 py-1.5 rounded-full mb-4 border border-brand-200/60 dark:border-brand-800/50">
          <span class="sr-trust-pulse w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
          {examNotes.length} topics · {Object.keys(bySubject).length} subjects · No signup
        </div>

        <h1 class="sr-trust-h1 text-4xl md:text-5xl lg:text-6xl text-surface-900 dark:text-white mb-3 leading-[1.05]">
          <span class="text-brand-600 dark:text-brand-300">{examName}</span>
          <span class="block text-xl md:text-2xl font-normal italic text-surface-600 dark:text-surface-300 mt-2">Study Notes</span>
        </h1>
        <p class="text-lg text-surface-600 dark:text-surface-300 max-w-2xl mb-6 leading-relaxed">
          Concept-first notes for every topic — written for fast revision. Organised by subject, weight-tagged, completely free.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href={`/roadmap/?exam=${exam}`} class="group inline-flex items-center gap-2 bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-700 hover:to-brand-600 text-white font-bold px-6 py-3 rounded-xl transition-all shadow-lg shadow-brand-500/20 hover:shadow-xl hover:shadow-brand-500/30">
            Generate {examName} Roadmap
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          <a href={`/exams/${exam}/`} class="inline-flex items-center gap-2 bg-white dark:bg-surface-800 text-surface-700 dark:text-surface-200 font-semibold px-6 py-3 rounded-xl transition-colors border border-surface-200 dark:border-surface-700 hover:border-brand-300 dark:hover:border-brand-700">
            ← {examName} Overview
          </a>
        </div>
      </div>
    </section>

    <section class="container-page py-12 space-y-10">
      {Object.entries(bySubject).map(([subject, notes]) => (
        <div>
          <div class="flex items-center justify-between mb-4">
            <h2 class="heading-3 text-surface-800 dark:text-surface-100">
              {notes[0].data.subjectName}
            </h2>
            <a href={`/notes/${exam}/${subject}/`} class="text-sm text-brand-600 dark:text-brand-400 hover:underline">
              View all {notes.length} →
            </a>
          </div>
          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {notes.sort((a,b) => a.data.topic.localeCompare(b.data.topic)).slice(0, 6).map(note => (
              <a
                href={`/notes/${note.id}/`}
                class="group block bg-surface-50 dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-lg p-4 hover:border-brand-300 dark:hover:border-brand-700 transition-all"
              >
                <div class="flex items-center justify-between mb-1">
                  <span class="text-xs font-mono text-surface-400">{note.data.topic}</span>
                  <span class="text-xs text-brand-600 dark:text-brand-400">{note.data.weight}%</span>
                </div>
                <p class="text-sm font-medium text-surface-800 dark:text-surface-200 group-hover:text-brand-600 dark:group-hover:text-brand-400">
                  {note.data.topicName}
                </p>
              </a>
            ))}
          </div>
          {notes.length > 6 && (
            <a href={`/notes/${exam}/${subject}/`} class="text-sm text-brand-600 dark:text-brand-400 hover:underline mt-2 inline-block">
              + {notes.length - 6} more {notes[0].data.subjectName} topics →
            </a>
          )}
        </div>
      ))}
    {relatedExams.length > 0 && (
      <section class="border-t border-surface-200 dark:border-surface-700 pt-10 mt-10">
        <h2 class="heading-3 text-surface-800 dark:text-surface-100 mb-4">🌍 Related Exams in Other Countries</h2>
        <p class="text-surface-600 dark:text-surface-400 text-sm mb-5">
          Similar exams accepted for admissions in {examName}'s equivalent programs abroad.
        </p>
        <div class="flex flex-wrap gap-3">
          {relatedExams.map(rel => (
            <a href={`/notes/${rel.id}/`} class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-100 dark:bg-surface-800 border border-surface-200 dark:border-surface-700 hover:border-brand-300 dark:hover:border-brand-700 text-surface-700 dark:text-surface-300 text-sm transition-all">
              <span>{rel.flag}</span>
              <span>{rel.name}</span>
              <span class="text-surface-400">→</span>
            </a>
          ))}
        </div>
      </section>
    )}
    </section>
  </main>
  <Footer />
</Layout>
