---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';

const year = new Date().getUTCFullYear();

const FAQS = [
  {
    question: 'Can I crack JEE Main with only NCERT?',
    answer: 'NCERT forms the essential foundation but is insufficient for competitive scoring. Use NCERT to build conceptual understanding, then practice HC Verma for Physics, O.P. Tandon for Chemistry, and R.D. Sharma/Cengage for Maths. For the 2026 cycle, NTA increased application-based questions — NCERT alone typically yields 50–60 percentile; books with problem-solving depth push 85–95+. Source: jeemain.nta.nic.in',
  },
  {
    question: 'How many hours should a dropper study daily?',
    answer: '10–12 hours of structured study is optimal for JEE drop-year preparation. Break into 3–4 focused blocks of 2.5–3 hours each with short breaks. Quality matters more than quantity — 10 hours with full concentration beats 14 hours with distraction. Include 30-minute daily Class 11 revision as non-negotiable. Source: jeemain.nta.nic.in',
  },
  {
    question: 'Which books are most important for JEE Advanced?',
    answer: 'For Physics: HC Verma Vol. 1–2 + I.E. Irodov (selective). For Chemistry: O.P. Tandon (Physical + Organic), Morrison & Boyd (Organic), JD Lee (Inorganic). For Maths: Arihant series + past 15 years PYQs. Avoid collecting multiple books — master 1 primary reference per subject. Source: jeeadv.ac.in',
  },
  {
    question: 'Should I join a dropper coaching or study independently?',
    answer: 'Joining a structured dropper course (Allen, Resonance, Aakash) provides peer pressure, faculty guidance, and regular testing infrastructure. Self-study works only if you have strong self-discipline, can identify your gaps independently, and have access to doubt-clearing mechanisms. Most successful droppers combine self-study with weekend doubt sessions. Source: nta.ac.in',
  },
  {
    question: 'How do I handle Class 11 backlogs during a drop year?',
    answer: 'Integrate Class 11 revision into your daily routine rather than treating it as a separate project. Spend 30–45 minutes each morning reviewing Class 11 concepts while studying related Class 12 topics. Prioritize the 20% of Class 11 chapters that appear in 80% of questions: Vectors, Kinematics, Laws of Motion, Chemical Bonding, Mole Concept. Source: jeemain.nta.nic.in',
  },
  {
    question: 'What is the marking scheme for JEE Main?',
    answer: 'JEE Main uses +4 for correct answer, −1 for wrong attempt. The exam is computer-based with 90 questions (75 mandatory to attempt). Numerical-value questions in Maths now carry negative marking. Candidates must attempt at least 65–70 questions accurately to stay competitive at a 99+ percentile. Source: jeemain.nta.nic.in',
  },
  {
    question: 'How should I use PYQs in my preparation?',
    answer: 'Solve PYQs from the last 5 years (2021–2025) chapter-wise as you complete each topic, not after finishing the syllabus. This identifies patterns early and reveals frequently-tested concepts. After Week 15, solve full mock tests using only PYQ combinations to simulate exact exam difficulty. NTA repeats conceptual structures even when numbers change. Source: nta.ac.in',
  },
];

const PHASES = [
  {
    n: 1,
    title: 'Foundation Rebuild',
    weeks: 'Weeks 1–6',
    tone: 'amber',
    goal: 'Close Class 11 gaps, establish NCERT-level command over high-weightage Class 12 topics.',
    hours: '40–45 hrs/wk',
    focus: [
      { sub: 'Physics', items: 'Kinematics, Laws of Motion, Work-Energy, Rotational Motion → Electrostatics, Current Electricity, EMI' },
      { sub: 'Chemistry', items: 'Atomic Structure, Chemical Bonding, Periodic Trends → Chemical Kinetics, Electrochemistry, GOC + Hydrocarbons' },
      { sub: 'Maths', items: 'Quadratic Equations, Trigonometry, Probability → Functions, Limits, Continuity, Differentiation, Integration' },
    ],
    books: 'NCERT (both classes) · HC Verma · OP Tandon · RD Sharma',
  },
  {
    n: 2,
    title: 'JEE Main Level',
    weeks: 'Weeks 7–22',
    tone: 'orange',
    goal: 'Build JEE Main problem-solving speed. Integrate PYQs systematically. Rotate subjects daily.',
    hours: '60–70 hrs/wk',
    focus: [
      { sub: 'Physics', items: 'Fluids, Thermal, Wave & Modern Physics, AC circuits, Semiconductor' },
      { sub: 'Chemistry', items: 'p/d-Block, Coordination, Thermochemistry, Surface Chemistry, Polymers' },
      { sub: 'Maths', items: 'Vectors, 3D, Differential Equations, Complex Numbers, Conic Sections' },
    ],
    books: 'Coaching modules · DC Pandey · MS Chauhan · Cengage',
  },
  {
    n: 3,
    title: 'Advanced Prep + Mocks',
    weeks: 'Weeks 23–36',
    tone: 'red',
    goal: 'Full-syllabus mocks, error-log discipline, last-30-days revision & test simulation.',
    hours: '65–75 hrs/wk',
    focus: [
      { sub: 'Physics', items: 'Irodov selective + topic-wise Advanced tests' },
      { sub: 'Chemistry', items: 'Morrison & Boyd, JD Lee Inorganic, Advanced PYQs' },
      { sub: 'Maths', items: 'Arihant Advanced + 15-year PYQ analysis' },
    ],
    books: 'FIITJEE / Allen mock series · Advanced PYQs · Error log',
  },
];

const DAILY = [
  { time: '05:30–06:00', block: 'Wake + light warmup', pct: '' },
  { time: '06:00–06:45', block: 'Class 11 revision (non-negotiable)', pct: 'Foundation' },
  { time: '06:45–07:30', block: 'Breakfast + break', pct: '' },
  { time: '07:30–10:30', block: 'Deep-work Block 1 — Physics (new chapter)', pct: '3 hrs' },
  { time: '10:30–11:00', block: 'Short break', pct: '' },
  { time: '11:00–14:00', block: 'Deep-work Block 2 — Chemistry (new chapter)', pct: '3 hrs' },
  { time: '14:00–15:00', block: 'Lunch + nap', pct: '' },
  { time: '15:00–18:00', block: 'Deep-work Block 3 — Maths (new chapter)', pct: '3 hrs' },
  { time: '18:00–19:00', block: 'Exercise + break', pct: '' },
  { time: '19:00–21:00', block: 'PYQ drill (rotates subject daily)', pct: '2 hrs' },
  { time: '21:00–22:00', block: 'Error log + tomorrow-plan', pct: '1 hr' },
  { time: '22:00–22:30', block: 'Light revision + sleep', pct: '' },
];

const WEEKLY = [
  { day: 'Mon', focus: 'Physics deep day — new chapter + 30 PYQs' },
  { day: 'Tue', focus: 'Chemistry deep day — Organic/Inorganic rotation' },
  { day: 'Wed', focus: 'Maths deep day — Calculus + Algebra alternating' },
  { day: 'Thu', focus: 'Mixed: all 3 subjects + doubt-clearing session' },
  { day: 'Fri', focus: 'Mock test (3 hrs) + analysis (2 hrs)' },
  { day: 'Sat', focus: 'Weak-chapter blast (based on Fri mock errors)' },
  { day: 'Sun', focus: '6-hour cumulative revision + formula sheets' },
];

const RED_FLAGS = [
  { signal: 'PYQ accuracy < 40% after Week 10', meaning: 'Foundation not solid', action: 'Pause new topics; rebuild basics 2 weeks' },
  { signal: 'Mock scores plateau 4+ weeks', meaning: 'Wrong revision approach', action: 'Change question bank; add faculty review' },
  { signal: '8+ hours but low retention', meaning: 'Passive study', action: 'Switch to active problem-solving' },
  { signal: 'Cannot solve Class 11 problems', meaning: 'Concept debt growing', action: 'Mandatory 1-hr daily Class 11 session' },
  { signal: 'Burnout, sleep < 6 hrs', meaning: 'Physical warning', action: 'Sunday completely off; address sleep' },
];

const TONE: Record<string, { bg: string; border: string; text: string; badge: string; accent: string }> = {
  amber:  { bg: 'bg-amber-50 dark:bg-amber-900/20',  border: 'border-amber-200 dark:border-amber-800',   text: 'text-amber-800 dark:text-amber-200',   badge: 'bg-amber-500',  accent: 'text-amber-600 dark:text-amber-400' },
  orange: { bg: 'bg-orange-50 dark:bg-orange-900/20',border: 'border-orange-200 dark:border-orange-800', text: 'text-orange-800 dark:text-orange-200', badge: 'bg-orange-500', accent: 'text-orange-600 dark:text-orange-400' },
  red:    { bg: 'bg-red-50 dark:bg-red-900/20',      border: 'border-red-200 dark:border-red-800',       text: 'text-red-800 dark:text-red-200',       badge: 'bg-red-500',    accent: 'text-red-600 dark:text-red-400' },
};
---

<Layout
  title="JEE Main + Advanced 1-Year Dropper Roadmap | Free Day-by-Day Plan"
  description="A 36-week JEE dropper study plan: rebuild Class 11 basics, daily 10-12h schedule, backlog recovery, and mock ramp for JEE Main & Advanced. Free and no signup."
  image="/og-notes/exam-default.jpg"
  faqs={FAQS}
  pageType="article"
  publishedDate="2026-04-24"
  modifiedDate="2026-04-24"
  breadcrumbs={[
    { name: 'Home', url: 'https://studyroadmap.in/' },
    { name: 'Exams', url: 'https://studyroadmap.in/exams/' },
    { name: 'JEE Main', url: 'https://studyroadmap.in/exams/jeemain/' },
    { name: 'Dropper Roadmap', url: 'https://studyroadmap.in/exams/jeemain/dropper-roadmap/' },
  ]}
>
  <Navbar />

  <main class="min-h-screen bg-surface-50 dark:bg-surface-900">
    <!-- Hero -->
    <section class="relative overflow-hidden bg-gradient-to-br from-orange-600 via-red-600 to-pink-700 text-white py-20 px-4">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(255,255,255,0.15),transparent_50%)]"></div>
      <div class="relative max-w-4xl mx-auto text-center">
        <span class="inline-block px-4 py-1.5 bg-white/20 backdrop-blur rounded-full text-sm font-medium mb-6 border border-white/20">
          JEE Main + Advanced {year} · Dropper Strategy
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          1-Year JEE Dropper Roadmap
        </h1>
        <p class="text-lg md:text-xl text-orange-100 max-w-2xl mx-auto mb-4">
          For students starting the drop year from a <strong class="text-white">weak Class 11 base</strong> and an average board-level Class 12. Honest, phase-wise, and specific — no motivational fluff.
        </p>
        <p class="text-base text-orange-200 max-w-xl mx-auto mb-10">
          36 weeks · 3 phases · 10–12 study-hours/day · Sourced from NTA & JEE Advanced
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a href="/roadmap/?exam=jeemain"
             class="inline-flex items-center justify-center gap-2 bg-white text-orange-700 font-bold text-lg px-8 py-4 rounded-xl hover:bg-orange-50 transition-all shadow-lg hover:-translate-y-0.5">
            <svg aria-hidden="true" focusable="false" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            Generate My Personalised Plan — Free
          </a>
          <a href="#reality-check"
             class="inline-flex items-center justify-center gap-2 bg-white/10 backdrop-blur text-white font-semibold px-6 py-4 rounded-xl hover:bg-white/20 transition-all border border-white/30">
            Can I realistically crack it? ↓
          </a>
        </div>
      </div>
    </section>

    <!-- Reality check -->
    <section id="reality-check" class="py-16 px-4 bg-white dark:bg-surface-800">
      <div class="max-w-3xl mx-auto">
        <div class="inline-block text-xs font-bold tracking-wider uppercase text-orange-600 dark:text-orange-400 mb-3">Reality check</div>
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-surface-900 dark:text-white">
          Is 1-year dropper prep realistic from a weak base?
        </h2>
        <div class="space-y-4 text-lg text-surface-700 dark:text-surface-300 leading-relaxed">
          <p>
            <strong class="text-surface-900 dark:text-white">Yes — under one condition: ruthless prioritization and consistent 10–12 hour daily input.</strong>
            Students starting from average board-level understanding have cracked JEE Main with 98+ percentile and even cleared JEE Advanced after a dedicated drop year.
          </p>
          <p>
            The key is accepting that <em>Class 11 gaps cannot be fixed separately</em> — they must be patched concurrently while building Class 12 strength. Missing prerequisites will create bottlenecks in Mechanics, Electrostatics, and Organic Chemistry; these must be identified and remedied within <strong class="text-surface-900 dark:text-white">Weeks 1–6</strong>.
          </p>
          <p>
            Success is realistic if you treat every weak concept as urgent debt, not a future concern.
          </p>
        </div>

        <div class="mt-8 grid sm:grid-cols-3 gap-3">
          <div class="bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-green-700 dark:text-green-300">98+</div>
            <div class="text-xs text-green-800 dark:text-green-200">Main percentile achievable from weak base</div>
          </div>
          <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-blue-700 dark:text-blue-300">36</div>
            <div class="text-xs text-blue-800 dark:text-blue-200">Weeks of structured prep</div>
          </div>
          <div class="bg-orange-50 dark:bg-orange-900/20 border border-orange-200 dark:border-orange-800 rounded-xl p-4 text-center">
            <div class="text-2xl font-bold text-orange-700 dark:text-orange-300">10–12</div>
            <div class="text-xs text-orange-800 dark:text-orange-200">Focused study-hours/day</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Phases -->
    <section class="py-20 px-4 bg-surface-50 dark:bg-surface-900">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <div class="inline-block text-xs font-bold tracking-wider uppercase text-orange-600 dark:text-orange-400 mb-3">The 3-phase plan</div>
          <h2 class="text-3xl md:text-4xl font-bold text-surface-900 dark:text-white mb-4">36 Weeks, Broken Into Three Phases</h2>
          <p class="text-surface-600 dark:text-surface-400 max-w-2xl mx-auto">Each phase has a single dominant goal. Don't start the next one until the current goal is met.</p>
        </div>

        <div class="space-y-6">
          {PHASES.map((p) => {
            const c = TONE[p.tone];
            return (
              <div class={`${c.bg} ${c.border} border-2 rounded-3xl p-6 md:p-8`}>
                <div class="flex flex-wrap items-start gap-4 mb-6">
                  <div class={`${c.badge} text-white text-2xl font-bold w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0`}>
                    {p.n}
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class={`text-sm font-semibold ${c.accent} mb-1`}>{p.weeks} · {p.hours}</div>
                    <h3 class="text-2xl md:text-3xl font-bold text-surface-900 dark:text-white mb-2">Phase {p.n}: {p.title}</h3>
                    <p class={`${c.text} text-base md:text-lg`}>{p.goal}</p>
                  </div>
                </div>

                <div class="grid md:grid-cols-3 gap-4 mb-4">
                  {p.focus.map((f) => (
                    <div class="bg-white dark:bg-surface-800 rounded-xl p-4 border border-surface-200 dark:border-surface-700">
                      <div class={`text-sm font-bold ${c.accent} mb-2`}>{f.sub}</div>
                      <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed">{f.items}</p>
                    </div>
                  ))}
                </div>

                <div class="text-sm text-surface-600 dark:text-surface-400">
                  <strong class="text-surface-900 dark:text-white">Primary books:</strong> {p.books}
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- Daily schedule -->
    <section class="py-20 px-4 bg-white dark:bg-surface-800">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <div class="inline-block text-xs font-bold tracking-wider uppercase text-orange-600 dark:text-orange-400 mb-3">Daily rhythm</div>
          <h2 class="text-3xl md:text-4xl font-bold text-surface-900 dark:text-white mb-4">10–12 Hour Daily Schedule</h2>
          <p class="text-surface-600 dark:text-surface-400 max-w-xl mx-auto">Three 3-hour deep-work blocks, one PYQ block, one error-log block. Non-negotiable morning Class 11 revision.</p>
        </div>

        <div class="bg-surface-50 dark:bg-surface-900 rounded-2xl border border-surface-200 dark:border-surface-700 overflow-hidden">
          <table class="w-full text-sm">
            <thead class="bg-surface-100 dark:bg-surface-800">
              <tr>
                <th class="text-left px-4 py-3 font-semibold text-surface-900 dark:text-white w-32">Time</th>
                <th class="text-left px-4 py-3 font-semibold text-surface-900 dark:text-white">Block</th>
                <th class="text-left px-4 py-3 font-semibold text-surface-900 dark:text-white w-24">Duration</th>
              </tr>
            </thead>
            <tbody>
              {DAILY.map((d, i) => (
                <tr class={i % 2 === 0 ? 'bg-white dark:bg-surface-900' : 'bg-surface-50 dark:bg-surface-800/30'}>
                  <td class="px-4 py-3 font-mono text-xs text-surface-600 dark:text-surface-400 whitespace-nowrap">{d.time}</td>
                  <td class="px-4 py-3 text-surface-800 dark:text-surface-200">{d.block}</td>
                  <td class="px-4 py-3 text-xs text-surface-500 dark:text-surface-400">{d.pct}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Weekly -->
    <section class="py-20 px-4 bg-surface-50 dark:bg-surface-900">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <div class="inline-block text-xs font-bold tracking-wider uppercase text-orange-600 dark:text-orange-400 mb-3">Weekly rotation</div>
          <h2 class="text-3xl md:text-4xl font-bold text-surface-900 dark:text-white mb-4">Mon–Sun Subject Rotation</h2>
          <p class="text-surface-600 dark:text-surface-400 max-w-xl mx-auto">Friday = mock + analysis. Sunday = cumulative revision.</p>
        </div>

        <div class="grid sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-7 gap-3">
          {WEEKLY.map((w) => (
            <div class="bg-white dark:bg-surface-800 rounded-xl p-4 border border-surface-200 dark:border-surface-700 hover:border-orange-300 dark:hover:border-orange-700 transition-colors">
              <div class="text-xs font-bold uppercase tracking-wider text-orange-600 dark:text-orange-400 mb-2">{w.day}</div>
              <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed">{w.focus}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Core strategies -->
    <section class="py-20 px-4 bg-white dark:bg-surface-800">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12">
          <div class="inline-block text-xs font-bold tracking-wider uppercase text-orange-600 dark:text-orange-400 mb-3">Core methods</div>
          <h2 class="text-3xl md:text-4xl font-bold text-surface-900 dark:text-white mb-4">Backlog · Revision · Mocks</h2>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-gradient-to-br from-amber-50 to-orange-50 dark:from-amber-900/20 dark:to-orange-900/20 rounded-2xl p-6 border border-amber-200 dark:border-amber-800">
            <div class="w-12 h-12 bg-amber-500 rounded-xl flex items-center justify-center mb-4 text-white text-2xl">🔁</div>
            <h3 class="text-xl font-bold mb-3 text-surface-900 dark:text-white">Backlog recovery</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed mb-3">Integrate Class 11 revision into the morning 45-min slot — don't treat it as a separate project. Prioritise the 20% of chapters that appear in 80% of questions.</p>
            <ul class="text-xs text-surface-600 dark:text-surface-400 space-y-1">
              <li>• Vectors, Kinematics, Laws of Motion</li>
              <li>• Chemical Bonding, Mole Concept</li>
              <li>• Quadratics, Trigonometry, Functions</li>
            </ul>
          </div>

          <div class="bg-gradient-to-br from-blue-50 to-cyan-50 dark:from-blue-900/20 dark:to-cyan-900/20 rounded-2xl p-6 border border-blue-200 dark:border-blue-800">
            <div class="w-12 h-12 bg-blue-500 rounded-xl flex items-center justify-center mb-4 text-white text-2xl">🧠</div>
            <h3 class="text-xl font-bold mb-3 text-surface-900 dark:text-white">Revision strategy</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed mb-3">Spaced repetition beats re-reading. Revise each topic at intervals of 1, 3, 7, 21 days using active recall.</p>
            <ul class="text-xs text-surface-600 dark:text-surface-400 space-y-1">
              <li>• Formula sheets per chapter (hand-written)</li>
              <li>• Concept maps for inter-topic links</li>
              <li>• Sunday 6-hour cumulative drill</li>
            </ul>
          </div>

          <div class="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 rounded-2xl p-6 border border-green-200 dark:border-green-800">
            <div class="w-12 h-12 bg-green-500 rounded-xl flex items-center justify-center mb-4 text-white text-2xl">📝</div>
            <h3 class="text-xl font-bold mb-3 text-surface-900 dark:text-white">Mock-test plan</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed mb-3">Ramp frequency from monthly (Phase 1) to twice-weekly (Phase 3). Every mock must be followed by a 2-hour error-analysis session.</p>
            <ul class="text-xs text-surface-600 dark:text-surface-400 space-y-1">
              <li>• Weeks 1–6: none (build foundation)</li>
              <li>• Weeks 7–22: 1/week full-length</li>
              <li>• Weeks 23–36: 2/week + topic tests</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Board → Main → Advanced -->
    <section class="py-20 px-4 bg-surface-50 dark:bg-surface-900">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <div class="inline-block text-xs font-bold tracking-wider uppercase text-orange-600 dark:text-orange-400 mb-3">Depth progression</div>
          <h2 class="text-3xl md:text-4xl font-bold text-surface-900 dark:text-white mb-4">Board → JEE Main → JEE Advanced</h2>
          <p class="text-surface-600 dark:text-surface-400 max-w-xl mx-auto">Same syllabus, different depth. Recognize the shift or stall at each level.</p>
        </div>

        <div class="space-y-4">
          <div class="bg-white dark:bg-surface-800 rounded-2xl p-6 border-l-4 border-gray-400 shadow-sm">
            <div class="text-xs font-bold uppercase tracking-wider text-gray-500 mb-2">Level 1</div>
            <h3 class="text-xl font-bold mb-2 text-surface-900 dark:text-white">Board-level (where most droppers start)</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed">Formula recall, direct substitution, NCERT-textbook-style problems. Focus on definitions, derivations, and single-concept numericals.</p>
          </div>
          <div class="bg-white dark:bg-surface-800 rounded-2xl p-6 border-l-4 border-orange-500 shadow-sm">
            <div class="text-xs font-bold uppercase tracking-wider text-orange-500 mb-2">Level 2 · Weeks 7–22</div>
            <h3 class="text-xl font-bold mb-2 text-surface-900 dark:text-white">JEE Main depth</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed">Multi-step problems combining 2–3 concepts. Time pressure (≈2 min/question). NCERT is necessary but insufficient — add HC Verma, DC Pandey, MS Chauhan.</p>
          </div>
          <div class="bg-white dark:bg-surface-800 rounded-2xl p-6 border-l-4 border-red-600 shadow-sm">
            <div class="text-xs font-bold uppercase tracking-wider text-red-600 mb-2">Level 3 · Weeks 23–36</div>
            <h3 class="text-xl font-bold mb-2 text-surface-900 dark:text-white">JEE Advanced depth</h3>
            <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed">Unseen problems combining 3–5 concepts. Derivation-first approach. Irodov-style Physics, Morrison & Boyd Organic, Cengage Advanced Maths. Every question earned, nothing memorized.</p>
          </div>
        </div>
      </div>
    </section>

