---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';


---

<Layout
  title="404 — Page Not Found | StudyRoadmap"
  description="The page you're looking for doesn't exist. Get a free instant study roadmap for NEET, JEE, UPSC, MDCAT, JAMB and 125+ exams."
  robots="noindex, nofollow"
>
  <Navbar />

  <main id="main-content" class="min-h-screen flex flex-col items-center justify-center px-4 py-20 text-center">
    <!-- Decorative icon -->
    <div class="text-7xl mb-6">🔍</div>

    <!-- Heading -->
    <h1 class="text-5xl font-bold mb-4 text-surface-900 dark:text-white">404</h1>
    <h2 class="text-2xl font-semibold mb-6 text-surface-900 dark:text-white">Page Not Found</h2>

    <!-- Description -->
    <p class="text-surface-600 dark:text-surface-400 max-w-md text-lg mb-8">
      The page you're looking for has moved, been deleted, or never existed.
      But your study plan is still waiting — let's get you back on track.
    </p>

    <!-- Search input -->
    <div class="w-full max-w-md mb-8">
      <form id="sr-404-search-form" action="/exams/" method="get" class="relative flex items-center">
        <input
          type="search"
          id="sr-404-search-input"
          placeholder="Search exams (e.g. NEET, JEE, UPSC, CAT)..."
          class="w-full px-4 py-3 pl-11 rounded-xl border border-surface-300 dark:border-surface-700 bg-white dark:bg-surface-900 text-surface-900 dark:text-white placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm shadow-sm"
          aria-label="Search exams"
        />
        <svg aria-hidden="true" focusable="false" class="w-5 h-5 absolute left-3.5 text-surface-400 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <button type="submit" class="absolute right-2 px-3.5 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded-lg text-xs font-semibold transition-colors">
          Search
        </button>
      </form>
    </div>

    <!-- CTA buttons -->
    <div class="flex flex-wrap gap-4 justify-center mb-10">
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 bg-brand-600 text-white font-semibold rounded-xl hover:opacity-90 transition-opacity"
      >
        <svg aria-hidden="true" focusable="false" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
        </svg>
        Go to Homepage
      </a>
      <a
        href="/roadmap/"
        class="inline-flex items-center gap-2 px-6 py-3 border border-surface-300 dark:border-surface-700 text-surface-700 dark:text-surface-300 font-semibold rounded-xl hover:bg-surface-100 dark:hover:bg-surface-800 transition-colors"
      >
        Create a Roadmap →
      </a>
    </div>

    <!-- Popular exams quick links -->
    <div class="text-sm text-surface-600 dark:text-surface-400">
      <p class="mb-3 font-medium">Popular exams:</p>
      <div class="flex flex-wrap gap-2 justify-center">
        {[
          { label: 'NEET', id: 'neet' },
          { label: 'JEE Main', id: 'jeemain' },
          { label: 'UPSC', id: 'upsc' },
          { label: 'CUET', id: 'cuet' },
          { label: 'CAT', id: 'cat' },
          { label: 'NDA', id: 'nda' },
          { label: 'MDCAT', id: 'mdcat' },
          { label: 'JAMB', id: 'jamb' },
        ].map(({ label, id }) => (
          <a href={`/exams/${id}/`} class="px-3 py-1 bg-surface-100 dark:bg-surface-800 text-surface-700 dark:text-surface-300 rounded-lg hover:opacity-80 text-sm">
            {label}
          </a>
        ))}
      </div>
    </div>

    <script is:inline>
      (function() {
        var form = document.getElementById('sr-404-search-form');
        var input = document.getElementById('sr-404-search-input');
        if (!form || !input) return;
        var aliases = {
          'jee': 'jeemain',
          'jee-main': 'jeemain',
          'iit': 'jeeadvanced',
          'jee-advanced': 'jeeadvanced',
          'ias': 'upsc',
          'civil-services': 'upsc',
          'utme': 'jamb',
        };
        form.addEventListener('submit', function(e) {
          e.preventDefault();
          var raw = (input.value || '').trim().toLowerCase();
          var slug = raw.replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
          if (!slug) {
            window.location.href = '/exams/';
            return;
          }
          var target = aliases[slug] || slug;
          window.location.href = '/exams/' + encodeURIComponent(target) + '/';
        });
      })();
    </script>
  </main>

  <Footer />
</Layout>

