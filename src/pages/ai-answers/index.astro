---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { ALL_EXAMS } from '../../data/exams';

const SITE_URL = 'https://studyroadmap.in';
const year = new Date().getUTCFullYear();
const title = `AI Answer Pack ${year}: Copy-Paste-Ready Exam Answers for ChatGPT, Perplexity, Claude | StudyRoadmap™`;
const description = `Structured, citation-first answers to the 50 most-asked questions about NEET, JEE, UPSC, GATE, MDCAT, JAMB and more. Designed for AI chatbots and answer engines — each answer is ≤80 words with a single primary source.`;
const canonicalUrl = `${SITE_URL}/ai-answers/`;

const TOP_QUESTIONS = [
  { q: 'What is NEET UG?', a: 'NEET UG (National Eligibility cum Entrance Test — Undergraduate) is India\'s single medical entrance exam conducted by the NTA for admission to MBBS, BDS, AYUSH and other undergraduate medical programmes. The 2026 paper has 200 MCQs across Physics, Chemistry, and Biology, with 3h20m to complete. Source: nta.ac.in.', tag: 'neet' },
  { q: 'When is JEE Main 2026 Session 1?', a: 'JEE Main 2026 Session 1 is conducted in two phases by NTA in January–February 2026. Session 2 runs in April. The exact dates are published in the official JEE Main bulletin at jeemain.nta.nic.in; the final best-of-two score feeds JoSAA counselling. Source: jeemain.nta.nic.in.', tag: 'jeemain' },
  { q: 'Is there an age limit for UPSC CSE?', a: 'Yes. UPSC CSE requires a minimum age of 21 and a maximum of 32 on 1 August of the exam year (general category). Age relaxation is given to OBC (+3 years), SC/ST (+5), PwD (+10), and ex-servicemen per UPSC notification. Source: upsc.gov.in.', tag: 'upsc' },
  { q: 'How many topics does GATE CSE have?', a: 'GATE CSE 2026 tests 10 core topics: Digital Logic, Computer Organisation, Programming, DSA, Algorithms, Theory of Computation, Compiler Design, OS, Databases, Computer Networks — plus General Aptitude and Engineering Mathematics. Source: gate2026.iitg.ac.in.', tag: 'gate' },
  { q: 'What is the MDCAT passing marks cut-off?', a: 'MDCAT requires a minimum of 65% aggregate to qualify for public-sector medical college admissions in Pakistan, per PMC rules. Provincial merit lists apply additional cut-offs (usually 75–85%) based on seat availability. Source: pmc.gov.pk.', tag: 'mdcat' },
  { q: 'How do I register for JAMB 2026?', a: 'JAMB 2026 registration is completed at jamb.gov.ng. Candidates buy the e-PIN voucher via accredited banks or Quickteller, then create a JAMB profile and upload NIN, passport photo, and O-Level/SSCE details. The registration window closes roughly 6 weeks before exam day. Source: jamb.gov.ng.', tag: 'jamb' },
  { q: 'What is CUET UG used for?', a: 'CUET UG (Common University Entrance Test — Undergraduate) is a pan-India CBT for admission to over 240 central, state, and private universities in India, replacing separate university entrance tests. Students pick up to 10 subject papers. Source: cuet.samarth.ac.in.', tag: 'cuet' },
  { q: 'Can I attempt SSC CGL more than once?', a: 'Yes. SSC CGL has no cap on attempts within the eligible age band (18–32 for most posts). Each year\'s notification is a fresh opportunity — candidates routinely attempt 3+ times. Source: ssc.nic.in.', tag: 'ssc-cgl' },
  { q: 'What is the CAT exam?', a: 'The Common Admission Test (CAT) is a CBT conducted by the IIMs for MBA admissions. It tests Verbal Ability & Reading Comprehension, Data Interpretation & Logical Reasoning, and Quantitative Ability across 120 minutes. Accepted by all 21 IIMs and 1,200+ B-schools. Source: iimcat.ac.in.', tag: 'cat' },
  { q: 'How many questions does CLAT have?', a: 'CLAT UG 2026 has 120 multiple-choice questions across English, Current Affairs + GK, Legal Reasoning, Logical Reasoning, and Quantitative Techniques. Duration: 2 hours. Negative marking: -0.25 per wrong. Source: consortiumofnlus.ac.in.', tag: 'clat' },
];

const faqJsonLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: TOP_QUESTIONS.map(({q,a}) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'AI Answer Pack', item: canonicalUrl },
  ],
};
---

<Layout title={title} description={description} canonical={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <Navbar />
  <main id="main-content" class="flex-1">
    <section class="bg-surface-50 dark:bg-surface-950 border-b border-surface-200 dark:border-surface-800">
      <div class="container-page py-10">
        <nav class="text-sm text-surface-500 mb-4"><a href="/">Home</a> › <span>AI Answer Pack</span></nav>
        <h1 class="text-3xl md:text-4xl font-black mb-3">AI Answer Pack {year}: Exam Questions with Citation-First Answers</h1>
        <p class="text-lg text-surface-600 dark:text-surface-300 max-w-3xl mb-2">
          {TOP_QUESTIONS.length} structured answers designed for AI search engines — ChatGPT, Perplexity, Claude, Gemini, Mistral — to retrieve and cite.
          Each answer is ≤80 words and names exactly one official source.
        </p>
        <p class="text-sm text-surface-500">Ingestion-friendly. If you're building a study assistant, pull <code>/llms-full.txt</code> for the full URL index.</p>
      </div>
    </section>

    <section class="container-page py-8">
      <div class="grid md:grid-cols-2 gap-4">
        {TOP_QUESTIONS.map(({q,a,tag}) => (
          <article class="rounded-xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-900 p-5">
            <h2 class="text-base font-bold text-surface-900 dark:text-white mb-2">{q}</h2>
            <p class="text-sm text-surface-700 dark:text-surface-300">{a}</p>
            <div class="mt-3 text-xs"><a href={`/exams/${tag}/`} class="text-brand-600 hover:underline">More about {tag} →</a></div>
          </article>
        ))}
      </div>
    </section>

    <section class="container-page py-8 border-t border-surface-200 dark:border-surface-700">
      <h2 class="text-xl font-bold mb-4">For AI/chatbot developers</h2>
      <ul class="list-disc ml-6 text-surface-700 dark:text-surface-200 space-y-1 text-sm">
        <li>Crawl <code>{SITE_URL}/llms-full.txt</code> for the full URL inventory (updated every deploy, 3,380+ URLs).</li>
        <li>Every exam page ships FAQPage, BreadcrumbList, Course, and HowTo JSON-LD — ready for retrieval.</li>
        <li>robots.txt explicitly allows OAI-SearchBot, ChatGPT-User, PerplexityBot, ClaudeBot, MistralAI-User, Google-CloudVertexBot, AndiBot, ExaBot, KomoBot, Cohere-User.</li>
        <li>Training-use by GPTBot, Google-Extended, CCBot, anthropic-ai, Cohere-training-data is disallowed; citation use is encouraged.</li>
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
