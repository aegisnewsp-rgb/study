---
import { getCollection } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Layout from '@layouts/Layout.astro';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import { isGoodNote, isIndexableSubjectHub, isIndexableExamHub } from '@data/note-quality';
import { EXAM_EQUIVALENTS } from '@data/exam-equivalents';

export async function getStaticPaths() {
  const allNotes = await getCollection('notes');
  const subjects = [...new Set(allNotes.map(n => n.id.split('/').slice(0, 2).join('/')))];
  return subjects.map(slug => ({
    params: { exam: slug.split('/')[0], subject: slug.split('/')[1] },
    props: { slug },
  }));
}

const { slug } = Astro.props;
const allNotes = await getCollection('notes');
const allSubjectNotes = allNotes
  .filter(n => n.id.startsWith(slug + '/'))
  .sort((a, b) => a.data.topic.localeCompare(b.data.topic));
// Only list indexable notes — low-value ones are orphaned (and noindexed in
// [topic].astro) until the rewrite pipeline upgrades them.
// AdSense 2026 thin-content gate: if the hub has < 3 substantive notes, the
// hub itself doesn't carry enough indexed-content value → noindex it. (Was
// `=== 0`; tightened to `< 3` after the 2026-05-28 audit found 192 hubs with
// only 1-2 good notes shipping as 187-word landing pages.)
const subjectNotes = allSubjectNotes.filter(isGoodNote);
const subjectHubRobots = isIndexableSubjectHub(subjectNotes.length, slug.split('/')[0]) ? undefined : 'noindex,follow';
// Weight distribution for the subject (visible weightage table)
const weightTable = subjectNotes
  .slice(0, 12)
  .map(n => ({ id: n.id.split('/')[2], topic: n.data.topic, name: n.data.topicName, weight: n.data.weight || 0 }))
  .sort((a, b) => b.weight - a.weight);
const totalWeight = weightTable.reduce((s, r) => s + (r.weight || 0), 0);

const { exam, subject } = Astro.params;
const firstNote = allSubjectNotes[0];
const examName = firstNote?.data.examName || exam;
const subjectName = firstNote?.data.subjectName || subject;
const flag = { india: '🇮🇳', pakistan: '🇵🇰', nigeria: '🇳🇬' }[firstNote?.data.country] || '🌍';

const _titleRaw = `${subjectName} Study Notes — ${examName}`;
const title = _titleRaw.length > 60 ? `${subjectName} Notes — ${examName}`.slice(0, 60) : _titleRaw;
const _descRaw = `Free ${subjectName} study notes for ${examName}. ${subjectNotes.length} topics across Quick, Standard, and Deep tiers — concepts, formulas, practice.`;
const description = _descRaw.length > 160 ? _descRaw.slice(0, 157) + '...' : _descRaw;
const canonicalUrl = `https://studyroadmap.in/notes/${exam}/${subject}/`;
const siteUrl = 'https://studyroadmap.in';
const authorObj = { name: "Pushkar Saini", jobTitle: "Founder & Editor", affiliation: "StudyRoadmap", url: "https://studyroadmap.in/author/pushkar-saini/" };
const _candidateOg = `/og-notes/subject-${exam}-${subject}.jpg`;
const ogImage = fs.existsSync(path.join(process.cwd(), 'public', _candidateOg))
  ? _candidateOg
  : '/og-notes/exam-default.jpg';

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Exams', item: `${siteUrl}/exams/` },
    { '@type': 'ListItem', position: 3, name: examName, item: `${siteUrl}/exams/${exam}/` },
    { '@type': 'ListItem', position: 4, name: subjectName, item: canonicalUrl },
  ],
};

const faqs = [
  {
    question: `What topics are covered in ${subjectName} for ${examName}?`,
    answer: `${subjectName} for ${examName} covers ${subjectNotes.length} topics including ${subjectNotes.slice(0, 3).map(n => n.data.topicName).join(', ')}, and more. Each topic offers three content tiers: Quick (last-minute revision), Standard (comprehensive study), and Deep (expert-level coverage).`,
  },
  {
    question: `What is the weightage of ${subjectName} in ${examName}?`,
    answer: `${subjectName} carries significant weight in ${examName}. Our roadmap prioritises topics by their exam frequency and marks weightage, so you can focus on high-yield topics first and maximise your score with the time available.`,
  },
  {
    question: `Which ${subjectName} topics should I study first for ${examName}?`,
    answer: `Start with the highest-weighted topics in ${subjectName} for ${examName}. Our roadmap algorithm orders all topics by exam weight — covering the most frequently-tested concepts first so you score maximum marks early in your preparation.`,
  },
  {
    question: `Are these ${subjectName} notes enough for ${examName} preparation?`,
    answer: `These notes cover the complete ${examName} ${subjectName} syllabus with Quick, Standard, and Deep content tiers. Use them alongside your AI-generated study roadmap for prioritised study sessions and regular revision before exam day.`,
  },
];

const collectionPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${subjectName} Study Notes — ${examName}`,
  description: description,
  url: canonicalUrl,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: subjectNotes.map((note, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${siteUrl}/notes/${note.id}/`,
      name: note.data.topicName,
    })),
  },
};

// All subjects for THIS exam only (for cross-linking)
const examNotes = allNotes.filter(n => n.id.split('/')[0] === exam);
const allSubjects = [...new Set(examNotes.map(n => n.id.split('/')[1]))];
const otherSubjects = allSubjects.filter(s => s !== subject).map(s => {
  const exampleNote = examNotes.find(n => n.id.split('/')[1] === s);
  return { id: s, name: exampleNote?.data.subjectName || s };
});

// Equivalent exams
// Only link equivalents whose notes hub exists (≥1 good note — all-bad hubs
// 404) and is indexable — never follow-link a noindexed hub from here.
const goodByExam = new Map<string, number>();
for (const n of allNotes) {
  if (isGoodNote(n)) {
    const eid = n.id.split('/')[0];
    goodByExam.set(eid, (goodByExam.get(eid) || 0) + 1);
  }
}
const relatedExams = (EXAM_EQUIVALENTS[exam] || [])
  .filter(r => isIndexableExamHub(goodByExam.get(r.id) || 0, r.id));
---

<Layout title={title} description={description} canonical={canonicalUrl} image={ogImage} faqs={faqs} author={authorObj} robots={subjectHubRobots}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(collectionPageJsonLd)} />
  <Navbar />
  <main id="main-content" class="flex-1">
    <!-- Header -->
    <section class="bg-surface-50 dark:bg-surface-950 border-b border-surface-200 dark:border-surface-800">
      <div class="container-page py-10">
        <nav class="flex items-center gap-2 text-sm text-surface-500 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-brand-600">Home</a>
          <span>›</span>
          <a href="/exams/" class="hover:text-brand-600">Exams</a>
          <span>›</span>
          <a href={`/exams/${exam}/`} class="hover:text-brand-600">{flag} {examName}</a>
          <span>›</span>
          <span class="text-surface-900 dark:text-surface-100">{subjectName}</span>
        </nav>
        <h1 class="heading-1 text-surface-900 dark:text-surface-50 mb-2">{subjectName} — {examName}</h1>
        <p class="text-surface-600 dark:text-surface-400">
          {subjectNotes.length} topics · Free, no signup required
        </p>
        <div class="mt-5 flex gap-3">
          <a href={`/roadmap/?exam=${exam}`} class="btn-primary inline-flex items-center gap-2">
            → See Full Roadmap
          </a>
        </div>
      </div>
    </section>

    {/* About this subject — visible prose */}
    <section class="container-page py-10 max-w-3xl">
      <div class="prose prose-surface dark:prose-invert max-w-none">
        <h2>About {subjectName} in {examName}</h2>
        <p>
          {subjectName} is one of the {Math.max(allSubjects?.length || 4, 4)} core subjects in the {examName} syllabus.
          This section currently lists {subjectNotes.length} topic notes mapped to official
          {' '}{examName} weightage. Drafts may be AI-assisted; indexed notes are gated against the
          published {examName} syllabus and signed off by
          {' '}<a href="/author/pushkar-saini/" rel="author">Pushkar Saini</a> (Delhi, India).
        </p>
        <p>
          The topics below are ordered by their syllabus weightage so you can focus on high-yield areas first. If you
          are starting late or short on time, prioritise the top-weighted topics and use our
          {' '}<a href={`/study-plan-generator/?exam=${exam}`}>study-plan generator</a> for a time-boxed plan.
        </p>

        {weightTable.length > 0 && (
          <>
            <h2>Topic weightage for {subjectName}</h2>
            <p class="text-sm text-surface-600 dark:text-surface-400">
              The top {weightTable.length} topics in {subjectName} by exam weightage. Totals reflect the share of the
              {' '}{subjectName} section in {examName}; weight values are taken from the published exam pattern.
            </p>
            <table>
              <thead>
                <tr><th>Topic</th><th class="text-right">Weight</th></tr>
              </thead>
              <tbody>
                {weightTable.map(r => (
                  <tr>
                    <td><a href={`/notes/${exam}/${subject}/${r.id}/`}>{r.name}</a></td>
                    <td class="text-right">{r.weight}%</td>
                  </tr>
                ))}
              </tbody>
              {totalWeight > 0 && (
                <tfoot><tr><td><strong>Combined</strong></td><td class="text-right"><strong>{totalWeight}%</strong></td></tr></tfoot>
              )}
            </table>
          </>
        )}

        <h2>How to use these notes</h2>
        <p>
          Start with the highest-weighted topic in the table above. Each topic page opens with the concept, then
          works through formulas or frameworks, exam-pattern context, and a short verification block citing the
          official source. Notes are designed for a 25-30 minute focused study session per topic, with summary
          flashcards at the end for revision passes.
        </p>

        <h2>Strategic Preparation Framework for {subjectName}</h2>
        <p>
          Mastering {subjectName} for {examName} requires a disciplined three-phase study approach designed to turn
          theoretical concepts into reliable test-day recall:
        </p>
        <ul>
          <li>
            <strong>Phase 1 — Foundational Concept Mapping:</strong> Begin by reading through the Quick and Standard tiers of each topic note. Identify core definitions, governing principles, and standard formulas. Construct brief one-page summary sheets highlighting primary equations, classifications, and exceptions.
          </li>
          <li>
            <strong>Phase 2 — High-Yield Application and Question Banks:</strong> Once the fundamental theory is established, practice past exam questions specifically mapped to the highest-weighted topics. Focus on recognizing pattern triggers: how the examiner frames a problem and which specific formula or theorem applies.
          </li>
          <li>
            <strong>Phase 3 — Spaced Repetition and Error Logging:</strong> Conduct weekly review cycles using the Quick tier notes as memory prompts. Maintain an active error log recording every question answered incorrectly during mock sessions, categorizing each mistake into conceptual gaps, calculation errors, or misread questions.
          </li>
        </ul>

        <h2>Scoring Optimization and Negative Marking Defense</h2>
        <p>
          In competitive examinations like {examName}, scoring efficiency depends as much on error minimization as on raw subject knowledge. When navigating the {subjectName} section:
        </p>
        <ul>
          <li>
            <strong>Prioritize High-Yield Topics:</strong> Allocate study time proportionally to the weightage table above. Topics carrying over 8% individual weight should receive at least twice the practice volume of lower-frequency concepts.
          </li>
          <li>
            <strong>Manage Time Budgets Per Question:</strong> Calculate your target pace per question before entering the exam room. If a question in {subjectName} requires complex multi-step derivations that exceed your allocated time window, mark it for review and proceed to immediate recall questions first.
          </li>
          <li>
            <strong>Eliminate Options Systematically:</strong> On difficult multiple-choice stems, actively eliminate demonstrably incorrect options rather than searching immediately for the correct choice. Even eliminating two improbable answers improves your expected score under standard negative marking penalties.
          </li>
        </ul>

        <h2>Three-Tier Content Structure</h2>
        <p>
          Every note in this collection is organized into three distinct depth levels matching your study timeline:
        </p>
        <ul>
          <li>
            <strong>🟢 Quick Review (1h–1d):</strong> High-density bullet summaries, core formulas, essential date matrices, and high-frequency traps. Built specifically for night-before revision and quick refreshers before mock exams.
          </li>
          <li>
            <strong>🟡 Standard Study (2d–2mo):</strong> Systematic coverage of standard derivations, worked examples, comparison tables, and syllabus-aligned explanations suitable for steady weekly study schedules.
          </li>
          <li>
            <strong>🔴 Deep Mastery (3mo+):</strong> Advanced edge cases, multi-concept synthesis problems, reduction formulas, and in-depth historical or scientific context for top-percentile aspirants.
          </li>
        </ul>

        <h2>Frequently asked questions</h2>
        {faqs.map(f => (
          <>
            <h3>{f.question}</h3>
            <p>{f.answer}</p>
          </>
        ))}

        <p class="text-sm text-surface-500 dark:text-surface-400 mt-8 border-t pt-4">
          Reviewed by <a href="/author/pushkar-saini/" rel="author">Pushkar Saini</a> · methodology: <a href="/editorial-process/">research → draft → verify → curate</a>.
        </p>
      </div>
    </section>

    {/* Topic grid */}
    <section class="container-page py-12">
      <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-6">All {subjectNotes.length} {subjectName} Topics</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {subjectNotes.map(note => (
          <a
            href={`/notes/${note.id}/`}
            class="group block bg-surface-50 dark:bg-surface-900 border border-surface-200 dark:border-surface-700 rounded-xl p-5 hover:border-brand-300 dark:hover:border-brand-700 hover:shadow-md transition-all"
          >
            <div class="flex items-start justify-between mb-2">
              <span class="text-xs font-mono text-surface-400 bg-surface-100 dark:bg-surface-800 px-2 py-0.5 rounded">
                {note.data.topic}
              </span>
              <span class="text-xs text-brand-600 dark:text-brand-400 font-medium">
                {note.data.weight}%
              </span>
            </div>
            <h2 class="font-semibold text-surface-900 dark:text-surface-100 group-hover:text-brand-600 dark:group-hover:text-brand-400 mb-1">
              {note.data.topicName}
            </h2>
            <p class="text-sm text-surface-500">Click to read notes →</p>
          </a>
        ))}
      </div>

      <!-- Other subjects in this exam -->
      {otherSubjects.length > 0 && (
        <div class="mt-10 border-t border-surface-200 dark:border-surface-700 pt-10">
          <h2 class="heading-3 text-surface-800 dark:text-surface-100 mb-4">More Subjects for {examName}</h2>
          <div class="flex flex-wrap gap-3">
            {otherSubjects.map(s => (
              <a href={`/notes/${exam}/${s.id}/`} class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-100 dark:bg-surface-800 border border-surface-200 dark:border-surface-700 hover:border-brand-300 dark:hover:border-brand-700 text-surface-700 dark:text-surface-300 text-sm transition-all">
                {s.name} →
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Equivalent exams abroad -->
      {relatedExams.length > 0 && (
        <div class="mt-8 border-t border-surface-200 dark:border-surface-700 pt-8">
          <h2 class="heading-3 text-surface-800 dark:text-surface-100 mb-2">🌍 Equivalent Exams in Other Countries</h2>
          <p class="text-sm text-surface-500 dark:text-surface-400 mb-4">
            The same field of study — accepted in other countries' universities.
          </p>
          <div class="flex flex-wrap gap-3">
            {relatedExams.map(rel => (
              <a href={`/notes/${rel.id}/`} class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface-100 dark:bg-surface-800 border border-surface-200 dark:border-surface-700 hover:border-brand-300 dark:hover:border-brand-700 text-surface-700 dark:text-surface-300 text-sm transition-all">
                <span>{rel.flag}</span>
                <span>{rel.name}</span>
                <span class="text-surface-400">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- CTA -->
      <div class="mt-12 bg-gradient-to-r from-brand-50 to-brand-100 dark:from-brand-950 dark:to-surface-900 border border-brand-200 dark:border-brand-800 rounded-2xl p-8 text-center">
        <h2 class="text-xl font-bold text-surface-900 dark:text-surface-50 mb-2">
          Want a personalised study plan?
        </h2>
        <p class="text-surface-600 dark:text-surface-400 mb-5 max-w-md mx-auto">
          Tell us your exam and available time — get an instant ranked roadmap of all {examName} topics.
        </p>
        <a href={`/roadmap/?exam=${exam}`} class="btn-primary inline-flex items-center gap-2">
          Build My {examName} Roadmap →
        </a>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
