---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

import FaqSection from '../components/FaqSection.astro';
const CONTACT_FAQS = [
  {
    question: "How long does it take to get a response?",
    answer: "We aim to respond within 3–5 business days for general questions and feedback. For urgent exam registration deadlines, result dates, or fee changes, always use the official exam board website (NTA, JAMB, WAEC, NBE, and others) — we do not publish emergency board notices faster than the boards themselves.",
  },
  {
    question: "Can I request a new exam to be added?",
    answer: "Yes. Use the 'Request a new exam' subject option in the form, or email pushkersaini@gmail.com with the exam name, country, and official website if you have it. We prioritise additions by student demand and whether a stable public syllabus exists so we can build accurate roadmaps and notes.",
  },
  {
    question: "Do you offer personalized study coaching?",
    answer: "StudyRoadmap is a free self-service tool. We generate AI-powered study roadmaps and provide free study notes. We do not sell one-to-one coaching, paid mentorship, or guaranteed ranks. For personalised human coaching, contact your school, coaching institute, or the exam board helpline.",
  },
  {
    question: "How do I report an error in a study note or exam page?",
    answer: "Email us with the page URL, the incorrect fact, and the official source if possible (for example an NTA information bulletin PDF). You can also use the Help Improve Notes form. We correct syllabus and pattern errors as soon as we can verify them against primary sources.",
  },
  {
    question: "Is my message private?",
    answer: "Messages sent by email go only to the StudyRoadmap editor inbox. We do not sell contact form data. We may keep correspondence as long as needed to resolve your request. See our Privacy Policy for analytics, cookies, and advertising disclosures.",
  },
];
---

<Layout
  title="Contact StudyRoadmap — Support & Exam Requests"
  description="Contact StudyRoadmap for exam requests, study-note feedback, bugs, or partnerships. Email pushkersaini@gmail.com — we reply in 3–5 business days."
  canonical="https://studyroadmap.in/contact/"
  faqs={CONTACT_FAQS}
  author={{
    name: "Pushkar Saini",
    jobTitle: "Founder & Editor",
    affiliation: "StudyRoadmap",
    url: "https://studyroadmap.in/author/pushkar-saini/",
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://studyroadmap.in/' },
      { '@type': 'ListItem', position: 2, name: 'Contact', item: 'https://studyroadmap.in/contact/' },
    ],
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    'name': 'Contact StudyRoadmap™',
    'description': 'Contact Pushkar Saini, the StudyRoadmap editor, for exam questions, feedback, bug reports, or partnership inquiries.',
    'url': 'https://studyroadmap.in/contact/',
    'contactPoint': [
      {
        '@type': 'ContactPoint',
        'name': 'Pushkar Saini, StudyRoadmap editor',
        'email': 'pushkersaini@gmail.com',
        'description': 'General inquiries and feedback for StudyRoadmap™',
        'availableLanguage': ['English', 'Hindi', 'Urdu'],
        'areaServed': [
          { '@type': 'Country', 'name': 'India' },
          { '@type': 'Country', 'name': 'Pakistan' },
          { '@type': 'Country', 'name': 'Nigeria' }
        ],
        'contactType': 'customer support',
      }
    ],
    'mainEntity': {
      '@type': 'Organization',
      'name': 'StudyRoadmap™',
      'url': 'https://studyroadmap.in/'
    }
  })} />
  <Navbar />

  <main id="main-content" class="flex-1">
    <section class="bg-surface-50 dark:bg-surface-900 py-16 sm:py-20">
      <div class="container-page max-w-2xl">
        <nav class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:text-brand-600 dark:hover:text-brand-400">Home</a>
          <span>›</span>
          <span class="text-surface-700 dark:text-surface-200">Contact</span>
        </nav>
        <p class="section-label mb-3">Get in Touch</p>
        <h1 class="heading-1 text-surface-900 dark:text-white mb-4">Contact Us</h1>
        <p class="text-surface-500 dark:text-surface-400 leading-relaxed mb-6">
          StudyRoadmap is operated by Pushkar Saini (Founder &amp; Editor) from Delhi, India, as a free competitive-exam planning tool.
          Use this page for study-note corrections, new exam requests, technical bugs, partnership ideas, or general questions about how roadmaps and notes work.
          We do not charge for support and we do not require an account.
        </p>

        <div class="mb-10 p-5 rounded-xl border border-brand-200 dark:border-brand-800 bg-brand-50/60 dark:bg-brand-950/30">
          <h2 class="font-semibold text-surface-900 dark:text-white text-sm mb-2">Primary contact (works without JavaScript)</h2>
          <p class="text-sm text-surface-600 dark:text-surface-300 leading-relaxed mb-3">
            Email is the fastest reliable channel. Include the full page URL if you are reporting a content error.
          </p>
          <p class="text-base">
            <a href="mailto:pushkersaini@gmail.com" class="font-semibold text-brand-700 dark:text-brand-300 hover:underline">pushkersaini@gmail.com</a>
          </p>
          <p class="text-xs text-surface-500 dark:text-surface-400 mt-2">Typical response: 3–5 business days · Languages: English, Hindi, Urdu</p>
        </div>

        <h2 class="text-lg font-semibold text-surface-900 dark:text-white mb-3">What we can help with</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-surface-600 dark:text-surface-400 mb-8 leading-relaxed">
          <li><strong class="text-surface-800 dark:text-surface-200">Exam coverage</strong> — request NEET, JEE, UPSC, MDCAT, JAMB, WAEC, or any other competitive exam we do not yet list, with the official board site if known.</li>
          <li><strong class="text-surface-800 dark:text-surface-200">Note quality</strong> — flag outdated formulas, wrong weightage, broken examples, or missing topics on any study note.</li>
          <li><strong class="text-surface-800 dark:text-surface-200">Product bugs</strong> — roadmap generator errors, broken links, mobile layout issues, or accessibility problems.</li>
          <li><strong class="text-surface-800 dark:text-surface-200">Schools &amp; NGOs</strong> — institutional use of free roadmaps for classrooms or outreach (non-exclusive, non-commercial redistribution rules in Terms).</li>
          <li><strong class="text-surface-800 dark:text-surface-200">Privacy &amp; ads</strong> — questions about analytics cookies, AdSense disclosures, or data requests under our Privacy Policy.</li>
        </ul>

        <h2 class="text-lg font-semibold text-surface-900 dark:text-white mb-3">What we cannot do</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-surface-600 dark:text-surface-400 mb-10 leading-relaxed">
          <li>Change official registration deadlines, admit cards, or result dates — only the exam board can.</li>
          <li>Provide paid one-to-one coaching, rank guarantees, or insider paper leaks (we ban that content sitewide).</li>
          <li>Answer medical, legal, or immigration advice beyond public exam-planning information.</li>
          <li>Bypass your school or board for certificates, hall tickets, or re-evaluation requests.</li>
        </ul>

        <h2 class="text-lg font-semibold text-surface-900 dark:text-white mb-3">Send a structured message</h2>
        <p class="text-sm text-surface-500 dark:text-surface-400 mb-4 leading-relaxed">
          The form below opens your email app with a pre-filled message (the site is statically hosted and does not store form posts on our servers).
          If your browser blocks mailto links, use the email address above directly.
        </p>

        <form
          id="contact-form"
          name="contact"
          class="card p-6 flex flex-col gap-5"
          action="mailto:pushkersaini@gmail.com"
          method="get"
          enctype="text/plain"
        >
          <div class="grid sm:grid-cols-2 gap-4">
            <div class="flex flex-col gap-1.5">
              <label for="name" class="text-sm font-medium text-surface-700 dark:text-surface-300">Your Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                autocomplete="name"
                placeholder="Priya Sharma"
                class="w-full px-3 py-2 rounded-lg border border-surface-300 dark:border-surface-700 bg-white dark:bg-surface-800 text-surface-900 dark:text-white text-sm placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500"
              />
            </div>
            <div class="flex flex-col gap-1.5">
              <label for="email" class="text-sm font-medium text-surface-700 dark:text-surface-300">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                autocomplete="email"
                placeholder="priya@example.com"
                class="w-full px-3 py-2 rounded-lg border border-surface-300 dark:border-surface-700 bg-white dark:bg-surface-800 text-surface-900 dark:text-white text-sm placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500"
              />
            </div>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="subject" class="text-sm font-medium text-surface-700 dark:text-surface-300">Subject</label>
            <select
              id="subject"
              name="subject"
              required
              class="w-full px-3 py-2 rounded-lg border border-surface-300 dark:border-surface-700 bg-white dark:bg-surface-800 text-surface-900 dark:text-white text-sm focus:outline-none focus:ring-2 focus:ring-brand-500"
            >
              <option value="" disabled selected>Select a topic</option>
              <option value="exam-request">Request a new exam</option>
              <option value="notes-feedback">Feedback on study notes</option>
              <option value="bug-report">Bug or technical issue</option>
              <option value="partnership">Partnership or institutional inquiry</option>
              <option value="privacy">Privacy, cookies, or advertising</option>
              <option value="other">Other</option>
            </select>
          </div>

          <div class="flex flex-col gap-1.5">
            <label for="message" class="text-sm font-medium text-surface-700 dark:text-surface-300">Message</label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              maxlength="2000"
              autocomplete="off"
              placeholder="Include the page URL if relevant — e.g. a missing exam, a topic that needs better notes, or a bug on mobile."
              class="w-full px-3 py-2 rounded-lg border border-surface-300 dark:border-surface-700 bg-white dark:bg-surface-800 text-surface-900 dark:text-white text-sm placeholder-surface-400 focus:outline-none focus:ring-2 focus:ring-brand-500 resize-none"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto justify-center">
            Open email to send
            <svg aria-hidden="true" focusable="false" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
            </svg>
          </button>

          <p class="text-xs text-surface-400 dark:text-surface-500 leading-relaxed">
            Submitting opens your mail client. We do not store form fields on StudyRoadmap servers.
            For urgent board announcements, always check the official exam authority website first.
          </p>
        </form>
        <script is:inline>
          (function () {
            var f = document.getElementById('contact-form');
            if (!f) return;
            f.addEventListener('submit', function (e) {
              e.preventDefault();
              var v = function (id) { var el = f.querySelector('#' + id); return el ? el.value : ''; };
              var body = 'From: ' + v('name') + ' <' + v('email') + '>\n\n' + v('message');
              window.location.href =
                'mailto:pushkersaini@gmail.com'
                + '?subject=' + encodeURIComponent('[StudyRoadmap] ' + (v('subject') || 'Contact'))
                + '&body=' + encodeURIComponent(body);
            });
          })();
        </script>

        <div class="mt-10 p-5 bg-surface-100 dark:bg-surface-800 rounded-xl border border-surface-200 dark:border-surface-700">
          <h2 class="font-semibold text-surface-900 dark:text-white text-sm mb-2">Other ways to reach us</h2>
          <ul class="space-y-2 text-sm text-surface-500 dark:text-surface-400">
            <li>✉️ <a href="mailto:pushkersaini@gmail.com" class="text-brand-600 dark:text-brand-400 hover:underline">pushkersaini@gmail.com</a> — general inquiries and feedback</li>
            <li>🐛 <a href="/feedback/" class="text-brand-600 dark:text-brand-400 hover:underline">Help Improve Notes</a> — suggest corrections to study content</li>
            <li>📢 <a href="/about/" class="text-brand-600 dark:text-brand-400 hover:underline">About StudyRoadmap</a> — who we are and how content is produced</li>
            <li>🔒 <a href="/privacy/" class="text-brand-600 dark:text-brand-400 hover:underline">Privacy Policy</a> — cookies, analytics, and advertising</li>
            <li>⚖️ <a href="/editorial-process/" class="text-brand-600 dark:text-brand-400 hover:underline">Editorial process</a> — how notes are written and verified</li>
          </ul>
        </div>

        <div class="mt-8 text-sm text-surface-500 dark:text-surface-400 leading-relaxed">
          <h2 class="font-semibold text-surface-900 dark:text-white text-sm mb-2">Operator details</h2>
          <p>
            StudyRoadmap is operated from Delhi, India by
            <a href="/author/pushkar-saini/" class="text-brand-600 dark:text-brand-400 hover:underline">Pushkar Saini</a>
            (Founder &amp; Editor). We are an independent educational resource and are not affiliated with NTA, CBSE, JAMB, WAEC, or any government exam board.
          </p>
        </div>
      </div>
    </section>
      <FaqSection faqs={CONTACT_FAQS} heading="Contact — common questions" />

  </main>

  <Footer />
</Layout>
