  <script is:inline define:vars={{ examId: exam.examId, examName }}>
    (function () {
      try {
        var raw = localStorage.getItem('sr_last_plan');
        if (!raw) return;
        var plan = JSON.parse(raw);
        if (!plan || plan.exam !== examId) return;
        var href = '/roadmap/?exam=' + encodeURIComponent(examId);
        if (plan.duration) href += '&duration=' + encodeURIComponent(plan.duration);
        if (plan.topicKey) {
          href = '/notes/' + String(plan.topicKey).replace(/^\/+|\/+$/g, '') + '/';
          if (plan.duration) href += '?duration=' + encodeURIComponent(plan.duration);
        }
        var parts = ['Continue ' + (plan.examName || examName)];
        if (plan.duration) parts.push(String(plan.duration));
        if (typeof plan.pct === 'number' && plan.pct > 0) parts.push(plan.pct + '%');
        else if (typeof plan.completed === 'number' && plan.completed > 0) parts.push(plan.completed + ' done');
        try {
          var s = JSON.parse(localStorage.getItem('sr_streak') || 'null');
          if (s && s.count > 0) parts.push('🔥 ' + s.count + '-day');
        } catch (e) {}
        var box = document.getElementById('sr-exam-resume');
        var link = document.getElementById('sr-exam-resume-link');
        var lab = document.getElementById('sr-exam-resume-label');
        if (box && link && lab) {
          link.href = href;
          lab.textContent = parts.join(' · ');
          box.classList.remove('hidden');
        }
        var primary = document.getElementById('sr-exam-primary-cta');
        if (primary && plan.duration) {
          primary.setAttribute('href', '/roadmap/?exam=' + encodeURIComponent(examId) + '&duration=' + encodeURIComponent(plan.duration));
        }
      } catch (e) {}
    })();
  </script>

