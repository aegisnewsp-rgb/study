          <h2 class="text-base font-bold text-surface-800 dark:text-surface-200">
            Authoritative Sources & References
          </h2>
        </div>
        <p class="text-xs text-surface-500 dark:text-surface-400 mb-4 leading-relaxed max-w-3xl">
          The following encyclopedic and administrative references provide independent background on {examName} and its administering authorities for E-E-A-T transparency.
        </p>
        <ol class="space-y-2 max-w-3xl">
          {wikiCitations.map((cite, i) => (
            <li class="flex gap-3 text-xs">
              <span class="shrink-0 text-surface-400 font-mono select-none">[{i + 1}]</span>
              <div>
                <a
                  href={cite.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-brand-600 dark:text-brand-400 hover:underline font-medium"
                >
                  {cite.label}
                </a>
                {cite.note && (
                  <span class="text-surface-500 dark:text-surface-400"> — {cite.note}</span>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

  </main>

  <!-- Interactive Subject Filter Tabs Script -->
  <script is:inline>
    (function () {
      try {
        var tabs = document.querySelectorAll('.sr-sub-tab');
        var blocks = document.querySelectorAll('.sr-subject-block');
        if (!tabs.length || !blocks.length) return;

        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            var target = tab.getAttribute('data-target');

            // Toggle tab active styles
            tabs.forEach(function (t) {
              t.classList.remove('bg-brand-600', 'text-white', 'shadow-xs');
              t.classList.add('bg-white', 'dark:bg-surface-850', 'text-surface-700', 'dark:text-surface-300');
            });
            tab.classList.remove('bg-white', 'dark:bg-surface-850', 'text-surface-700', 'dark:text-surface-300');
            tab.classList.add('bg-brand-600', 'text-white', 'shadow-xs');

            // Show/hide blocks
            blocks.forEach(function (block) {
              if (target === 'all' || block.getAttribute('data-subject-id') === target) {
                block.style.display = 'block';
              } else {
                block.style.display = 'none';
              }
            });
          });
        });
      } catch (e) {}
    })();
  </script>


  <script is:inline define:vars={{ examId: exam.examId, examName }}>
    (function () {
      try {
        var raw = localStorage.getItem('sr_last_plan');
        if (!raw) return;
        var plan = JSON.parse(raw);
        if (!plan || plan.exam !== examId) return;
        var href = '/roadmap/?exam=' + encodeURIComponent(examId);
        if (plan.duration) href += '&duration=' + encodeURIComponent(plan.duration);
        if (plan.topicKey) {
          href = '/notes/' + String(plan.topicKey).replace(/^\/+|\/+$/g, '') + '/';
          if (plan.duration) href += '?duration=' + encodeURIComponent(plan.duration);
        }
        var parts = ['Continue ' + (plan.examName || examName)];
        if (plan.duration) parts.push(String(plan.duration));
        if (typeof plan.pct === 'number' && plan.pct > 0) parts.push(plan.pct + '%');
        else if (typeof plan.completed === 'number' && plan.completed > 0) parts.push(plan.completed + ' done');
        try {
          var s = JSON.parse(localStorage.getItem('sr_streak') || 'null');
          if (s && s.count > 0) parts.push('🔥 ' + s.count + '-day');
        } catch (e) {}
        var box = document.getElementById('sr-exam-resume');
        var link = document.getElementById('sr-exam-resume-link');
        var lab = document.getElementById('sr-exam-resume-label');
        if (box && link && lab) {
          link.href = href;
          lab.textContent = parts.join(' · ');
          box.classList.remove('hidden');
        }
        var primary = document.getElementById('sr-exam-primary-cta');
        if (primary && plan.duration) {
          primary.setAttribute('href', '/roadmap/?exam=' + encodeURIComponent(examId) + '&duration=' + encodeURIComponent(plan.duration));
        }
      } catch (e) {}
    })();
  </script>

  <Footer />

  <!-- Deferred structured data: after #main-content so LCP/h1 stay in first-14KB -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  <script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  {courseJsonLd && <script type="application/ld+json" set:html={JSON.stringify(courseJsonLd)} />}
</Layout>
