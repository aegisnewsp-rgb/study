---
import '../styles/global.css';
interface FAQItem {
    question: string;
    answer: string;
}

interface HowToStep {
    name: string;
    text: string;
}

interface AuthorPerson {
    name: string;
    jobTitle: string;
    affiliation?: string;
    url?: string;
}

interface BreadcrumbItem {
    name: string;
    url: string;
}

interface Props {
    title?: string;
    description?: string;
    image?: string;
    /** Absolute self-referential https URL when pathname alone is wrong (rare). */
    canonical?: string;
    faqs?: FAQItem[];
    howToSteps?: HowToStep[];
    robots?: string;
    author?: AuthorPerson;
    breadcrumbs?: BreadcrumbItem[];
    publishedDate?: string;
    modifiedDate?: string;
    pageType?: 'website' | 'article';
    geoRegion?: string;
    hreflang?: string;
    countryName?: string;
}

const {
    title = 'StudyRoadmap\u2122 \u2014 Free AI Study Plan Generator for NEET, JEE, UPSC & 125+ Exams',
    description = 'Generate free personalised study roadmaps for NEET, JEE Main, UPSC, SSC CGL, CAT, MDCAT, JAMB, WAEC and 125+ competitive exams. AI-powered study planner \u2014 no signup, no fees.',
    image = '/og-notes/exam-default.jpg',
    canonical,
    faqs = [],
    howToSteps = [],
    robots,
    author,
    breadcrumbs = [],
    publishedDate,
    modifiedDate,
    pageType = 'website',
    geoRegion,
    hreflang,
    countryName,
} = Astro.props;

const cleanPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = canonical
    ? new URL(canonical, Astro.site)
    : new URL(cleanPath, Astro.site);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang={hreflang || (geoRegion ? `en-${geoRegion.toLowerCase()}` : 'en')} class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- Google Search Console verification -->
        <meta name="google-site-verification" content="Va3l3XyhrSbLFp4XEIsQwEtysPjYt3Es7QkWqwEDQdo" />

        <!-- Google Analytics 4 — Consent Mode v2 defaults BEFORE gtag loads (BUG-061/062).
             Ads defaults stay denied until AdSense + CMP; analytics denied in EEA/UK/CH,
             granted elsewhere. IP anonymization + ads data redaction always on. -->
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('consent', 'default', {
                ad_storage: 'denied',
                ad_user_data: 'denied',
                ad_personalization: 'denied',
                analytics_storage: 'granted',
                functionality_storage: 'granted',
                security_storage: 'granted',
                wait_for_update: 500
            });
            gtag('consent', 'default', {
                analytics_storage: 'denied',
                region: ['AT','BE','BG','HR','CY','CZ','DK','EE','FI','FR','DE','GR','HU','IS','IE','IT','LV','LI','LT','LU','MT','NL','NO','PL','PT','RO','SK','SI','ES','SE','GB','CH']
            });
            gtag('js', new Date());
            gtag('config', 'G-XPWXLW8J3R', {
                anonymize_ip: true,
                allow_google_signals: false,
                ads_data_redaction: true
            });
        </script>
        <script is:inline>
            // Defer gtag.js off the critical path (BUG-104) while keeping Consent Mode ready.
            (function () {
                function loadGtag() {
                    if (document.getElementById('sr-gtag')) return;
                    var s = document.createElement('script');
                    s.id = 'sr-gtag';
                    s.async = true;
                    s.src = 'https://www.googletagmanager.com/gtag/js?id=G-XPWXLW8J3R';
                    document.head.appendChild(s);
                }
                if ('requestIdleCallback' in window) {
                    requestIdleCallback(loadGtag, { timeout: 3500 });
                } else {
                    setTimeout(loadGtag, 2000);
                }
            })();
        </script>

        <!-- Preconnect to critical origins -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

        <!-- DNS prefetch for analytics/external resources -->
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

        <!-- Preload Google Font for faster rendering -->
        <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" /></noscript>

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta name="title" content={title} />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalURL.href} />
        <link rel="sitemap" href="/sitemap-index.xml" />

        <!-- Geo targeting -->
        {geoRegion && <meta name="geo.region" content={geoRegion} />}
        {geoRegion && <meta name="geo.placename" content={countryName || 'StudyRoadmap'} />}

        <!-- hreflang for international pages -->
        {hreflang && <link rel="alternate" hreflang={hreflang} href={canonicalURL.href} />}
        <link rel="alternate" hreflang="en" href={canonicalURL.href} />
        <link rel="alternate" hreflang="x-default" href={canonicalURL.href} />
        {robots && <meta name="robots" content={robots} />}

        <!-- Favicon + PWA -->
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.webmanifest" />
        <meta name="theme-color" content="#2563eb" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#1e40af" media="(prefers-color-scheme: dark)" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content={pageType} />
        <meta property="og:url" content={canonicalURL.href} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={new URL(image, Astro.site).href} />
        <meta property="og:image:alt" content={title} />
        <meta property="og:site_name" content="StudyRoadmap" />
        <meta property="og:locale" content={geoRegion ? `en_${geoRegion}` : 'en_US'} />
        {geoRegion && <meta property="og:locale:alternate" content="en_US" />}

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:url" content={canonicalURL.href} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={new URL(image, Astro.site).href} />
        <meta name="twitter:image:alt" content={title} />

        <!-- Article dates for blog-like pages -->
        {publishedDate && <meta property="article:published_time" content={publishedDate} />}
        {modifiedDate && <meta property="article:modified_time" content={modifiedDate} />}

        <!-- Additional SEO Meta -->
        <meta name="author" content={author?.name || 'StudyRoadmap Team'} />
        <meta name="generator" content={Astro.generator} />
        <meta name="format-detection" content="telephone=no" />

        <!-- WebSite Structured Data (sitelinks search box) -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "StudyRoadmap",
            "url": "https://studyroadmap.in/",
            "description": "Free AI-powered study plan generator for 125+ competitive exams worldwide",
            "potentialAction": {
                "@type": "SearchAction",
                "target": {
                    "@type": "EntryPoint",
                    "urlTemplate": "https://studyroadmap.in/exams/?q={search_term_string}"
                },
                "query-input": "required name=search_term_string"
            }
        })} />

        <!-- Organization Structured Data -->
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": "StudyRoadmap",
            "url": "https://studyroadmap.in/",
            "logo": new URL('/favicon.svg', Astro.site).href,
            "description": "Free AI-powered study roadmap generator for competitive exams in India, Pakistan, Nigeria, and other markets we list on the exams directory.",
            "foundingDate": "2024",
            "sameAs": [
                "https://twitter.com/studyroadmap_in",
                "https://github.com/aegisnewsp-rgb/study"
            ],
            "founder": {
                "@type": "Person",
                "name": "Pushkar Saini",
                "url": "https://studyroadmap.in/author/pushkar-saini/",
                "sameAs": [
                    "https://github.com/aegisnewsp-rgb",
                    "https://twitter.com/studyroadmap_in"
                ],
                "email": "pushkersaini@gmail.com"
            },
            "address": {
                "@type": "PostalAddress",
                "addressCountry": "IN",
                "addressRegion": "Delhi",
                "description": "StudyRoadmap, Delhi, India"
            },
            "contactPoint": {
                "@type": "ContactPoint",
                "contactType": "customer support",
                "email": "pushkersaini@gmail.com",
                "availableLanguage": ["en", "ur", "hi"]
            }
        })} />

        <!-- Dark mode: prevent FOUC -->
        <script is:inline>
            (function () {
                const stored = localStorage.getItem('theme');
                const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (stored === 'dark' || (!stored && prefersDark)) {
                    document.documentElement.classList.add('dark');
                }
            })();
        </script>

        <!-- Large page-specific JSON-LD (FAQ/HowTo/Person/Breadcrumb) is rendered
             at end of body so #main-content + LCP heading stay inside the first
             14KB first-paint budget (AdSense/CWV scorecard). WebSite + Organization
             stay in head (small, used for sitelinks).
             NOTE: never put raw angle-bracket tags in this comment — naive H1
             scrapers match them and swallow the real page heading (BUG-LIST). -->
    </head>

    <body class="min-h-screen flex flex-col bg-white dark:bg-surface-950 text-surface-900 dark:text-surface-100 transition-colors duration-200">
        <!-- Skip navigation for accessibility -->
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-600 focus:text-white focus:font-semibold focus:rounded-lg focus:shadow-lg"
        >
            Skip to main content
        </a>

        <slot />

        <!-- Back to top button (appears on scroll) -->
        <button
            id="back-to-top"
            class="fixed bottom-6 right-6 z-40 hidden w-10 h-10 rounded-full bg-brand-600 text-white shadow-lg hover:bg-brand-700 focus:outline-none focus:ring-2 focus:ring-brand-400 transition-all duration-300 items-center justify-center"
            aria-label="Back to top"
        >
            <svg aria-hidden="true" focusable="false" class="w-5 h-5 mx-auto" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
            </svg>
        </button>

        <script is:inline>
            (function() {
                var btn = document.getElementById('back-to-top');
                if (!btn) return;
                var shown = false;
                window.addEventListener('scroll', function() {
                    if (window.scrollY > 600 && !shown) {
                        btn.classList.remove('hidden');
                        btn.classList.add('flex');
                        shown = true;
                    } else if (window.scrollY <= 600 && shown) {
                        btn.classList.add('hidden');
                        btn.classList.remove('flex');
                        shown = false;
                    }
                }, {passive: true});
                btn.addEventListener('click', function() {
                    window.scrollTo({top: 0, behavior: 'smooth'});
                });
            })();
        </script>

        <!-- Deferred structured data (moved from <head> for first-14KB LCP budget) -->
        {breadcrumbs.length > 0 && (
            <script type="application/ld+json" set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "BreadcrumbList",
                "itemListElement": breadcrumbs.map((b, i) => ({
                    "@type": "ListItem",
                    "position": i + 1,
                    "name": b.name,
                    "item": b.url,
                })),
            })} />
        )}
        {faqs.length > 0 && (
            <script type="application/ld+json" set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "FAQPage",
                "mainEntity": faqs.map(f => ({
                    "@type": "Question",
                    "name": f.question,
                    "acceptedAnswer": {
                        "@type": "Answer",
                        "text": f.answer,
                    },
                })),
            })} />
        )}
        {author && (
            <script type="application/ld+json" set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                "name": author.name,
                "jobTitle": author.jobTitle,
                "affiliation": author.affiliation ? { "@type": "Organization", "name": author.affiliation } : undefined,
                "url": author.url,
            })} />
        )}
        {howToSteps.length > 0 && (
            <script type="application/ld+json" set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "HowTo",
                "name": title,
                "description": description,
                "step": howToSteps.map((s, i) => ({
                    "@type": "HowToStep",
                    "position": i + 1,
                    "name": s.name,
                    "text": s.text,
                })),
            })} />
        )}
    </body>
</html>
