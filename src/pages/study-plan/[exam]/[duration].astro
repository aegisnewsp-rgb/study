---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import Footer from '../../../components/Footer.astro';
import { ALL_EXAMS, getCountryFlag } from '../../../data/exams';
import { getStudyPlanStrategy, indexedDurationsFor } from '../../../data/study-plan-strategy';
import { isNoindexExam } from '../../../data/suppressed-exams';
import { isGoodNote } from '../../../data/note-quality';

export async function getStaticPaths() {
  const paths: any[] = [];
  for (const exam of ALL_EXAMS) {
    if (!exam || !exam.examId || !exam.durations) continue;
    for (const [durationKey, roadmap] of Object.entries(exam.durations)) {
      paths.push({
        params: { exam: exam.examId, duration: durationKey },
        props: { exam, durationKey, roadmap },
      });
    }
  }
  return paths;
}

const { exam, durationKey, roadmap } = Astro.props;
import { SITE_URL } from '@data/site';
const currentYear = new Date().getUTCFullYear();
const CONTENT_REV = '2026-05-28'; // stable fallback; never build-time
const flag = getCountryFlag(exam.country) || '🌍';
const examName = exam.examName || exam.examId;

const DURATION_LABEL: Record<string, string> = {
  '1h': '1-Hour Cram', '2h': '2-Hour Sprint', '3h': '3-Hour Burst', '12h': '12-Hour Crash',
  '1d': '1-Day Intensive', '2d': '2-Day Rescue', '3d': '3-Day Push', '5d': '5-Day Block',
  '10d': '10-Day Plan', '2w': '2-Week Plan', '1mo': '1-Month Plan', '2mo': '2-Month Plan',
  '3mo': '3-Month Plan', '6mo': '6-Month Plan', '1yr': '1-Year Plan', '2yr': '2-Year Plan',
};
const durationLabel = DURATION_LABEL[durationKey] || `${durationKey} Plan`;

// Indexing policy: each exam offers up to ~18 duration variants. Sub-2-week
// plans are cram/triage TOOLS (no real search demand, thin by nature) and stay
// noindex,follow — served to users, kept out of the index. The demand-backed
// durations (2w/1mo/2mo/3mo/6mo/1yr/2yr) are indexed, BUT only because each now
// carries genuinely duration-specific guidance (see getStudyPlanStrategy) rather
// than the same prose with different day-numbers. Every exam keeps at least one
// indexed plan: if it offers no allowlisted duration, its longest one is indexed.
const examDurationKeys = Object.keys((exam as any).durations || {});
const totalDaysByKey: Record<string, number> = {};
for (const k of examDurationKeys) totalDaysByKey[k] = ((exam as any).durations?.[k]?.totalDays) || 0;
const indexedDurations = indexedDurationsFor(examDurationKeys, totalDaysByKey);
const totalDays = (roadmap as any).totalDays || 0;
// Placeholder-syllabus gate: exam-data subject modules that still carry literal
// "Topic N" rows render as a day-by-day table of "Topic 1..Topic 15" — zero
// search value and an obvious template smell (37 indexed exams affected,
// 2026-07-03 audit). Strip placeholder rows from the rendered plan entirely,
// and noindex the page when the underlying list was majority-placeholder or
// nothing real remains. Self-heals once the syllabus backfill lands.
const rawDailyTopics = ((roadmap as any).dailyTopics || []) as any[];
const placeholderTopicCount = rawDailyTopics.filter((t: any) => /^Topic \d+$/i.test(t?.name || '')).length;
const dailyTopics = rawDailyTopics.filter((t: any) => !/^Topic \d+$/i.test(t?.name || ''));
const isPlaceholderPlan = rawDailyTopics.length === 0 || dailyTopics.length === 0
  || placeholderTopicCount / rawDailyTopics.length >= 0.5;
const studyPlanRobots = isNoindexExam(exam.examId) || !indexedDurations.has(durationKey) || isPlaceholderPlan
  ? 'noindex,follow'
  : undefined;
const strategy = getStudyPlanStrategy({ durationLabel, totalDays, dailyTopics, examName });
const phases = ((roadmap as any).phases || []) as { name: string; weeks: number; focus: string; deliverables: string[] }[];

// Group topics by subject for a week-by-week table
const bySubject: Record<string, any[]> = {};
for (const t of dailyTopics) {
  if (!bySubject[t.subject]) bySubject[t.subject] = [];
  bySubject[t.subject].push(t);
}

// Link plan topics → published notes when the note file exists (no dead links).
const allNotes = await getCollection('notes');
const noteIdSet = new Set(
  allNotes
    .filter((n) => n.id.startsWith(exam.examId + '/') && isGoodNote(n))
    .map((n) => n.id),
);
const hasNotes = noteIdSet.size > 0;
const subjectIdByName: Record<string, string> = {};
for (const s of (exam.subjects || []) as { id: string; name: string }[]) {
  if (s?.name && s?.id) subjectIdByName[s.name] = s.id;
}
const notesSubjectSet = new Set(
  [...noteIdSet].map((id) => id.split('/')[1]).filter(Boolean),
);
function noteHrefForTopic(t: { id?: string; subject?: string }): string | null {
  if (!t?.id) return null;
  const sid = subjectIdByName[t.subject || ''] || String(t.subject || '').toLowerCase().replace(/\s+/g, '-');
  if (!sid) return null;
  const nid = `${exam.examId}/${sid}/${t.id}`;
  return noteIdSet.has(nid) ? `/notes/${nid}/` : null;
}

// Build a weekly schedule when totalDays >= 7
const weeks: { week: number; start: number; end: number; items: any[] }[] = [];
if (totalDays >= 7 && dailyTopics.length) {
  const perWeek = Math.max(1, Math.ceil(dailyTopics.length / Math.ceil(totalDays / 7)));
  for (let i = 0, w = 1; i < dailyTopics.length; i += perWeek, w++) {
    weeks.push({
      week: w,
      start: (w - 1) * 7 + 1,
      end: Math.min(w * 7, totalDays),
      items: dailyTopics.slice(i, i + perWeek),
    });
  }
}

const title = `${examName} ${durationLabel} (${totalDays}-Day Study Plan) ${currentYear} | StudyRoadmap™`;
const _descRaw = `Free ${durationLabel.toLowerCase()} for ${examName} ${currentYear} — ${totalDays}-day schedule, ${dailyTopics.length} weighted topics, day-by-day plan, no signup.`;
const description = _descRaw.length > 160 ? _descRaw.slice(0, 157) + '...' : _descRaw;
const canonicalUrl = `${SITE_URL}/study-plan/${exam.examId}/${durationKey}/`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    { '@type': 'ListItem', position: 2, name: 'Exams', item: `${SITE_URL}/exams/` },
    { '@type': 'ListItem', position: 3, name: examName, item: `${SITE_URL}/exams/${exam.examId}/` },
    { '@type': 'ListItem', position: 4, name: durationLabel, item: canonicalUrl },
  ],
};

const howToJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `${examName} ${durationLabel}`,
  description,
  totalTime: `PT${totalDays}D`,
  tool: { '@type': 'HowToTool', name: 'StudyRoadmap AI roadmap generator' },
  step: dailyTopics.slice(0, 12).map((t: any, i: number) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: t.name,
    text: `Cover ${t.name} from ${t.subject}. Weightage: ${t.weight}/5. ${t.description || ''}`,
  })),
};

const courseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: `${examName} ${durationLabel}`,
  description,
  provider: { '@type': 'Organization', '@id': `${SITE_URL}/#organization`, name: 'StudyRoadmap™', url: SITE_URL },
  offers: {
    '@type': 'Offer',
    category: 'Free',
    price: '0',
    priceCurrency: 'INR',
    availability: 'https://schema.org/InStock',
    url: canonicalUrl,
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'Online',
    courseWorkload: `PT${totalDays}D`,
    instructor: { '@type': 'Organization', name: 'StudyRoadmap', url: SITE_URL },
  },
  isPartOf: { '@type': 'Course', '@id': `${SITE_URL}/exams/${exam.examId}/#course`, name: `${examName} Study Roadmap`, url: `${SITE_URL}/exams/${exam.examId}/` },
};

const subjectsCovered = Object.keys(bySubject).slice(0, 4).join(', ');
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    // Duration-specific Q&A derived from the strategy engine — distinct per
    // timeline. ONLY these are marked up: they are what the visible FAQ
    // section renders, and schema must not describe invisible content (the
    // two former extra questions existed schema-only on all 2,232 plans).
    ...strategy.faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  ],
};

// Related durations
const siblingDurations = Object.keys(exam.durations || {})
  .filter((d: string) => d !== durationKey)
  .slice(0, 6);
---

<Layout title={title} description={description} canonical={canonicalUrl} robots={studyPlanRobots}>
  <style is:global>
    /* SR-THEME: Trust Academic — cream / forest / brass.
       Per-page override of palette tokens; doesn't affect rest of site. */
    :root {
      --color-brand-50:  #ecf2ee;
      --color-brand-100: #d4e2d8;
      --color-brand-200: #a9c4b1;
      --color-brand-300: #7ea689;
      --color-brand-400: #4d7e5d;
      --color-brand-500: #2a5a3e;
      --color-brand-600: #1a3a2e;
      --color-brand-700: #143025;
      --color-brand-800: #0e241c;
      --color-brand-900: #081813;
      --color-brand-950: #040c0a;
      --color-surface-50:  #f5f1e8;  /* warmer cream */
      --color-surface-100: #ebe5d4;
      --color-surface-200: #ddd4bd;
      --color-surface-300: #c8bda1;
      --color-surface-400: #a89d80;
      --color-surface-500: #6b6354;
      --color-surface-600: #4a4438;
      --color-surface-700: #353027;
      --color-surface-800: #24201a;
      --color-surface-900: #18150f;
      --color-surface-950: #0c0a07;
      /* Brass accent (used as amber/decoration). */
      --color-accent-500: #b08d3c;
      --color-accent-400: #c4a559;
    }
    html, body { background: #f0eee9; color: #2a251f; }
    .dark html, .dark body { background: #18150f; color: #f5f1e8; }
    /* Editorial serif on hero h1 only — Georgia for trust-academic feel. */
    .sr-trust-h1 {
      font-family: ui-serif, Georgia, "Times New Roman", serif;
      font-weight: 600;
      letter-spacing: -0.02em;
    }
    /* Brass dot for status pill. */
    .sr-trust-pulse { background: #b08d3c !important; }
    /* Tighter, more editorial body. */
    .sr-trust-prose p { font-family: ui-serif, Georgia, serif; font-size: 1.05rem; line-height: 1.6; }
  </style>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(howToJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(courseJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <Navbar />
  <main id="main-content" class="flex-1">

    <section class="relative overflow-hidden bg-gradient-to-br from-brand-50 via-white to-surface-50 dark:from-brand-950/30 dark:via-surface-950 dark:to-surface-900 border-b border-surface-200 dark:border-surface-800">
      {/* Decorative blurred orb */}
      <div aria-hidden="true" class="absolute -top-32 -right-32 w-96 h-96 rounded-full bg-brand-500/10 dark:bg-brand-400/10 blur-3xl pointer-events-none"></div>
      <div class="container-page py-12 sm:py-16 relative">
        <nav class="text-sm text-surface-500 dark:text-surface-400 mb-5 flex flex-wrap gap-2 items-center">
          <a href="/" class="hover:text-brand-600">Home</a><span class="text-surface-300 dark:text-surface-700">/</span>
          <a href="/exams/" class="hover:text-brand-600">Exams</a><span class="text-surface-300 dark:text-surface-700">/</span>
          <a href={`/exams/${exam.examId}/`} class="hover:text-brand-600">{flag} {examName}</a><span class="text-surface-300 dark:text-surface-700">/</span>
          <span class="text-surface-900 dark:text-surface-100 font-medium">{durationLabel}</span>
        </nav>

        <div class="inline-flex items-center gap-2 bg-brand-100/60 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 text-xs font-semibold px-3 py-1.5 rounded-full mb-4 border border-brand-200/60 dark:border-brand-800/50">
          <span class="sr-trust-pulse w-1.5 h-1.5 rounded-full bg-brand-500 animate-pulse"></span>
          Updated {exam.lastUpdated || CONTENT_REV} · {currentYear} Edition
        </div>

        <h1 class="sr-trust-h1 text-4xl md:text-5xl lg:text-6xl text-surface-900 dark:text-white mb-4 leading-[1.05]">
          {examName} <span class="italic text-brand-600 dark:text-brand-400">{durationLabel}</span>
        </h1>
        <p class="text-lg md:text-xl text-surface-600 dark:text-surface-300 max-w-3xl mb-6 leading-relaxed">
          A complete <strong class="text-surface-900 dark:text-white">{totalDays}-day</strong> plan covering <strong class="text-surface-900 dark:text-white">{dailyTopics.length} highest-weightage topics</strong> — prioritised by subject weight, not alphabet. No signup, no fees.
        </p>

        {/* Quick-stat strip */}
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-7 max-w-3xl">
          <div class="bg-white/80 dark:bg-surface-900/80 backdrop-blur rounded-xl p-3 border border-surface-200/60 dark:border-surface-700/60">
            <dt class="text-[10px] uppercase tracking-widest text-surface-500 font-semibold">Days</dt>
            <dd class="text-2xl font-bold text-surface-900 dark:text-white mt-0.5">{totalDays}</dd>
          </div>
          <div class="bg-white/80 dark:bg-surface-900/80 backdrop-blur rounded-xl p-3 border border-surface-200/60 dark:border-surface-700/60">
            <dt class="text-[10px] uppercase tracking-widest text-surface-500 font-semibold">Topics</dt>
            <dd class="text-2xl font-bold text-surface-900 dark:text-white mt-0.5">{dailyTopics.length}</dd>
          </div>
          <div class="bg-white/80 dark:bg-surface-900/80 backdrop-blur rounded-xl p-3 border border-surface-200/60 dark:border-surface-700/60">
            <dt class="text-[10px] uppercase tracking-widest text-surface-500 font-semibold">Subjects</dt>
            <dd class="text-2xl font-bold text-surface-900 dark:text-white mt-0.5">{Object.keys(bySubject).length}</dd>
          </div>
          <div class="bg-white/80 dark:bg-surface-900/80 backdrop-blur rounded-xl p-3 border border-surface-200/60 dark:border-surface-700/60">
            <dt class="text-[10px] uppercase tracking-widest text-surface-500 font-semibold">{phases.length > 0 ? 'Phases' : 'Cost'}</dt>
            <dd class="text-2xl font-bold text-surface-900 dark:text-white mt-0.5">{phases.length > 0 ? phases.length : 'Free'}</dd>
          </div>
        </dl>

        <div class="flex flex-wrap gap-3">
          <a href={`${SITE_URL}/roadmap/?exam=${exam.examId}&duration=${durationKey}`} class="group inline-flex items-center gap-2 bg-gradient-to-r from-brand-600 to-brand-500 hover:from-brand-700 hover:to-brand-600 text-white font-bold px-6 py-3 rounded-xl shadow-lg shadow-brand-500/20 hover:shadow-xl hover:shadow-brand-500/30 transition-all">
            Generate My Personalised Plan
            <span class="transition-transform group-hover:translate-x-0.5">→</span>
          </a>
          {hasNotes && (
            <a href={`/notes/${exam.examId}/`} class="inline-flex items-center gap-2 bg-white dark:bg-surface-800 text-surface-700 dark:text-surface-200 font-semibold px-6 py-3 rounded-xl border border-surface-200 dark:border-surface-700 hover:border-brand-300 dark:hover:border-brand-700 transition-colors">
              Study notes for this plan →
            </a>
          )}
          <a href={`/exams/${exam.examId}/`} class="inline-flex items-center gap-2 bg-white dark:bg-surface-800 text-surface-700 dark:text-surface-200 font-semibold px-6 py-3 rounded-xl border border-surface-200 dark:border-surface-700 hover:border-brand-300 dark:hover:border-brand-700 transition-colors">
            ← {examName} Overview
          </a>
        </div>
      </div>
    </section>

    {/* Strategy — genuinely duration-specific guidance. This is what makes a
        1-month plan a different document from a 1-year plan, not just a smaller
        table: different pace, what to cut, pass count, mock cadence and risks. */}
    <section class="container-page py-12">
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <span class="inline-flex items-center gap-2 bg-accent-500/10 text-accent-400 text-xs font-bold uppercase tracking-wider px-3 py-1 rounded-full border border-accent-400/30">{strategy.archetype}</span>
        <span class="text-sm text-surface-500 dark:text-surface-400">{strategy.passes}</span>
      </div>
      <h2 class="text-3xl font-bold text-surface-900 dark:text-white mb-3">How to actually use your {totalDays} day{totalDays === 1 ? '' : 's'}</h2>
      <p class="text-lg text-surface-600 dark:text-surface-300 max-w-3xl mb-6">{strategy.tagline}</p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8 max-w-3xl">
        <div class="rounded-xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-900 p-4">
          <div class="text-[10px] uppercase tracking-widest text-surface-500 font-semibold">Daily study</div>
          <div class="text-lg font-bold text-surface-900 dark:text-white mt-1">{strategy.hoursPerDay}</div>
        </div>
        <div class="rounded-xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-900 p-4">
          <div class="text-[10px] uppercase tracking-widest text-surface-500 font-semibold">New topics / day</div>
          <div class="text-lg font-bold text-surface-900 dark:text-white mt-1">≈ {strategy.topicsPerDay}</div>
        </div>
        <div class="rounded-xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-900 p-4 col-span-2 sm:col-span-1">
          <div class="text-[10px] uppercase tracking-widest text-surface-500 font-semibold">Approach</div>
          <div class="text-sm font-semibold text-surface-900 dark:text-white mt-1">{strategy.passes}</div>
        </div>
      </div>

      <div class="max-w-3xl space-y-4 text-surface-700 dark:text-surface-300 leading-relaxed">
        {strategy.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <div class="grid sm:grid-cols-3 gap-5 mt-8">
        <div class="rounded-2xl border border-surface-200 dark:border-surface-700 p-5 bg-surface-50/60 dark:bg-surface-900/40">
          <h3 class="font-bold text-surface-900 dark:text-white mb-2">What to prioritise &amp; cut</h3>
          <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed">{strategy.whatToCut}</p>
        </div>
        <div class="rounded-2xl border border-surface-200 dark:border-surface-700 p-5 bg-surface-50/60 dark:bg-surface-900/40">
          <h3 class="font-bold text-surface-900 dark:text-white mb-2">Mock tests &amp; revision</h3>
          <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed">{strategy.mockPlan}</p>
        </div>
        <div class="rounded-2xl border border-surface-200 dark:border-surface-700 p-5 bg-surface-50/60 dark:bg-surface-900/40">
          <h3 class="font-bold text-surface-900 dark:text-white mb-2">Weekly rhythm</h3>
          <p class="text-sm text-surface-700 dark:text-surface-300 leading-relaxed">{strategy.weeklyRhythm}</p>
        </div>
      </div>
    </section>

    {phases.length > 0 && (
      <section class="container-page py-12">
        <div class="flex items-baseline justify-between gap-4 flex-wrap mb-2">
          <h2 class="text-3xl font-bold text-surface-900 dark:text-white">Phase-by-phase plan</h2>
          <span class="text-xs font-mono text-surface-500">{phases.reduce((s, p) => s + p.weeks, 0)} weeks total</span>
        </div>
        <p class="text-surface-600 dark:text-surface-400 mb-8 max-w-2xl">A {totalDays}-day plan only works when you sequence it. Here is how the {durationLabel} breaks down — foundation, depth, then mocks.</p>

        <ol class="relative border-l-2 border-dashed border-brand-300 dark:border-brand-700/60 ml-3 space-y-6">
          {phases.map((p, i) => (
            <li class="relative pl-7">
              <span class="absolute -left-[13px] top-2 flex items-center justify-center w-6 h-6 rounded-full bg-gradient-to-br from-brand-600 to-brand-400 text-white text-xs font-bold shadow-md shadow-brand-500/30 ring-4 ring-white dark:ring-surface-950">{i + 1}</span>
              <div class="rounded-2xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-900 p-6 hover:border-brand-300 dark:hover:border-brand-700 transition-colors">
                <div class="flex items-baseline justify-between gap-3 flex-wrap mb-2">
                  <h3 class="text-xl font-bold text-surface-900 dark:text-white">{p.name}</h3>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-brand-50 dark:bg-brand-900/40 text-brand-700 dark:text-brand-300 border border-brand-100 dark:border-brand-800">
                    {p.weeks} {p.weeks === 1 ? 'week' : 'weeks'}
                  </span>
                </div>
                <p class="text-sm text-surface-700 dark:text-surface-300 mb-4 leading-relaxed">{p.focus}</p>
                <div class="grid sm:grid-cols-3 gap-2">
                  {p.deliverables.map((d) => (
                    <div class="flex gap-2 items-start text-xs text-surface-700 dark:text-surface-300 bg-surface-50 dark:bg-surface-800/60 rounded-lg p-2.5">
                      <svg aria-hidden="true" focusable="false" class="w-3.5 h-3.5 mt-0.5 text-brand-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                      <span>{d}</span>
                    </div>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {weeks.length > 0 && (
      <section class="container-page py-10">
        <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-5">Week-by-week schedule</h2>
        <div class="overflow-x-auto rounded-lg border border-surface-200 dark:border-surface-700">
          <table class="w-full text-sm">
            <thead class="bg-surface-50 dark:bg-surface-900">
              <tr>
                <th class="text-left p-3 font-semibold">Week</th>
                <th class="text-left p-3 font-semibold">Days</th>
                <th class="text-left p-3 font-semibold">Topics covered</th>
              </tr>
            </thead>
            <tbody>
              {weeks.map((w) => (
                <tr class="border-t border-surface-200 dark:border-surface-700">
                  <td class="p-3 font-semibold">{w.week}</td>
                  <td class="p-3">{w.start}–{w.end}</td>
                  <td class="p-3">{w.items.map((t: any) => {
                    const href = noteHrefForTopic(t);
                    return href ? (
                      <a href={href} class="inline-block mr-2 mb-1 px-2 py-1 bg-brand-50 dark:bg-brand-900/30 text-brand-800 dark:text-brand-200 hover:bg-brand-100 dark:hover:bg-brand-900/50 rounded text-xs underline-offset-2 hover:underline"><strong>{t.subject}</strong>: {t.name} (w{t.weight})</a>
                    ) : (
                      <span class="inline-block mr-2 mb-1 px-2 py-1 bg-surface-100 dark:bg-surface-800 rounded text-xs"><strong>{t.subject}</strong>: {t.name} (w{t.weight})</span>
                    );
                  })}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    <section class="container-page py-12">
      <h2 class="text-3xl font-bold text-surface-900 dark:text-white mb-2">Subject-wise topic split</h2>
      <p class="text-surface-600 dark:text-surface-400 mb-8 max-w-2xl">Each topic shows its weightage (1–5 dots) and the concepts you'll cover. Higher-weight topics appear first.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {Object.entries(bySubject).map(([subject, items], si) => (
          <div class="rounded-2xl border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-900 overflow-hidden hover:shadow-md transition-shadow">
            {/* Color-coded header strip */}
            <div class={`h-1 bg-gradient-to-r ${['from-blue-500 to-cyan-400','from-emerald-500 to-teal-400','from-amber-500 to-orange-400','from-violet-500 to-fuchsia-400','from-rose-500 to-pink-400','from-indigo-500 to-blue-400'][si % 6]}`}></div>
            <div class="p-5">
              <div class="flex items-baseline justify-between mb-4">
                {(() => {
                  const sid = subjectIdByName[subject];
                  if (sid && notesSubjectSet.has(sid)) {
                    return (
                      <h3 class="font-bold text-surface-900 dark:text-white">
                        <a href={`/notes/${exam.examId}/${sid}/`} class="hover:text-brand-600 dark:hover:text-brand-400">{subject} →</a>
                      </h3>
                    );
                  }
                  return <h3 class="font-bold text-surface-900 dark:text-white">{subject}</h3>;
                })()}
                <span class="text-xs font-mono text-surface-500">{(items as any[]).length} topic{(items as any[]).length === 1 ? '' : 's'}</span>
              </div>
              <ul class="text-sm space-y-3.5">
                {(items as any[]).slice(0, 8).map((t: any) => {
                  const href = noteHrefForTopic(t);
                  return (
                  <li class="group">
                    <div class="flex items-baseline justify-between gap-3">
                      {href ? (
                        <a href={href} class="font-semibold text-brand-700 dark:text-brand-300 hover:underline">{t.name}</a>
                      ) : (
                        <span class="font-semibold text-surface-800 dark:text-surface-200">{t.name}</span>
                      )}
                      <span class="text-[10px] font-mono text-amber-500 shrink-0 tracking-tighter" aria-label={`weight ${t.weight} of 5`}>{'●'.repeat(Math.max(0, Math.min(5, t.weight || 0)))}{'○'.repeat(Math.max(0, 5 - Math.min(5, t.weight || 0)))}</span>
                    </div>
                    {t.description && (
                      <p class="text-xs text-surface-600 dark:text-surface-400 leading-relaxed mt-1.5">{t.description}</p>
                    )}
                  </li>
                  );
                })}
                {(items as any[]).length > 8 && (
                  <li class="text-xs text-surface-500 pt-2 border-t border-surface-100 dark:border-surface-800">
                    {hasNotes ? (
                      <a href={`/notes/${exam.examId}/`} class="text-brand-600 dark:text-brand-400 hover:underline">+ {(items as any[]).length - 8} more — open full notes →</a>
                    ) : (
                      <>+ {(items as any[]).length - 8} more topic{(items as any[]).length - 8 === 1 ? '' : 's'} on the full roadmap →</>
                    )}
                  </li>
                )}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="container-page py-10 border-t border-surface-200 dark:border-surface-700">
      <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-4">Why a {totalDays}-day plan beats a 1,200-page prep book</h2>
      <div class="overflow-x-auto rounded-lg border border-surface-200 dark:border-surface-700">
        <table class="w-full text-sm">
          <thead class="bg-surface-50 dark:bg-surface-900"><tr><th class="text-left p-3">Dimension</th><th class="text-left p-3">Typical {examName} book</th><th class="text-left p-3">This {durationLabel}</th></tr></thead>
          <tbody>
            <tr class="border-t border-surface-200 dark:border-surface-700"><td class="p-3">Time to start</td><td class="p-3">Hours of reading before any study starts</td><td class="p-3 font-semibold text-brand-600">Seconds — plan is already here</td></tr>
            <tr class="border-t border-surface-200 dark:border-surface-700"><td class="p-3">Personalisation</td><td class="p-3">One-size-fits-all</td><td class="p-3 font-semibold text-brand-600">Fits exactly your {totalDays} days</td></tr>
            <tr class="border-t border-surface-200 dark:border-surface-700"><td class="p-3">Freshness</td><td class="p-3">Printed months ago</td><td class="p-3 font-semibold text-brand-600">Updated for the {currentYear} cycle · verified {exam.lastUpdated || CONTENT_REV}</td></tr>
            <tr class="border-t border-surface-200 dark:border-surface-700"><td class="p-3">Weightage signal</td><td class="p-3">Author guess</td><td class="p-3 font-semibold text-brand-600">Derived from last 5 years' papers</td></tr>
            <tr class="border-t border-surface-200 dark:border-surface-700"><td class="p-3">Cost</td><td class="p-3">₹500–2,500</td><td class="p-3 font-semibold text-brand-600">₹0</td></tr>
            <tr class="border-t border-surface-200 dark:border-surface-700"><td class="p-3">Sign-up required</td><td class="p-3">Often (with a trial trap)</td><td class="p-3 font-semibold text-brand-600">None</td></tr>
          </tbody>
        </table>
      </div>
    </section>

    {siblingDurations.length > 0 && (
      <section class="container-page py-8 border-t border-surface-200 dark:border-surface-700">
        <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-3">Other {examName} plans</h2>
        <div class="flex flex-wrap gap-2">
          {siblingDurations.map((d: string) => (
            <a href={`/study-plan/${exam.examId}/${d}/`} class="px-3 py-2 rounded-lg bg-surface-100 dark:bg-surface-800 hover:bg-brand-100 dark:hover:bg-brand-900/30 text-sm font-medium">{DURATION_LABEL[d] || d}</a>
          ))}
          <a href={`/study-plan/${exam.examId}/`} class="px-3 py-2 rounded-lg bg-brand-600 text-white hover:bg-brand-700 text-sm font-semibold">All {examName} plans &amp; strategy →</a>
        </div>
      </section>
    )}

    {/* Visible FAQ backing the FAQPage schema — duration-specific, distinct per plan. */}
    <section class="container-page py-10 border-t border-surface-200 dark:border-surface-700">
      <h2 class="text-2xl font-bold text-surface-900 dark:text-white mb-5">{examName} {durationLabel} — common questions</h2>
      <div class="max-w-3xl divide-y divide-surface-200 dark:divide-surface-700">
        {strategy.faq.map((f) => (
          <details class="group py-4">
            <summary class="flex cursor-pointer items-center justify-between gap-3 font-semibold text-surface-900 dark:text-white list-none">
              <span>{f.q}</span>
              <span class="text-brand-500 transition-transform group-open:rotate-45 text-xl leading-none">+</span>
            </summary>
            <p class="mt-3 text-sm text-surface-700 dark:text-surface-300 leading-relaxed">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    {hasNotes && (
      <section class="container-page py-8 border-t border-surface-200 dark:border-surface-700">
        <div class="rounded-2xl border border-brand-200 dark:border-brand-800 bg-brand-50/60 dark:bg-brand-950/30 p-6 sm:p-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
          <div>
            <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-1">Study notes for every topic in this plan</h2>
            <p class="text-sm text-surface-600 dark:text-surface-400 max-w-xl">
              Open free {examName} notes as you work through the {durationLabel}. Topics above link straight to the matching note when available.
            </p>
          </div>
          <a href={`/notes/${exam.examId}/`} class="inline-flex items-center gap-2 shrink-0 bg-brand-600 hover:bg-brand-700 text-white font-bold px-5 py-3 rounded-xl transition-colors">
            Browse all {examName} notes →
          </a>
        </div>
      </section>
    )}

    <section class="container-page py-10">
      <div class="rounded-xl bg-brand-600 text-white p-8 text-center">
        <h2 class="text-2xl font-bold mb-3">Already know the pattern? Generate a topic-by-topic plan.</h2>
        <p class="mb-5 text-brand-100">The full personalised roadmap covers weak topics first, tracks completion, and adapts as you mark topics done.</p>
        <a href={`${SITE_URL}/roadmap/?exam=${exam.examId}&duration=${durationKey}`} class="inline-flex items-center gap-2 bg-white text-brand-600 font-bold px-6 py-3 rounded-xl">Generate Personalised Plan →</a>
      </div>
    </section>

  </main>
  <Footer />
</Layout>
